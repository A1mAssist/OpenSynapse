<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenSynapse.Core\OpenSynapse.Core.csproj" />
    <ProjectReference Include="..\..\src\OpenSynapse.Windows\OpenSynapse.Windows.csproj" />
    <ProjectReference Include="..\..\src\OpenSynapse.ChromaSdk.Protocol\OpenSynapse.ChromaSdk.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\OpenSynapse.App\Native\Razer\Mappings\*.json"
          Link="Mappings\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\OpenSynapse.App\Assets\LightingLayouts\synapse2-legacy.json"
          Link="Fixtures\synapse2-legacy.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\avif-alpha.avif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\OpenSynapse.App\Native\Avif\avif.dll"
          Link="avif.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\OpenSynapse.App\Native\Avif\dav1d.dll"
          Link="dav1d.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\OpenSynapse.App\Native\Avif\vcruntime140.dll"
          Link="vcruntime140.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\studio-*.mp4" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\Chroma\*.ChromaEffects" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\Fire\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
