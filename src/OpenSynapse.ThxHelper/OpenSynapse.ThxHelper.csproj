<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenSynapse.ThxHelper</RootNamespace>
    <AssemblyName>OpenSynapse.ThxHelper</AssemblyName>
    <!-- Task Manager shows the default .NET icon without this. -->
    <ApplicationIcon>..\OpenSynapse.App\Assets\OpenSynapse.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSynapse.Windows\OpenSynapse.Windows.csproj" />
  </ItemGroup>
</Project>
