<Project>
  <PropertyGroup>
    <!-- MSI replaces versioned files by comparison, so every build needs a newer
         FileVersion; otherwise an upgrade keeps the old DLLs and mixes XAML with them. -->
    <Version>1.7.2-beta43</Version>
    <AssemblyVersion>1.7.2.0</AssemblyVersion>
    <FileVersion>1.7.2.43</FileVersion>
    <InformationalVersion>1.7.2-beta43</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
