<Window
    x:Class="OpenSynapse.App.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    Title="OpenSynapse">
  <Grid x:Name="MenuRoot" MinHeight="178" Background="Transparent">
    <Grid.Resources>
      <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="3,1,3,1" />
        <Setter Property="Padding" Value="4,0,4,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource MenuFlyoutItemForeground}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome"
                      Background="{TemplateBinding Background}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="Chrome.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" />
                        <Setter Target="Content.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPointerOver}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="Chrome.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPressed}" />
                        <Setter Target="Content.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPressed}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="Chrome.Background" Value="Transparent" />
                        <Setter Target="Content.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundDisabled}" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="Content"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Border x:Name="MenuPanel"
            Background="#2A2A2A"
            BorderThickness="0"
            CornerRadius="8"
            Padding="0,4,0,4"
            VerticalAlignment="Top">
      <StackPanel HorizontalAlignment="Stretch">
        <Button x:Name="OpenMainPanelMenuItem"
                Style="{StaticResource TrayMenuButtonStyle}"
                Click="OpenMainPanelClick">
          <Grid>
            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="14" />
            </Viewbox>
            <TextBlock x:Name="OpenMainPanelText"
                       local:Localized.Uid="Loc_0CE53A16F8"
                       Text="打开主面板"
                       Margin="22,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button x:Name="DevicesMenuItem"
                Style="{StaticResource TrayMenuButtonStyle}"
                Tag="devices"
                Click="NavigateClick">
          <Grid>
            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
              <SymbolIcon Symbol="AllApps" />
            </Viewbox>
            <TextBlock x:Name="DevicesText"
                       local:Localized.Uid="Loc_ED026FD231"
                       Text="设备控制"
                       Margin="22,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button x:Name="ProfilesMenuItem"
                Style="{StaticResource TrayMenuButtonStyle}"
                Tag="profiles"
                Click="NavigateClick">
          <Grid>
            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
              <SymbolIcon Symbol="Library" />
            </Viewbox>
            <TextBlock x:Name="ProfilesText"
                       local:Localized.Uid="Loc_16444BA5AB"
                       Text="配置"
                       Margin="22,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Rectangle Height="1" Fill="{ThemeResource MenuFlyoutSeparatorBackground}" Margin="12,2,12,2" />
        <Button x:Name="TurnOffDisplayMenuItem"
                Style="{StaticResource TrayMenuButtonStyle}"
                Click="TurnOffDisplayClick">
          <Grid>
            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
              <SymbolIcon Symbol="View" />
            </Viewbox>
            <TextBlock x:Name="TurnOffDisplayText"
                       local:Localized.Uid="TrayTurnOffDisplay"
                       Text="关闭屏幕"
                       Margin="22,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Rectangle Height="1" Fill="{ThemeResource MenuFlyoutSeparatorBackground}" Margin="12,2,12,2" />
        <Button x:Name="ExitMenuItem"
                Style="{StaticResource TrayMenuButtonStyle}"
                Click="ExitClick">
          <Grid>
            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
              <PathIcon Data="M12.5,17 C12.7761,17 13,16.7761 13,16.5 C13,16.2239 12.7761,16 12.5,16 L6,16 C4.89543,16 4,15.1046 4,14 L4,6 C4,4.89543 4.89543,4 6,4 L12.5,4 C12.7761,4 13,3.77614 13,3.5 C13,3.22386 12.7761,3 12.5,3 L6,3 C4.34315,3 3,4.34315 3,6 L3,14 C3,15.6569 4.34315,17 6,17 Z M13.6464,6.14645 C13.8417,5.95118 14.1583,5.95118 14.3536,6.14645 L17.8536,9.64645 C18.0488,9.84171 18.0488,10.1583 17.8536,10.3536 L14.3536,13.8536 C14.1583,14.0488 13.8417,14.0488 13.6464,13.8536 C13.4512,13.6583 13.4512,13.3417 13.6464,13.1464 L16.2929,10.5 L7.5,10.5 C7.22386,10.5 7,10.2761 7,10 C7,9.72386 7.22386,9.5 7.5,9.5 L16.2929,9.5 L13.6464,6.85355 C13.4512,6.65829 13.4512,6.34171 13.6464,6.14645 Z" />
            </Viewbox>
            <TextBlock x:Name="ExitText"
                       local:Localized.Uid="Loc_81394C3DA6"
                       Text="退出"
                       Margin="22,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
