<UserControl
    x:Class="OpenSynapse.App.MousePathPlot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App">
  <Grid MinHeight="360">
    <Canvas x:Name="PlotCanvas" Background="Transparent" local:Localized.Uid="MacroMousePathPreview" />
    <TextBlock
        x:Name="EmptyHint"
        local:Localized.Uid="MacroMousePathEmpty"

        Foreground="{StaticResource MutedBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center" />
  </Grid>
</UserControl>
