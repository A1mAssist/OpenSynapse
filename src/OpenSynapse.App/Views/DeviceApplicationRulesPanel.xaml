<UserControl x:Name="Root" x:Class="OpenSynapse.App.Views.DeviceApplicationRulesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:viewModels="using:OpenSynapse.App.ViewModels" xmlns:local="using:OpenSynapse.App">
  <Expander local:Localized.Uid="DeviceRulesHeader" Header="按程序自动切换" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DeviceApplicationRulesExpander">
    <StackPanel Spacing="12" Padding="0,12,0,0">
      <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
      <ToggleSwitch local:Localized.Uid="DeviceRulesEnable" Header="启用此设备的自动切换" IsOn="{Binding Enabled, Mode=TwoWay}" OnContent="" OffContent="" />
      <ItemsControl x:Name="RulesList" ItemsSource="{Binding Rules}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:DeviceApplicationRuleRowViewModel">
          <Grid ColumnDefinitions="*,160,Auto,Auto" ColumnSpacing="8" Margin="0,4">
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ExecutableName}" FontWeight="SemiBold" /><TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileNames, ElementName=Root}" SelectedItem="{Binding ProfileName, Mode=TwoWay}" SelectionChanged="RuleChanged" HorizontalAlignment="Stretch" />
            <ToggleSwitch Grid.Column="2" IsOn="{Binding Enabled, Mode=TwoWay}" Toggled="RuleChanged" OnContent="" OffContent="" />
            <Button local:Localized.Uid="DeviceRulesRemove" Grid.Column="3" Content="删除" Click="RemoveRuleClick" Tag="{Binding Id}" Style="{StaticResource SecondaryButtonStyle}" />
          </Grid>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,180,Auto" ColumnSpacing="8">
        <ComboBox x:Name="ApplicationPicker" local:Localized.Uid="DeviceRulesPickRunning" ItemsSource="{Binding RunningApplications}" PlaceholderText="选择正在运行的程序" />
        <ComboBox x:Name="ProfilePicker" Grid.Column="1" ItemsSource="{Binding ProfileNames}" SelectedIndex="0" />
        <Button local:Localized.Uid="DeviceRulesAdd" Grid.Column="2" Content="添加" Click="AddRuleClick" Style="{StaticResource PrimaryButtonStyle}" />
      </Grid>
      <Button local:Localized.Uid="DeviceRulesBrowse" Content="选择 exe 并重新关联当前设备" Click="BrowseApplicationClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
    </StackPanel>
  </Expander>
</UserControl>
