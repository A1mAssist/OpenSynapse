<Window
    x:Class="OpenSynapse.App.Views.PresetEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
  <Grid x:Name="RootLayout"
        Background="{StaticResource CanvasBrush}"
        RequestedTheme="Dark"
        Padding="14"
        RowSpacing="10"
        RowDefinitions="Auto,*,Auto"
        automation:AutomationProperties.AutomationId="PresetEditorWindow">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewAcceleratorInvoked" />
      <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenAcceleratorInvoked" />
      <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAcceleratorInvoked" />
      <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="SaveAsAcceleratorInvoked" />
      <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAcceleratorInvoked" />
      <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="RedoAcceleratorInvoked" />
      <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoAcceleratorInvoked" />
      <KeyboardAccelerator Key="Space" Invoked="PlayAcceleratorInvoked" />
    </Grid.KeyboardAccelerators>

    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button x:Name="NewButton" Content="New" Style="{StaticResource SecondaryButtonStyle}"
                  AutomationProperties.AutomationId="PresetEditorNew" Click="NewClick" />
          <Button x:Name="OpenButton" Content="Open" Style="{StaticResource SecondaryButtonStyle}"
                  AutomationProperties.AutomationId="PresetEditorOpen" Click="OpenClick" />
          <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                  AutomationProperties.AutomationId="PresetEditorSave" Click="SaveClick" />
          <Button x:Name="SaveAsButton" Content="Save as" Style="{StaticResource SecondaryButtonStyle}"
                  AutomationProperties.AutomationId="PresetEditorSaveAs" Click="SaveAsClick" />
          <Button x:Name="ValidateButton" Content="Validate" Style="{StaticResource SecondaryButtonStyle}"
                  AutomationProperties.AutomationId="PresetEditorValidate" Click="ValidateClick" />
          <Button x:Name="ValidateAllButton" Content="Validate all" Style="{StaticResource SecondaryButtonStyle}"
                  AutomationProperties.AutomationId="PresetEditorValidateAll" Click="ValidateAllClick" />
          <Button x:Name="UndoButton" Content="Undo" Style="{StaticResource SecondaryButtonStyle}"
                  AutomationProperties.AutomationId="PresetEditorUndo" Click="UndoClick" />
          <Button x:Name="RedoButton" Content="Redo" Style="{StaticResource SecondaryButtonStyle}"
                  AutomationProperties.AutomationId="PresetEditorRedo" Click="RedoClick" />
          <Button x:Name="PlayButton" Content="Pause" Style="{StaticResource SecondaryButtonStyle}"
                  AutomationProperties.AutomationId="PresetEditorPlay" Click="PlayClick" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock x:Name="HeaderNameText" FontFamily="{StaticResource AppFontSemiBoldFamily}"
                     FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="HeaderMetaText" FontSize="11" Foreground="{StaticResource MutedBrush}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock x:Name="BuiltInText" Grid.Column="2" VerticalAlignment="Center" MaxWidth="220"
                   TextWrapping="Wrap" TextAlignment="Right" FontSize="11"
                   Foreground="{StaticResource MutedBrush}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="320,*,380" ColumnSpacing="10">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
          <Border Style="{StaticResource CardStyle}" Padding="12">
            <StackPanel Spacing="9">
              <TextBlock x:Name="InfoHeader" Text="Preset information"
                         FontFamily="{StaticResource AppFontSemiBoldFamily}" FontSize="13"
                         FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
              <TextBlock x:Name="NameLabel" Text="Name" Style="{StaticResource MetricLabelStyle}" />
              <TextBox x:Name="NameBox" MaxLength="128" AutomationProperties.AutomationId="PresetEditorName"
                       TextChanged="NameChanged" />
              <TextBlock x:Name="IdLabel" Text="ID" Style="{StaticResource MetricLabelStyle}" />
              <TextBox x:Name="IdBox" MaxLength="96" AutomationProperties.AutomationId="PresetEditorId"
                       TextChanged="IdChanged" />
              <TextBlock x:Name="IdHintText" Text="Lowercase letters, digits and hyphens."
                         Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
              <TextBlock x:Name="KindLabel" Text="Kind" Style="{StaticResource MetricLabelStyle}" />
              <ComboBox x:Name="KindPicker" HorizontalAlignment="Stretch" MinHeight="36"
                        SelectionChanged="KindChanged" />
              <TextBlock x:Name="CategoryLabel" Text="Category" Style="{StaticResource MetricLabelStyle}" />
              <TextBox x:Name="CategoryBox" MaxLength="96" TextChanged="CategoryChanged" />
              <TextBlock x:Name="NoteLabel" Text="Note" Style="{StaticResource MetricLabelStyle}" />
              <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62"
                       MaxHeight="110" MaxLength="2048" TextChanged="NoteChanged" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Padding="12">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="LayersHeader" Text="Layers"
                           FontFamily="{StaticResource AppFontSemiBoldFamily}" FontSize="13"
                           FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="LayerSummaryText" Grid.Column="1" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
              </Grid>
              <ListView x:Name="LayerList" Height="188" SelectionMode="Single"
                        IsItemClickEnabled="False" SelectionChanged="LayerSelectionChanged"
                        KeyDown="LayerListKeyDown">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="1" Padding="2,4">
                      <TextBlock Text="{Binding ModuleName}" FontSize="12"
                                 Foreground="{StaticResource DataBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding DetailText}" FontSize="11"
                                 Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                <Button x:Name="AddLayerButton" Content="Add" Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="PresetEditorAddLayer" Click="AddLayerClick" />
                <Button x:Name="RemoveLayerButton" Grid.Column="1" Content="Remove"
                        Style="{StaticResource SecondaryButtonStyle}" Click="RemoveLayerClick" />
                <Button x:Name="DuplicateLayerButton" Grid.Column="2" Content="Duplicate"
                        Style="{StaticResource SecondaryButtonStyle}" Click="DuplicateLayerClick" />
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                <Button x:Name="MoveLayerUpButton" Content="Move up" Style="{StaticResource SecondaryButtonStyle}"
                        Click="MoveLayerUpClick" />
                <Button x:Name="MoveLayerDownButton" Grid.Column="1" Content="Move down"
                        Style="{StaticResource SecondaryButtonStyle}" Click="MoveLayerDownClick" />
              </Grid>
              <TextBlock x:Name="LayerLimitNotice" Text="" TextWrapping="Wrap" FontSize="11"
                         Foreground="{StaticResource WarningBrush}" Visibility="Collapsed" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="10">
        <Border Style="{StaticResource CardStyle}" Padding="10">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
              <TextBlock x:Name="PreviewHeader" Text="Preview" VerticalAlignment="Center"
                         FontFamily="{StaticResource AppFontSemiBoldFamily}" FontSize="13"
                         FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="PreviewDeviceButton" MinHeight="32"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="PresetEditorPreviewModeDevice"
                        Click="PreviewModeDeviceClick" />
                <Button x:Name="PreviewWorldButton" MinHeight="32"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="PresetEditorPreviewModeWorld"
                        Click="PreviewModeWorldClick" />
              </StackPanel>
              <ComboBox x:Name="DevicePicker" Grid.Column="2" MinWidth="150" MaxWidth="280"
                        HorizontalAlignment="Left" DisplayMemberPath="Name" MinHeight="32"
                        AutomationProperties.AutomationId="PresetEditorDevicePicker"
                        SelectionChanged="DeviceChanged" />
              <TextBlock x:Name="FpsText" Grid.Column="3" VerticalAlignment="Center"
                         FontFamily="Cascadia Mono,Consolas" FontSize="11"
                         Foreground="{StaticResource MutedBrush}" />
            </Grid>
            <Border Grid.Row="1" x:Name="PreviewSurface" Background="#0E0E0E"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3"
                    MinHeight="270" AutomationProperties.AutomationId="PresetEditorPreview"
                    PointerPressed="PreviewSurfacePointerPressed">
              <Grid>
                <Canvas x:Name="DevicePreviewCanvas" HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                <Canvas x:Name="WorldPreviewCanvas" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="NoPreviewText" Text="No preview" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="WorldHintText" Text="" FontSize="11" MaxWidth="380"
                           TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                           Margin="12" Foreground="{StaticResource WarningBrush}" Visibility="Collapsed" />
              </Grid>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <TextBlock x:Name="TimelineLabel" Text="Timeline" Style="{StaticResource MetricLabelStyle}"
                         VerticalAlignment="Center" />
              <Slider x:Name="TimelineSlider" Grid.Column="1" Minimum="0" Maximum="10"
                      StepFrequency="0.01" ValueChanged="TimelineChanged" />
              <ToggleSwitch x:Name="LoopToggle" Grid.Column="2" IsOn="True" OnContent="Loop"
                            OffContent="Loop" MinWidth="76" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
              <TextBlock x:Name="SimulationHeader" Text="Simulation"
                         FontFamily="{StaticResource AppFontSemiBoldFamily}" FontSize="12"
                         FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" />
              <TextBlock x:Name="TimeText" Text="0.00 / 10.00 s" FontSize="11"
                         FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <ToggleSwitch x:Name="SimKeysToggle" Header="Simulate keys" OffContent="Off"
                            OnContent="On" IsOn="True" Toggled="SimKeysToggled" />
              <StackPanel x:Name="SimScreenPanel" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="SimScreenButton" Content="Choose image"
                        Style="{StaticResource SecondaryButtonStyle}" Click="ChooseScreenImageClick" />
                <TextBlock x:Name="SimScreenText" Text="No image" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           MaxWidth="180" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="SimHintText" Grid.Column="2" Text="" FontSize="11" MaxWidth="230"
                       TextWrapping="Wrap" TextAlignment="Right" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
          <Border Style="{StaticResource CardStyle}" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock x:Name="ModuleHeader" Text="Module"
                         FontFamily="{StaticResource AppFontSemiBoldFamily}" FontSize="13"
                         FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
              <Button x:Name="ModulePickerButton" HorizontalAlignment="Stretch" MinHeight="38"
                      Style="{StaticResource SecondaryButtonStyle}"
                      AutomationProperties.AutomationId="PresetEditorModulePicker"
                      Click="ModulePickerClick">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock x:Name="ModulePickerText" Text="Choose a module" TextTrimming="CharacterEllipsis" />
                  <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontFamily="{StaticResource IconFontFamily}"
                            FontSize="11" />
                </Grid>
              </Button>
              <TextBlock x:Name="ModulePickerHint" Text="" FontSize="11"
                         Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock x:Name="ParametersHeader" Text="Parameters"
                         FontFamily="{StaticResource AppFontSemiBoldFamily}" FontSize="13"
                         FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
              <TextBlock x:Name="ParameterErrorText" Text="" FontSize="11"
                         Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                         Visibility="Collapsed" />
              <StackPanel x:Name="ParameterPanel" Spacing="10" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock x:Name="PaletteHeader" Text="Palette"
                         FontFamily="{StaticResource AppFontSemiBoldFamily}" FontSize="13"
                         FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
              <Border x:Name="PaletteStrip" Height="28" CornerRadius="3"
                      BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
              <StackPanel x:Name="PalettePanel" Spacing="6" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                <Button x:Name="PaletteAddButton" Content="Add color"
                        Style="{StaticResource SecondaryButtonStyle}" Click="AddPaletteClick" />
                <Button x:Name="PaletteResetButton" Grid.Column="1" Content="Reset palette"
                        Style="{StaticResource SecondaryButtonStyle}" Click="ResetPaletteClick" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Padding="12">
            <StackPanel Spacing="9">
              <TextBlock x:Name="LayerSettingsHeader" Text="Layer output"
                         FontFamily="{StaticResource AppFontSemiBoldFamily}" FontSize="13"
                         FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
              <TextBlock x:Name="BlendLabel" Text="Blend" Style="{StaticResource MetricLabelStyle}" />
              <ComboBox x:Name="BlendPicker" HorizontalAlignment="Stretch" MinHeight="36"
                        SelectionChanged="BlendChanged" />
              <TextBlock x:Name="OpacityLabel" Text="Opacity" Style="{StaticResource MetricLabelStyle}" />
              <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" StepFrequency="0.01"
                        ValueChanged="OpacitySliderChanged" />
                <NumberBox x:Name="OpacityBox" Grid.Column="1" Minimum="0" Maximum="1"
                           SmallChange="0.05" SpinButtonPlacementMode="Compact"
                           ValueChanged="OpacityBoxChanged" />
              </Grid>
              <TextBlock x:Name="SpeedLabel" Text="Speed" Style="{StaticResource MetricLabelStyle}" />
              <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                <Slider x:Name="SpeedSlider" Minimum="0" Maximum="5" StepFrequency="0.05"
                        ValueChanged="SpeedSliderChanged" />
                <NumberBox x:Name="SpeedBox" Grid.Column="1" Minimum="0.1" Maximum="5"
                           SmallChange="0.05" SpinButtonPlacementMode="Compact"
                           ValueChanged="SpeedBoxChanged" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="{StaticResource DataBrush}"
                     TextWrapping="Wrap" IsTextSelectionEnabled="True"
                     AutomationProperties.AutomationId="PresetEditorStatusText" />
          <TextBlock x:Name="ValidationSummaryText" Grid.Column="1" Text="" FontSize="11"
                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                     AutomationProperties.AutomationId="PresetEditorValidationSummary" />
        </Grid>
        <ListView x:Name="IssuesList" Grid.Row="1" MaxHeight="76" SelectionMode="Single"
                  IsItemClickEnabled="True" ItemClick="IssueClick">
          <ListView.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{StaticResource DangerBrush}" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="NoIssuesText" Grid.Row="1" Text="No issues" FontSize="11"
                   Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />
      </Grid>
    </Border>
  </Grid>
</Window>
