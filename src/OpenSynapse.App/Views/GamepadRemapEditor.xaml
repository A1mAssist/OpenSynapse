<UserControl
    x:Class="OpenSynapse.App.Views.GamepadRemapEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App">
  <StackPanel Spacing="10" Visibility="{Binding AnalogJoystickVisibility}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="2">
        <TextBlock local:Localized.Uid="GamepadRemapTitle"
                   FontSize="15"
                   FontFamily="{StaticResource AppFontSemiBoldFamily}"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding AnalogJoystickStatusText}"
                   Style="{StaticResource MetricLabelStyle}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1"
                    local:Localized.Uid="GamepadRemapEnabled"
                    IsOn="{Binding AnalogJoystickEnabled, Mode=TwoWay}"
                    IsEnabled="{Binding CanEditAnalogJoystick}"
                    OnContent=""
                    OffContent="" />
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="6">
      <Button local:Localized.Uid="GamepadRemapPresetWasd"
              Click="WasdPresetClick"
              Style="{StaticResource SecondaryButtonStyle}"
              MinHeight="30"
              Padding="10,0"
              IsEnabled="{Binding CanEditAnalogJoystick}" />
      <Button local:Localized.Uid="GamepadRemapPresetTriggers"
              Click="TriggerPresetClick"
              Style="{StaticResource SecondaryButtonStyle}"
              MinHeight="30"
              Padding="10,0"
              IsEnabled="{Binding CanEditAnalogJoystick}" />
      <Button local:Localized.Uid="GamepadRemapReset"
              Click="ResetPresetClick"
              Style="{StaticResource SecondaryButtonStyle}"
              MinHeight="30"
              Padding="10,0"
              IsEnabled="{Binding CanEditAnalogJoystick}" />
    </StackPanel>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
      <TextBlock local:Localized.Uid="GamepadRemapPhysicalKey"
                 Style="{StaticResource MetricLabelStyle}" />
      <TextBlock Grid.Column="1"
                 local:Localized.Uid="GamepadRemapButton"
                 Style="{StaticResource MetricLabelStyle}" />
    </Grid>

    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding AnalogJoystickRows}"
                    IsEnabled="{Binding CanEditAnalogJoystick}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,2">
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding Choices}"
                        SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        HorizontalAlignment="Stretch" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Button local:Localized.Uid="GamepadRemapApply"
            Click="ApplyClick"
            IsEnabled="{Binding CanApplyAnalogJoystick}"
            Style="{StaticResource RazerHidSaveButtonStyle}"
            HorizontalAlignment="Right" />
  </StackPanel>
</UserControl>
