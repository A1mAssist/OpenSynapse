<UserControl
    x:Class="OpenSynapse.App.Views.DevicePanels.HeadsetAudioPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    xmlns:views="using:OpenSynapse.App.Views">
  <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="{Binding CategoryText}" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Identity}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                  </Grid>
                  <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Warning" Message="{Binding ErrorText}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding OperationStatusText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" /><Button Grid.Column="1" local:Localized.Uid="RazerHeadsetRefreshButton" Click="HeadsetAudioRefreshClick" IsEnabled="{Binding CanRefresh}" Style="{StaticResource SecondaryButtonStyle}" /></Grid>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding Mixer053EVisibility}"><StackPanel Spacing="8" DataContext="{Binding Mixer053E}"><InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Warning" Message="{Binding ErrorText}" /><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerMixer053ETitle" Text="Audio Mixer" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><TextBlock Text="{Binding InfoSummary}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding FadersSummary}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding StatusSummary}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding ControlsVisibility}"><Button Content="{Binding Mute1Label}" Click="Mixer053EMute1Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" /><Button Content="{Binding Mute2Label}" Click="Mixer053EMute2Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" /><Button Content="{Binding Mute3Label}" Click="Mixer053EMute3Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" /><Button Content="{Binding Mute4Label}" Click="Mixer053EMute4Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" /><Button Content="{Binding MicMuteLabel}" Click="Mixer053EMicMuteClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Visibility="{Binding BrightnessVisibility}"><StackPanel Spacing="4"><TextBlock local:Localized.Uid="RazerMixer053EBrightnessLabel" Text="Brightness" Style="{StaticResource MetricLabelStyle}" /><Slider Value="{Binding Brightness, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="{Binding CanEdit}" /><TextBlock Text="{Binding BrightnessText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /></StackPanel><Button Grid.Column="1" local:Localized.Uid="RazerMixer053EApplyBrightness" Content="Apply brightness" Click="Mixer053EApplyBrightnessClick" IsEnabled="{Binding CanApplyBrightness}" Style="{StaticResource RazerHidSaveButtonStyle}" VerticalAlignment="Bottom" /></Grid><TextBlock Text="{Binding OperationStatusText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding ThxVisibility}">
                    <StackPanel Spacing="12">
                      <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetThxTitle" Text="THX Spatial Audio" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel>
                      <TextBlock local:Localized.Uid="RazerHeadsetThxDescription" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ThxStatusText}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button local:Localized.Uid="RazerHeadsetThxInstallButton" Click="HeadsetAudioInstallThxClick" Visibility="{Binding ThxInstallerVisibility}" IsEnabled="{Binding CanInstallThx}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button local:Localized.Uid="RazerHeadsetThxInstallerLinkButton" Click="HeadsetAudioOpenThxInstallerClick" Visibility="{Binding ThxInstallerLinkVisibility}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button local:Localized.Uid="RazerHeadsetThxGameProfilesButton" Click="HeadsetAudioOpenThxGameProfilesClick" Visibility="{Binding ThxGameProfilesVisibility}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button local:Localized.Uid="RazerHeadsetThxPatcherButton" Click="HeadsetAudioOpenThxPatcherClick" Visibility="{Binding ThxPatcherVisibility}" Style="{StaticResource SecondaryButtonStyle}" />
                      </StackPanel>
                      <StackPanel Spacing="12" Visibility="{Binding ThxControlsVisibility}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <ToggleSwitch local:Localized.Uid="RazerHeadsetThxSpatialToggle" IsOn="{Binding ThxSpatialEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThx}" />
                          <Button Grid.Column="1" local:Localized.Uid="RazerHeadsetThxSpatialApply" Click="HeadsetAudioApplyThxSpatialClick" IsEnabled="{Binding CanApplyThx}" Style="{StaticResource RazerHidSaveButtonStyle}" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel Spacing="4" Visibility="{Binding ThxS3BaselineVisibility}">
                          <Button local:Localized.Uid="RazerHeadsetThxS3Baseline" Click="HeadsetAudioApplyThxS3BaselineClick" IsEnabled="{Binding CanApplyThx}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Left" />
                          <TextBlock local:Localized.Uid="RazerHeadsetThxS3BaselineHint" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <ComboBox local:Localized.Uid="RazerHeadsetThxPresetLabel" ItemsSource="{Binding ThxPresetOptions}" SelectedIndex="{Binding SelectedThxPresetIndex, Mode=TwoWay}" IsEnabled="{Binding CanApplyThx}" HorizontalAlignment="Stretch" />
                          <Button Grid.Column="1" local:Localized.Uid="RazerHeadsetThxPresetApply" Click="HeadsetAudioApplyThxPresetClick" IsEnabled="{Binding CanApplyThx}" Style="{StaticResource RazerHidSaveButtonStyle}" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel Spacing="8" Visibility="{Binding ThxBandsVisibility}">
                          <TextBlock local:Localized.Uid="RazerHeadsetThxEqualizerTitle" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                          <ItemsControl ItemsSource="{Binding ThxBands}" IsEnabled="{Binding CanApplyThx}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid ColumnDefinitions="64,*,56" ColumnSpacing="8" MinHeight="30">
                                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" />
                                  <Slider Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{Binding Level, Mode=TwoWay}" />
                                  <TextBlock Grid.Column="2" Text="{Binding LevelText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Cascadia Mono,Consolas" FontSize="11" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button local:Localized.Uid="RazerHeadsetThxEqualizerApply" Click="HeadsetAudioApplyThxBandsClick" IsEnabled="{Binding CanApplyThx}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{Binding ThxNormalizationVisibility}">
                          <ToggleSwitch local:Localized.Uid="RazerHeadsetThxNormalizationToggle" IsOn="{Binding ThxNormalizationEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThx}" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ThxNormalizationLevel, Mode=TwoWay}" IsEnabled="{Binding CanApplyThx}" /><TextBlock Grid.Column="1" Text="{Binding ThxNormalizationText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid>
                          <Button local:Localized.Uid="RazerHeadsetThxNormalizationApply" Click="HeadsetAudioApplyThxNormalizationClick" IsEnabled="{Binding CanApplyThx}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{Binding ThxVoiceClarityVisibility}">
                          <ToggleSwitch local:Localized.Uid="RazerHeadsetThxVoiceClarityToggle" IsOn="{Binding ThxVoiceClarityEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThx}" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ThxVoiceClarityLevel, Mode=TwoWay}" IsEnabled="{Binding CanApplyThx}" /><TextBlock Grid.Column="1" Text="{Binding ThxVoiceClarityText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid>
                          <Button local:Localized.Uid="RazerHeadsetThxVoiceClarityApply" Click="HeadsetAudioApplyThxVoiceClarityClick" IsEnabled="{Binding CanApplyThx}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{Binding ThxBassBoostVisibility}">
                          <ToggleSwitch local:Localized.Uid="RazerHeadsetThxBassBoostToggle" IsOn="{Binding ThxBassBoostEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThx}" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ThxBassBoostLevel, Mode=TwoWay}" IsEnabled="{Binding CanApplyThx}" /><TextBlock Grid.Column="1" Text="{Binding ThxBassBoostText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid>
                          <Button local:Localized.Uid="RazerHeadsetThxBassBoostApply" Click="HeadsetAudioApplyThxBassBoostClick" IsEnabled="{Binding CanApplyThx}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{Binding ThxSidetoneVisibility}">
                          <ToggleSwitch local:Localized.Uid="RazerHeadsetThxSidetoneToggle" IsOn="{Binding ThxSidetoneEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThx}" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ThxSidetoneLevel, Mode=TwoWay}" IsEnabled="{Binding CanApplyThx}" /><TextBlock Grid.Column="1" Text="{Binding ThxSidetoneText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid>
                          <Button local:Localized.Uid="RazerHeadsetThxSidetoneApply" Click="HeadsetAudioApplyThxSidetoneClick" IsEnabled="{Binding CanApplyThx}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding GenericStatusVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetStatusTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6"><TextBlock local:Localized.Uid="RazerHeadsetFirmwareLabel" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding FirmwareText}" FontFamily="Cascadia Mono,Consolas" /><TextBlock Grid.Row="1" local:Localized.Uid="RazerHeadsetBatteryLabel" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BatteryText}" FontFamily="Cascadia Mono,Consolas" /><TextBlock Grid.Row="2" local:Localized.Uid="RazerHeadsetChargingLabel" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ChargingText}" FontFamily="Cascadia Mono,Consolas" /></Grid></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding EqPresetVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetEqPresetTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><ComboBox ItemsSource="{Binding EqPresetOptions}" SelectedIndex="{Binding SelectedEqPresetIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" /><Button local:Localized.Uid="RazerHeadsetEqPresetApply" Click="HeadsetAudioApplyEqPresetClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border>
                  </Grid>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding AvneraInfoVisibility}">
                    <StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetInfoTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel>
                      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                        <TextBlock local:Localized.Uid="RazerHidSerialLabel" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding SerialText}" FontFamily="Cascadia Mono,Consolas" TextWrapping="Wrap" /><views:CopyTextButton Grid.Column="2" Text="{Binding SerialText}" />
                        <TextBlock Grid.Row="1" local:Localized.Uid="RazerHeadsetEditionLabel" Text="Edition" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditionText}" FontFamily="Cascadia Mono,Consolas" />
                        <TextBlock Grid.Row="2" local:Localized.Uid="RazerHeadsetLinkStatusLabel" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LinkStatusText}" FontFamily="Cascadia Mono,Consolas" />
                        <TextBlock Grid.Row="3" local:Localized.Uid="RazerHeadsetDockFirmwareLabel" Foreground="{StaticResource MutedBrush}" Visibility="{Binding DockInfoVisibility}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DockFirmwareText}" FontFamily="Cascadia Mono,Consolas" Visibility="{Binding DockInfoVisibility}" />
                        <TextBlock Grid.Row="4" local:Localized.Uid="RazerHeadsetDockSerialLabel" Foreground="{StaticResource MutedBrush}" Visibility="{Binding DockInfoVisibility}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DockSerialText}" FontFamily="Cascadia Mono,Consolas" TextWrapping="Wrap" Visibility="{Binding DockInfoVisibility}" /><views:CopyTextButton Grid.Row="4" Grid.Column="2" Text="{Binding DockSerialText}" Visibility="{Binding DockInfoVisibility}" />
                        <TextBlock Grid.Row="5" local:Localized.Uid="RazerHeadsetDockEditionLabel" Foreground="{StaticResource MutedBrush}" Visibility="{Binding DockInfoVisibility}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DockEditionText}" FontFamily="Cascadia Mono,Consolas" Visibility="{Binding DockInfoVisibility}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding EqBandsVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetEqBandsTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><ItemsControl ItemsSource="{Binding EqBands}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="64,*,36" ColumnSpacing="8" MinHeight="30"><TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /><Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" StepFrequency="{Binding Step}" Value="{Binding Level, Mode=TwoWay}" /><TextBlock Grid.Column="2" Text="{Binding LevelText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button local:Localized.Uid="RazerHeadsetEqBandsApply" Click="HeadsetAudioApplyEqBandsClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding MicEqBandsVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetMicEqBandsTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><ItemsControl ItemsSource="{Binding MicEqBands}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="64,*,36" ColumnSpacing="8" MinHeight="30"><TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /><Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" StepFrequency="{Binding Step}" Value="{Binding Level, Mode=TwoWay}" /><TextBlock Grid.Column="2" Text="{Binding LevelText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button local:Localized.Uid="RazerHeadsetMicEqBandsApply" Click="HeadsetAudioApplyMicEqBandsClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding BassVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetBassTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><Slider Value="{Binding Bass, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="{Binding CanEdit}" /><TextBlock Text="{Binding BassText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /><Button local:Localized.Uid="RazerHeadsetBassApply" Click="HeadsetAudioApplyBassClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding MicCardVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetMicTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><ToggleSwitch local:Localized.Uid="RazerHeadsetMicMuteToggle" IsOn="{Binding MicMuted, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" /><Slider Value="{Binding MicVolume, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" Visibility="{Binding MicVolumeVisibility}" IsEnabled="{Binding CanEdit}" /><TextBlock Text="{Binding MicVolumeText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" Visibility="{Binding MicVolumeVisibility}" /><Button local:Localized.Uid="RazerHeadsetMicApply" Click="HeadsetAudioApplyMicClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding AudioSourceVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetSourceTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><ComboBox ItemsSource="{Binding AudioSourceOptions}" SelectedIndex="{Binding SelectedSourceIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" /><Button local:Localized.Uid="RazerHeadsetSourceApply" Click="HeadsetAudioApplySourceClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding NoiseSuppressionVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetNoiseTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><ToggleSwitch local:Localized.Uid="RazerHeadsetNoiseToggle" IsOn="{Binding NoiseSuppression, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" /><Button local:Localized.Uid="RazerHeadsetNoiseApply" Click="HeadsetAudioApplyNoiseClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border>
                  </Grid>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding AncVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetAncTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><ComboBox local:Localized.Uid="RazerHeadsetAncModeLabel" ItemsSource="{Binding AncOptions}" SelectedIndex="{Binding SelectedAncIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" /><NumberBox Grid.Column="1" local:Localized.Uid="RazerHeadsetAncLevelLabel" Value="{Binding AncLevel, Mode=TwoWay}" Minimum="0" Maximum="10" SmallChange="1" SpinButtonPlacementMode="Compact" Visibility="{Binding AncLevelVisibility}" IsEnabled="{Binding CanEdit}" /></Grid><TextBlock Text="{Binding AncLevelText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /><Button local:Localized.Uid="RazerHeadsetAncApply" Click="HeadsetAudioApplyAncClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding AdvancedAudioVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetAdvancedAudioTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><Grid ColumnDefinitions="*,*" ColumnSpacing="16"><StackPanel Spacing="6"><ToggleSwitch local:Localized.Uid="RazerHeadsetDndToggle" IsOn="{Binding Dnd, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding DndVisibility}" /><ToggleSwitch local:Localized.Uid="RazerHeadsetAutoPauseToggle" IsOn="{Binding AutoPause, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding AutoPauseVisibility}" /><ToggleSwitch local:Localized.Uid="RazerHeadsetGestureToggle" IsOn="{Binding GestureControl, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding GestureControlVisibility}" /></StackPanel><StackPanel Grid.Column="1" Spacing="6"><ToggleSwitch local:Localized.Uid="RazerHeadsetDolbyToggle" IsOn="{Binding Dolby, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding DolbyVisibility}" /><ToggleSwitch local:Localized.Uid="RazerHeadsetNightModeToggle" IsOn="{Binding NightMode, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding NightModeVisibility}" /><ToggleSwitch local:Localized.Uid="RazerHeadsetVoicePromptToggle" IsOn="{Binding VoicePrompts, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding VoicePromptsVisibility}" /></StackPanel></Grid><Button local:Localized.Uid="RazerHeadsetAdvancedAudioApply" Click="HeadsetAudioApplyAdvancedClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border><Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding MicProcessingVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetMicProcessingTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><StackPanel Spacing="4" Visibility="{Binding MicDeEsserVisibility}"><TextBlock local:Localized.Uid="RazerHeadsetDeEsserLabel" Style="{StaticResource MetricLabelStyle}" /><Slider Value="{Binding MicDeEsser, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="{Binding CanEdit}" /><TextBlock Text="{Binding MicDeEsserText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /></StackPanel><StackPanel Spacing="4" Visibility="{Binding MicLimiterVisibility}"><TextBlock local:Localized.Uid="RazerHeadsetLimiterLabel" Style="{StaticResource MetricLabelStyle}" /><Slider Value="{Binding MicLimiterDb, Mode=TwoWay}" Minimum="-60" Maximum="0" StepFrequency="1" IsEnabled="{Binding CanEdit}" /><TextBlock Text="{Binding MicLimiterText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /></StackPanel><StackPanel Spacing="4" Visibility="{Binding MicReverbVisibility}"><TextBlock local:Localized.Uid="RazerHeadsetReverbLabel" Style="{StaticResource MetricLabelStyle}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><ComboBox ItemsSource="{Binding MicReverbOptions}" SelectedIndex="{Binding SelectedMicReverbIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" /><Slider Grid.Column="1" Value="{Binding MicReverbIntensity, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="{Binding CanEdit}" /></Grid><TextBlock Text="{Binding MicReverbIntensityText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /></StackPanel><Button local:Localized.Uid="RazerHeadsetMicProcessingApply" Click="HeadsetAudioApplyMicProcessingClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border><Border Style="{StaticResource CardStyle}" Padding="16" Visibility=