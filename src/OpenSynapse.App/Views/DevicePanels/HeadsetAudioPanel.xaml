<UserControl
    x:Class="OpenSynapse.App.Views.DevicePanels.HeadsetAudioPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    xmlns:controls="using:OpenSynapse.App.Controls"
    xmlns:panels="using:OpenSynapse.App.Views.DevicePanels"
    xmlns:views="using:OpenSynapse.App.Views">
  <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <TextBlock Text="{Binding CategoryText}" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding OperationStatusText}" Visibility="{Binding OperationStatusVisibility}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="HeadsetOperationStatus" AutomationProperties.LiveSetting="Polite" />
                    <Button Grid.Column="2" local:Localized.Uid="RazerHeadsetRefreshButton" Click="HeadsetAudioRefreshClick" IsEnabled="{Binding CanRefresh}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                  </Grid>
                  <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Warning" Message="{Binding ErrorText}" />
                  <StackPanel Visibility="{Binding RipsawVisibility}">
                    <panels:RazerRipsawPanel DataContext="{Binding Ripsaw}" />
                  </StackPanel>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding Mixer053EVisibility}"><StackPanel Spacing="8" DataContext="{Binding Mixer053E}"><InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Warning" Message="{Binding ErrorText}" /><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerMixer053ETitle" Text="Audio Mixer" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><TextBlock Text="{Binding InfoSummary}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding FadersSummary}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding StatusSummary}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding ControlsVisibility}"><Button Content="{Binding Mute1Label}" Click="Mixer053EMute1Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" /><Button Content="{Binding Mute2Label}" Click="Mixer053EMute2Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" /><Button Content="{Binding Mute3Label}" Click="Mixer053EMute3Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" /><Button Content="{Binding Mute4Label}" Click="Mixer053EMute4Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" /><Button Content="{Binding MicMuteLabel}" Click="Mixer053EMicMuteClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Visibility="{Binding BrightnessVisibility}"><StackPanel Spacing="4"><TextBlock local:Localized.Uid="RazerMixer053EBrightnessLabel" Text="Brightness" Style="{StaticResource MetricLabelStyle}" /><Slider Value="{Binding Brightness, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="{Binding CanEdit}" /><TextBlock Text="{Binding BrightnessText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /></StackPanel><Button Grid.Column="1" local:Localized.Uid="RazerMixer053EApplyBrightness" Content="Apply brightness" Click="Mixer053EApplyBrightnessClick" IsEnabled="{Binding CanApplyBrightness}" Style="{StaticResource RazerHidSaveButtonStyle}" VerticalAlignment="Bottom" /></Grid><TextBlock Text="{Binding OperationStatusText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding ThxVisibility}">
                    <StackPanel Spacing="12">
                      <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetThxTitle" Text="THX Spatial Audio" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel>
                      <TextBlock local:Localized.Uid="RazerHeadsetThxDescription" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ThxStatusText}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button local:Localized.Uid="RazerHeadsetThxInstallButton" Click="HeadsetAudioInstallThxClick" Visibility="{Binding ThxInstallerVisibility}" IsEnabled="{Binding CanInstallThx}" Style="{StaticResource PrimaryButtonStyle}" />
                      </StackPanel>
                      <controls:DownloadProgressPanel State="{Binding ThxProgress}" />
                      <StackPanel Spacing="12" Visibility="{Binding ThxControlsVisibility}">
                        <StackPanel x:Name="ThxSpatialGroup" Spacing="4">
                          <ToggleSwitch local:Localized.Uid="RazerHeadsetThxSpatialToggle" IsOn="{Binding ThxSpatialEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThx}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Visibility="{Binding ThxS3BaselineVisibility}">
                          <Button local:Localized.Uid="RazerHeadsetThxS3Baseline" Click="HeadsetAudioApplyThxS3BaselineClick" IsEnabled="{Binding CanApplyThx}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Left" />
                          <TextBlock local:Localized.Uid="RazerHeadsetThxS3BaselineHint" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="ThxPresetGroup" Spacing="4">
                          <ComboBox local:Localized.Uid="RazerHeadsetThxPresetLabel" ItemsSource="{Binding ThxPresetOptions}" SelectedIndex="{Binding SelectedThxPresetIndex, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxEqualizer}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel x:Name="ThxBandsGroup" Spacing="8" Visibility="{Binding ThxBandsVisibility}">
                          <TextBlock local:Localized.Uid="RazerHeadsetThxEqualizerTitle" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                          <controls:EqualizerCurveEditor Bands="{Binding ThxBands}" IsEnabled="{Binding CanApplyThxEqualizer}" />
                          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button local:Localized.Uid="RazerHeadsetThxImportSynapse" Click="HeadsetAudioImportSynapseEqClick" IsEnabled="{Binding CanApplyThxEqualizer}" Style="{StaticResource SecondaryButtonStyle}" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="ThxNormalizationGroup" Spacing="8" Visibility="{Binding ThxNormalizationVisibility}">
                          <ToggleSwitch local:Localized.Uid="RazerHeadsetThxNormalizationToggle" IsOn="{Binding ThxNormalizationEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxNormalization}" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ThxNormalizationLevel, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxNormalization}" /><TextBlock Grid.Column="1" Text="{Binding ThxNormalizationText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid>
                        </StackPanel>
                        <StackPanel x:Name="ThxVoiceClarityGroup" Spacing="8" Visibility="{Binding ThxVoiceClarityVisibility}">
                          <ToggleSwitch local:Localized.Uid="RazerHeadsetThxVoiceClarityToggle" IsOn="{Binding ThxVoiceClarityEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxVoiceClarity}" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ThxVoiceClarityLevel, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxVoiceClarity}" /><TextBlock Grid.Column="1" Text="{Binding ThxVoiceClarityText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid>
                        </StackPanel>
                        <StackPanel x:Name="ThxBassBoostGroup" Spacing="8" Visibility="{Binding ThxBassBoostVisibility}">
                          <ToggleSwitch local:Localized.Uid="RazerHeadsetThxBassBoostToggle" IsOn="{Binding ThxBassBoostEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxBassBoost}" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ThxBassBoostLevel, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxBassBoost}" /><TextBlock Grid.Column="1" Text="{Binding ThxBassBoostText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid>
                        </StackPanel>
                        <StackPanel x:Name="ThxSidetoneGroup" Spacing="8" Visibility="{Binding ThxSidetoneVisibility}">
                          <ToggleSwitch local:Localized.Uid="RazerHeadsetThxSidetoneToggle" IsOn="{Binding ThxSidetoneEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxSidetone}" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ThxSidetoneLevel, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxSidetone}" /><TextBlock Grid.Column="1" Text="{Binding ThxSidetoneText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding ThxCaptureVisibility}">
                    <StackPanel Spacing="12">
                      <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetThxCaptureTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel>
                      <StackPanel x:Name="ThxCaptureNormalizationGroup" Spacing="4" Visibility="{Binding ThxCaptureNormalizationVisibility}">
                        <ToggleSwitch local:Localized.Uid="RazerHeadsetThxCaptureNormalizationToggle" IsOn="{Binding ThxCaptureNormalizationEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxCaptureNormalization}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ThxCaptureNormalizationLevel, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxCaptureNormalization}" /><TextBlock Grid.Column="1" Text="{Binding ThxCaptureNormalizationText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid>
                      </StackPanel>
                      <StackPanel x:Name="ThxCaptureVocalClarityGroup" Spacing="4" Visibility="{Binding ThxCaptureVocalClarityVisibility}">
                        <ToggleSwitch local:Localized.Uid="RazerHeadsetThxCaptureVocalClarityToggle" IsOn="{Binding ThxCaptureVocalClarityEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxCaptureVocalClarity}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ThxCaptureVocalClarityLevel, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxCaptureVocalClarity}" /><TextBlock Grid.Column="1" Text="{Binding ThxCaptureVocalClarityText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid>
                      </StackPanel>
                      <StackPanel x:Name="ThxCaptureNoiseReductionGroup" Spacing="4" Visibility="{Binding ThxCaptureNoiseReductionVisibility}">
                        <ToggleSwitch local:Localized.Uid="RazerHeadsetThxCaptureNoiseReductionToggle" IsOn="{Binding ThxCaptureNoiseReductionEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxCaptureNoiseReduction}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ThxCaptureNoiseReductionLevel, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxCaptureNoiseReduction}" /><TextBlock Grid.Column="1" Text="{Binding ThxCaptureNoiseReductionText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid>
                      </StackPanel>
                      <StackPanel x:Name="ThxCaptureVoiceGateGroup" Spacing="4" Visibility="{Binding ThxCaptureVoiceGateVisibility}">
                        <ToggleSwitch local:Localized.Uid="RazerHeadsetThxCaptureVoiceGateToggle" IsOn="{Binding ThxCaptureVoiceGateEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxCaptureVoiceGate}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding ThxCaptureVoiceGateLevel, Mode=TwoWay}" IsEnabled="{Binding CanApplyThxCaptureVoiceGate}" /><TextBlock Grid.Column="1" Text="{Binding ThxCaptureVoiceGateText}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas" FontSize="11" /></Grid>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding GenericStatusVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetStatusTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6"><TextBlock local:Localized.Uid="RazerHeadsetFirmwareLabel" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding FirmwareText}" FontFamily="Cascadia Mono,Consolas" /><TextBlock Grid.Row="1" local:Localized.Uid="RazerHeadsetBatteryLabel" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BatteryText}" FontFamily="Cascadia Mono,Consolas" /><TextBlock Grid.Row="2" local:Localized.Uid="RazerHeadsetChargingLabel" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ChargingText}" FontFamily="Cascadia Mono,Consolas" /></Grid></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding EqPresetVisibility}"><StackPanel x:Name="EqPresetGroup" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetEqPresetTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><ComboBox ItemsSource="{Binding EqPresetOptions}" SelectedIndex="{Binding SelectedEqPresetIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" /></StackPanel></Border>
                  </Grid>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding AvneraInfoVisibility}">
                    <StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetInfoTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel>
                      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                        <TextBlock local:Localized.Uid="RazerHidSerialLabel" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding SerialText}" FontFamily="Cascadia Mono,Consolas" TextWrapping="Wrap" /><views:CopyTextButton Grid.Column="2" Text="{Binding SerialText}" />
                        <TextBlock Grid.Row="1" local:Localized.Uid="RazerHeadsetEditionLabel" Text="Edition" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditionText}" FontFamily="Cascadia Mono,Consolas" />
                        <TextBlock Grid.Row="2" local:Localized.Uid="RazerHeadsetLinkStatusLabel" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LinkStatusText}" FontFamily="Cascadia Mono,Consolas" />
                        <TextBlock Grid.Row="3" local:Localized.Uid="RazerHeadsetDockFirmwareLabel" Foreground="{StaticResource MutedBrush}" Visibility="{Binding DockInfoVisibility}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DockFirmwareText}" FontFamily="Cascadia Mono,Consolas" Visibility="{Binding DockInfoVisibility}" />
                        <TextBlock Grid.Row="4" local:Localized.Uid="RazerHeadsetDockSerialLabel" Foreground="{StaticResource MutedBrush}" Visibility="{Binding DockInfoVisibility}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DockSerialText}" FontFamily="Cascadia Mono,Consolas" TextWrapping="Wrap" Visibility="{Binding DockInfoVisibility}" /><views:CopyTextButton Grid.Row="4" Grid.Column="2" Text="{Binding DockSerialText}" Visibility="{Binding DockInfoVisibility}" />
                        <TextBlock Grid.Row="5" local:Localized.Uid="RazerHeadsetDockEditionLabel" Foreground="{StaticResource MutedBrush}" Visibility="{Binding DockInfoVisibility}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DockEditionText}" FontFamily="Cascadia Mono,Consolas" Visibility="{Binding DockInfoVisibility}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding EqBandsVisibility}"><StackPanel x:Name="EqBandsGroup" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetEqBandsTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><controls:EqualizerCurveEditor Bands="{Binding EqBands}" IsEnabled="{Binding CanEdit}" /></StackPanel></Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding MicEqBandsVisibility}"><StackPanel x:Name="MicEqBandsGroup" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetMicEqBandsTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><controls:EqualizerCurveEditor Bands="{Binding MicEqBands}" IsEnabled="{Binding CanEdit}" /></StackPanel></Border>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding SpatialModeVisibility}">
                      <StackPanel x:Name="SpatialModeGroup" Spacing="8">
                        <TextBlock local:Localized.Uid="LeviathanSpatialTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                        <ComboBox AutomationProperties.AutomationId="LeviathanSpatialMode" ItemsSource="{Binding SpatialModeOptions}" SelectedIndex="{Binding SelectedSpatialModeIndex, Mode=TwoWay}" IsEnabled="{Binding CanEditSpatialMode}" HorizontalAlignment="Stretch" />
                        <TextBlock local:Localized.Uid="LeviathanSpatialDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding BassVisibility}"><StackPanel x:Name="BassGroup" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetBassTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><Slider Value="{Binding Bass, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="{Binding CanEdit}" /><TextBlock Text="{Binding BassText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding MicCardVisibility}"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetMicTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><StackPanel x:Name="MicrophoneGroup" Spacing="8"><ToggleSwitch local:Localized.Uid="RazerHeadsetMicMuteToggle" IsOn="{Binding MicMuted, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" /><Slider Value="{Binding MicVolume, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" Visibility="{Binding MicVolumeVisibility}" IsEnabled="{Binding CanEdit}" /><TextBlock Text="{Binding MicVolumeText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" Visibility="{Binding MicVolumeVisibility}" /></StackPanel><StackPanel x:Name="CamyT1Group" Spacing="8" Visibility="{Binding MicDspVisibility}"><ToggleSwitch local:Localized.Uid="RazerHeadsetMicHpfToggle" IsOn="{Binding MicHpf, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding MicHpfVisibility}" /><ToggleSwitch local:Localized.Uid="RazerHeadsetMicLimiterToggle" IsOn="{Binding MicLimiterEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding MicLimiterEnabledVisibility}" /></StackPanel></StackPanel></Border>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding AudioSourceVisibility}"><StackPanel x:Name="SourceGroup" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetSourceTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><ComboBox ItemsSource="{Binding AudioSourceOptions}" SelectedIndex="{Binding SelectedSourceIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding NoiseSuppressionVisibility}"><StackPanel x:Name="NoiseGroup" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetNoiseTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><ToggleSwitch local:Localized.Uid="RazerHeadsetNoiseToggle" IsOn="{Binding NoiseSuppression, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" /></StackPanel></Border>
                  </Grid>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding AncVisibility}"><StackPanel x:Name="AncGroup" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetAncTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><ComboBox local:Localized.Uid="RazerHeadsetAncModeLabel" ItemsSource="{Binding AncOptions}" SelectedIndex="{Binding SelectedAncIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" /><NumberBox Grid.Column="1" local:Localized.Uid="RazerHeadsetAncLevelLabel" Value="{Binding AncLevel, Mode=TwoWay}" Minimum="0" Maximum="10" SmallChange="1" SpinButtonPlacementMode="Compact" Visibility="{Binding AncLevelVisibility}" IsEnabled="{Binding CanEdit}" /></Grid><TextBlock Text="{Binding AncLevelText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding AdvancedAudioVisibility}"><StackPanel x:Name="AdvancedGroup" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetAdvancedAudioTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><Grid ColumnDefinitions="*,*" ColumnSpacing="16"><StackPanel Spacing="6"><ToggleSwitch local:Localized.Uid="RazerHeadsetDndToggle" IsOn="{Binding Dnd, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding DndVisibility}" /><ToggleSwitch local:Localized.Uid="RazerHeadsetAutoPauseToggle" IsOn="{Binding AutoPause, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding AutoPauseVisibility}" /><ToggleSwitch local:Localized.Uid="RazerHeadsetGestureToggle" IsOn="{Binding GestureControl, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding GestureControlVisibility}" /></StackPanel><StackPanel Grid.Column="1" Spacing="6"><ToggleSwitch local:Localized.Uid="RazerHeadsetDolbyToggle" IsOn="{Binding Dolby, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding DolbyVisibility}" /><ToggleSwitch local:Localized.Uid="RazerHeadsetNightModeToggle" IsOn="{Binding NightMode, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding NightModeVisibility}" /><ToggleSwitch local:Localized.Uid="RazerHeadsetVoicePromptToggle" IsOn="{Binding VoicePrompts, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Visibility="{Binding VoicePromptsVisibility}" /></StackPanel></Grid></StackPanel></Border><Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding MicProcessingVisibility}"><StackPanel x:Name="MicProcessingGroup" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetMicProcessingTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><StackPanel Spacing="4" Visibility="{Binding MicDeEsserVisibility}"><TextBlock local:Localized.Uid="RazerHeadsetDeEsserLabel" Style="{StaticResource MetricLabelStyle}" /><Slider Value="{Binding MicDeEsser, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="{Binding CanEdit}" /><TextBlock Text="{Binding MicDeEsserText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /></StackPanel><StackPanel Spacing="4" Visibility="{Binding MicLimiterVisibility}"><TextBlock local:Localized.Uid="RazerHeadsetLimiterLabel" Style="{StaticResource MetricLabelStyle}" /><Slider Value="{Binding MicLimiterDb, Mode=TwoWay}" Minimum="-60" Maximum="0" StepFrequency="1" IsEnabled="{Binding CanEdit}" /><TextBlock Text="{Binding MicLimiterText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /></StackPanel><StackPanel Spacing="4" Visibility="{Binding MicReverbVisibility}"><TextBlock local:Localized.Uid="RazerHeadsetReverbLabel" Style="{StaticResource MetricLabelStyle}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><ComboBox ItemsSource="{Binding MicReverbOptions}" SelectedIndex="{Binding SelectedMicReverbIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" /><Slider Grid.Column="1" Value="{Binding MicReverbIntensity, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="{Binding CanEdit}" /></Grid><TextBlock Text="{Binding MicReverbIntensityText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /></StackPanel></StackPanel></Border><Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding MicMonitoringVisibility}"><StackPanel x:Name="MicMonitoringGroup" Spacing="8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="RazerHeadsetMicMonitoringTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel><TextBlock local:Localized.Uid="HeadsetSidetoneHelp" Foreground="{St