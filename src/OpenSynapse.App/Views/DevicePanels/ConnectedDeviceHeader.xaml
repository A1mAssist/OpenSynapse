<UserControl
    x:Class="OpenSynapse.App.Views.DevicePanels.ConnectedDeviceHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <local:BatteryFillWidthConverter x:Key="BatteryFillWidthConverter" />
    <local:BatteryLevelBrushConverter x:Key="BatteryLevelBrushConverter" />
  </UserControl.Resources>
      <Grid ColumnDefinitions="64,*" ColumnSpacing="16" MinHeight="72">
        <Grid Width="64" Height="64" VerticalAlignment="Center">
          <FontIcon Glyph="{Binding IconGlyph}" Visibility="{Binding IconVisibility}" FontFamily="{StaticResource IconFontFamily}" FontSize="32" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{Binding ProductImage}" Stretch="Uniform" AutomationProperties.AutomationId="DeviceHeaderProductImage" AutomationProperties.Name="{Binding Name}" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="24" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" AutomationProperties.AutomationId="DeviceHeaderName" AutomationProperties.HeadingLevel="Level1" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{Binding StatusBrush}" />
            <TextBlock x:Name="DeviceHeaderStatus" Text="{Binding Access}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Visibility="{Binding BatteryRow.IsBatteryAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
              <TextBlock Text="&#183;" FontSize="11" Foreground="{StaticResource LineStrongBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                  <Grid Width="16" Height="10">
                    <Border BorderBrush="{StaticResource MutedBrush}" BorderThickness="1" CornerRadius="2" />
                    <Border Margin="2" HorizontalAlignment="Left" CornerRadius="1" Background="{Binding BatteryRow.BatteryPercent, Converter={StaticResource BatteryLevelBrushConverter}}" Width="{Binding BatteryRow.BatteryPercent, Converter={StaticResource BatteryFillWidthConverter}}" />
                  </Grid>
                  <Border Width="2" Height="4" CornerRadius="0,1,1,0" Background="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding BatteryRow.BatteryText}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
</UserControl>
