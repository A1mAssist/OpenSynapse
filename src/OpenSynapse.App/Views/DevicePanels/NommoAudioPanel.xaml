<UserControl x:Class="OpenSynapse.App.Views.DevicePanels.NommoAudioPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    xmlns:controls="using:OpenSynapse.App.Controls">
  <Border Style="{StaticResource CardStyle}" Padding="16">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
        <Button Grid.Column="1" local:Localized.Uid="CoolingPadRefreshButton" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" Style="{StaticResource SecondaryButtonStyle}" />
      </Grid>
      <InfoBar IsOpen="{Binding HasError}" Message="{Binding ErrorText}" Severity="Warning" IsClosable="False" />
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
      <TextBlock x:Name="VolumeLabel" local:Localized.Uid="AccessoryAudioVolume" />
      <Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding CanEditVolume}" AutomationProperties.LabeledBy="{Binding ElementName=VolumeLabel}" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="MuteLabel" local:Localized.Uid="AccessoryAudioMute" VerticalAlignment="Center" />
        <ToggleSwitch Grid.Column="1" IsOn="{Binding IsMuted, Mode=TwoWay}" IsEnabled="{Binding CanEditMute}" OnContent="" OffContent="" AutomationProperties.LabeledBy="{Binding ElementName=MuteLabel}" />
      </Grid>
      <TextBlock x:Name="PresetLabel" local:Localized.Uid="AccessoryAudioEqPreset" />
      <ComboBox ItemsSource="{Binding NommoPresets}" SelectedIndex="{Binding EqPresetIndex, Mode=TwoWay}" IsEnabled="{Binding CanEditEq}" HorizontalAlignment="Stretch" AutomationProperties.LabeledBy="{Binding ElementName=PresetLabel}" />
      <StackPanel Spacing="12" Visibility="{Binding NommoProVisibility}">
        <controls:EqualizerCurveEditor Bands="{Binding NommoBands}" IsEnabled="{Binding CanEditBands}" />
        <ToggleSwitch Header="Dolby" IsOn="{Binding Dolby, Mode=TwoWay}" IsEnabled="{Binding CanEditDolby}" />
        <TextBlock x:Name="BassLabel" local:Localized.Uid="AccessoryAudioBass" />
        <Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding Bass, Mode=TwoWay}" IsEnabled="{Binding CanEditBass}" AutomationProperties.LabeledBy="{Binding ElementName=BassLabel}" />
        <TextBlock x:Name="InputLabel" local:Localized.Uid="AccessoryAudioInput" />
        <ComboBox ItemsSource="{Binding NommoInputs}" SelectedIndex="{Binding NommoInputIndex, Mode=TwoWay}" IsEnabled="{Binding CanEditInput}" HorizontalAlignment="Stretch" AutomationProperties.LabeledBy="{Binding ElementName=InputLabel}" />
      </StackPanel>
      <Button local:Localized.Uid="AccessoryApplyButton" Click="ApplyClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" />
    </StackPanel>
  </Border>
</UserControl>
