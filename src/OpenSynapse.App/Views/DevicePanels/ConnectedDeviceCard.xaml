<UserControl
    x:Class="OpenSynapse.App.Views.DevicePanels.ConnectedDeviceCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <local:BatteryFillWidthConverter x:Key="BatteryFillWidthConverter" />
    <local:BatteryLevelBrushConverter x:Key="BatteryLevelBrushConverter" />
  </UserControl.Resources>
  <StackPanel>
    <Button Tag="{Binding Source}" Click="CardButtonClick" Style="{StaticResource QuickActionButtonStyle}" Padding="12" MinHeight="60" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}" ToolTipService.ToolTip="{Binding Identity}">
      <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
        <Border Width="44" Height="36" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="4">
          <Grid>
            <FontIcon Glyph="{Binding IconGlyph}" Visibility="{Binding IconVisibility}" FontFamily="{StaticResource IconFontFamily}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{Binding ProductImage}" Stretch="Uniform" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" TextWrapping="Wrap" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" />
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2" MaxWidth="320">
          <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
            <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{Binding StatusBrush}" />
            <TextBlock Text="{Binding Access}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Visibility="{Binding BatteryRow.IsBatteryAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
              <TextBlock Text="&#183;" FontSize="11" Foreground="{StaticResource LineStrongBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                  <Grid Width="16" Height="10">
                    <Border BorderBrush="{StaticResource MutedBrush}" BorderThickness="1" CornerRadius="2" />
                    <Border Margin="2" HorizontalAlignment="Left" CornerRadius="1" Background="{Binding BatteryRow.BatteryPercent, Converter={StaticResource BatteryLevelBrushConverter}}" Width="{Binding BatteryRow.BatteryPercent, Converter={StaticResource BatteryFillWidthConverter}}" />
                  </Grid>
                  <Border Width="2" Height="4" CornerRadius="0,1,1,0" Background="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding BatteryRow.BatteryText}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="&#183;" FontSize="11" Foreground="{StaticResource LineStrongBrush}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{Binding Error}" FontSize="10" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" HorizontalAlignment="Right" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
      </Grid>
    </Button>
    <StackPanel Margin="12,2,12,8" Spacing="2" Visibility="{Binding HasResetOnboardProfileFooter, Converter={StaticResource BoolToVisibilityConverter}}">
      <HyperlinkButton Content="{Binding ResetOnboardProfileActionText}" Click="ResetButtonClick" IsEnabled="{Binding CanResetOnboardProfileNow}" AutomationProperties.Name="{Binding ResetOnboardProfileActionText}" HorizontalAlignment="Left" Padding="0" MinHeight="26" Visibility="{Binding CanResetOnboardProfile, Converter={StaticResource BoolToVisibilityConverter}}" />
      <TextBlock Text="{Binding ResetOnboardProfileStatusText}" Foreground="{Binding ResetOnboardProfileStatusBrush}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding HasResetOnboardProfileStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
    </StackPanel>
  </StackPanel>
</UserControl>
