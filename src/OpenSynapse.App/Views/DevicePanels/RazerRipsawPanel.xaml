<UserControl
    x:Class="OpenSynapse.App.Views.DevicePanels.RazerRipsawPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}" Padding="20">
        <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="Ripsaw HD" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{Binding RefreshLabel}" Click="RefreshClick"
                    IsEnabled="{Binding CanRefresh}" Style="{StaticResource SecondaryButtonStyle}"
                    AutomationProperties.AutomationId="RipsawRefresh" />
            </Grid>
            <TextBlock Text="{Binding HdmiText}" TextWrapping="Wrap" />
            <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Warning" Message="{Binding ErrorText}" />
            <ItemsControl ItemsSource="{Binding Channels}" IsEnabled="{Binding CanEdit}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="8" Margin="0,0,0,20">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding VolumeText}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1"
                                AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="{Binding Channel}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <CheckBox Content="{Binding MuteLabel}" IsChecked="{Binding Muted, Mode=TwoWay}"
                                    AutomationProperties.Name="{Binding Label}" />
                                <Button Grid.Column="1" Content="{Binding ApplyLabel}" Click="ApplyClick"
                                    Style="{StaticResource RazerHidSaveButtonStyle}" AutomationProperties.Name="{Binding Label}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding InfoText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
