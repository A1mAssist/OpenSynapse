<UserControl
    x:Class="OpenSynapse.App.Views.DevicePanels.RazerLaylaPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    xmlns:vm="using:OpenSynapse.App.ViewModels">
  <Border Style="{StaticResource CardStyle}" Padding="16">
    <StackPanel Spacing="12">
      <TextBlock local:Localized.Uid="LaylaTitle" FontSize="18" FontWeight="SemiBold" />
      <TextBlock local:Localized.Uid="LaylaHelp" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
      <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Warning" Message="{Binding ErrorText}" />
      <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding CanEdit}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RazerLaylaMappingRow">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Padding="0,5">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" DisplayMemberPath="Name" SelectedItem="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Name}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
      <Button local:Localized.Uid="RazerHidSaveButton" Click="SaveClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource RazerHidSaveButtonStyle}" HorizontalAlignment="Right" />
    </StackPanel>
  </Border>
</UserControl>
