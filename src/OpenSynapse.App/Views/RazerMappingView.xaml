<UserControl
    x:Class="OpenSynapse.App.Views.RazerMappingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <UserControl.Resources>
    <DataTemplate x:Key="MappingEditorTemplate">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
          <ComboBox local:Localized.Uid="RazerMappingTypeColumn"
                    Header="类型"
                    ItemsSource="{Binding GroupNames}"
                    SelectedIndex="{Binding GroupOptionIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
          <ComboBox Grid.Column="1"
                    local:Localized.Uid="RazerMappingActionColumn"
                    Header="目标动作"
                    ItemsSource="{Binding OptionNames}"
                    SelectedIndex="{Binding OptionIndex, Mode=TwoWay}"
                    Visibility="{Binding OptionVisibility}"
                    IsEnabled="{Binding CanApply}"
                    HorizontalAlignment="Stretch" />
        </Grid>
        <StackPanel Spacing="8">
          <ComboBox local:Localized.Uid="RazerMappingModifierHeader"
                    Header="修饰键"
                    ItemsSource="{Binding ModifierNames}"
                    SelectedIndex="{Binding ModifierIndex, Mode=TwoWay}"
                    Visibility="{Binding ModifierVisibility}"
                    HorizontalAlignment="Stretch" />
          <ComboBox local:Localized.Uid="RazerMappingMacroSlotHeader"
                    Header="宏槽"
                    ItemsSource="{Binding MacroSlotNames}"
                    SelectedIndex="{Binding SelectedMacroSlotIndex, Mode=TwoWay}"
                    Visibility="{Binding MacroSlotVisibility}"
                    HorizontalAlignment="Stretch" />
          <TextBlock local:Localized.Uid="RazerMappingMacroNoFreeSlot"
                     Text="没有空闲宏槽"
                     Visibility="{Binding MacroNoSlotVisibility}"
                     Foreground="{StaticResource WarningBrush}"
                     TextWrapping="Wrap" />
          <ComboBox local:Localized.Uid="RazerMappingPlaybackHeader"
                    Header="播放方式"
                    ItemsSource="{Binding MacroPlaybackOptions}"
                    SelectedIndex="{Binding MacroPlaybackIndex, Mode=TwoWay}"
                    Visibility="{Binding MacroPlaybackVisibility}"
                    HorizontalAlignment="Stretch" />
          <NumberBox local:Localized.Uid="RazerMappingTurboHeader"
                     Header="Turbo 次/秒"
                     Minimum="1"
                     Maximum="50"
                     SmallChange="1"
                     SpinButtonPlacementMode="Inline"
                     Value="{Binding TurboRate, Mode=TwoWay}"
                     Visibility="{Binding TurboRateVisibility}" />
          <NumberBox local:Localized.Uid="RazerMappingProfileIdHeader"
                     Header="配置 ID"
                     Minimum="1"
                     Maximum="5"
                     SmallChange="1"
                     SpinButtonPlacementMode="Inline"
                     Value="{Binding ProfileId, Mode=TwoWay}"
                     Visibility="{Binding ProfileIdVisibility}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding DpiClutchVisibility}">
            <NumberBox local:Localized.Uid="RazerMappingDpiXHeader"
                       Header="DPI X"
                       Minimum="100"
                       Maximum="30000"
                       SmallChange="50"
                       SpinButtonPlacementMode="Inline"
                       Value="{Binding DpiClutchX, Mode=TwoWay}" />
            <NumberBox local:Localized.Uid="RazerMappingDpiYHeader"
                       Header="DPI Y"
                       Minimum="100"
                       Maximum="30000"
                       SmallChange="50"
                       SpinButtonPlacementMode="Inline"
                       Value="{Binding DpiClutchY, Mode=TwoWay}" />
          </StackPanel>
          <NumberBox local:Localized.Uid="RazerMappingMacroRepeatHeader"
                     Header="宏次数"
                     Minimum="1"
                     Maximum="255"
                     SmallChange="1"
                     SpinButtonPlacementMode="Inline"
                     Value="{Binding MacroRepeatCount, Mode=TwoWay}"
                     Visibility="{Binding MacroRepeatVisibility}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="LeftCalloutTemplate">
      <Button Click="CalloutClick"
              Background="Transparent"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12,8"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Right"
              AutomationProperties.Name="{Binding ButtonName}">
        <StackPanel Spacing="2" HorizontalAlignment="Right">
          <TextBlock Text="{Binding ButtonName}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CurrentActionText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Right" TextWrapping="Wrap" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="RightCalloutTemplate">
      <Button Click="CalloutClick"
              Background="Transparent"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12,8"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              AutomationProperties.Name="{Binding ButtonName}">
        <StackPanel Spacing="2" HorizontalAlignment="Left">
          <TextBlock Text="{Binding ButtonName}" FontSize="13" FontWeight="SemiBold" TextAlignment="Left" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CurrentActionText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel x:Name="MappingRoot" Spacing="14">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="3">
        <TextBlock local:Localized.Uid="RazerMappingTitle" Text="按键映射" FontSize="19" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" local:Localized.Uid="RazerMappingRead" Content="读取" Click="ReadClick" IsEnabled="{Binding CanRead}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
      <Button Grid.Column="2" local:Localized.Uid="RazerMappingSave" Content="保存" Click="ApplyClick" IsEnabled="{Binding CanApply}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
    </Grid>

    <RadioButtons ItemsSource="{Binding LayerNames}" SelectedIndex="{Binding LayerIndex, Mode=TwoWay}" MaxColumns="2" AutomationProperties.Name="映射层" />

    <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Warning" Message="{Binding ErrorText}" />

    <Grid x:Name="MappingStage"
          Visibility="{Binding StageVisibility}"
          ColumnDefinitions="220,360,220"
          ColumnSpacing="18"
          MinHeight="500"
          HorizontalAlignment="Center">
      <ItemsControl x:Name="LeftCalloutControl"
                    Grid.Column="0"
                    ItemsSource="{Binding LeftRows}"
                    ItemTemplate="{StaticResource LeftCalloutTemplate}"
                    VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Border Grid.Column="1"
              Width="360"
              Height="500"
              Padding="10"
              CornerRadius="12"
              Background="Transparent"
              VerticalAlignment="Center">
        <Image x:Name="DeviceImage"
               Width="330"
               Height="460"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               AutomationProperties.Name="设备图"
               Source="{Binding LayoutImage}" />
      </Border>

      <ItemsControl x:Name="RightCalloutControl"
                    Grid.Column="2"
                    ItemsSource="{Binding RightRows}"
                    ItemTemplate="{StaticResource RightCalloutTemplate}"
                    VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Canvas x:Name="ConnectorCanvas"
              Grid.ColumnSpan="3"
              IsHitTestVisible="False"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" />
    </Grid>

    <StackPanel Spacing="8" Visibility="{Binding KeyboardStageVisibility}">
      <Viewbox Stretch="Uniform" MaxHeight="420" HorizontalAlignment="Center">
        <Canvas x:Name="KeyboardCanvas"
                Width="{Binding KeyboardWidth}"
                Height="{Binding KeyboardHeight}"
                Background="Transparent" />
      </Viewbox>
      <TextBlock local:Localized.Uid="RazerMappingKeyboardHint"
                 Text="点击键位编辑映射"
                 Foreground="{StaticResource MutedBrush}"
                 HorizontalAlignment="Center" />
    </StackPanel>

    <TextBlock local:Localized.Uid="RazerMappingCalloutHint"
               Text="点击设备旁的按键标签编辑映射"
               Foreground="{StaticResource MutedBrush}"
               HorizontalAlignment="Center"
               Visibility="{Binding StageVisibility}" />

    <Border Visibility="{Binding EditorVisibility}"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding SelectedButtonName}" FontSize="17" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedRow.CurrentActionText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Content="✕" Click="CloseEditorClick" AutomationProperties.Name="关闭" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" />
        </Grid>
        <ContentControl Content="{Binding SelectedRow}" ContentTemplate="{StaticResource MappingEditorTemplate}" />
      </StackPanel>
    </Border>

    <Grid Visibility="{Binding TableVisibility}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="110,1.2*,150,1.3*,*" ColumnSpacing="10">
          <TextBlock local:Localized.Uid="RazerMappingButtonColumn" Text="按键" Style="{StaticResource MetricLabelStyle}" />
          <TextBlock Grid.Column="1" local:Localized.Uid="RazerMappingCurrentColumn" Text="当前动作" Style="{StaticResource MetricLabelStyle}" />
          <TextBlock Grid.Column="2" local:Localized.Uid="RazerMappingTypeColumn" Text="类型" Style="{StaticResource MetricLabelStyle}" />
          <TextBlock Grid.Column="3" local:Localized.Uid="RazerMappingActionColumn" Text="目标动作" Style="{StaticResource MetricLabelStyle}" />
          <TextBlock Grid.Column="4" local:Localized.Uid="RazerMappingParameterColumn" Text="参数" Style="{StaticResource MetricLabelStyle}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="110,1.2*,150,1.3*,*" ColumnSpacing="10" MinHeight="40" Padding="0,4">
                <TextBlock Text="{Binding ButtonName}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentActionText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding GroupNames}" SelectedIndex="{Binding GroupOptionIndex, Mode=TwoWay}" AutomationProperties.Name="目标映射类型" HorizontalAlignment="Stretch" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding OptionNames}" SelectedIndex="{Binding OptionIndex, Mode=TwoWay}" Visibility="{Binding OptionVisibility}" IsEnabled="{Binding CanApply}" AutomationProperties.Name="目标映射动作" HorizontalAlignment="Stretch" />
                <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center">
                  <ComboBox ItemsSource="{Binding ModifierNames}" SelectedIndex="{Binding ModifierIndex, Mode=TwoWay}" Visibility="{Binding ModifierVisibility}" AutomationProperties.Name="键盘修饰键" HorizontalAlignment="Stretch" />
                  <ComboBox ItemsSource="{Binding MacroSlotNames}" SelectedIndex="{Binding SelectedMacroSlotIndex, Mode=TwoWay}" Visibility="{Binding MacroSlotVisibility}" AutomationProperties.Name="宏槽" HorizontalAlignment="Stretch" />
                  <TextBlock local:Localized.Uid="RazerMappingMacroNoFreeSlot" Text="没有空闲宏槽" Visibility="{Binding MacroNoSlotVisibility}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                  <ComboBox ItemsSource="{Binding MacroPlaybackOptions}" SelectedIndex="{Binding MacroPlaybackIndex, Mode=TwoWay}" Visibility="{Binding MacroPlaybackVisibility}" AutomationProperties.Name="宏播放方式" HorizontalAlignment="Stretch" />
                  <NumberBox local:Localized.Uid="RazerMappingTurboHeader" Header="Turbo 次/秒" Minimum="1" Maximum="50" SmallChange="1" SpinButtonPlacementMode="Inline" Value="{Binding TurboRate, Mode=TwoWay}" Visibility="{Binding TurboRateVisibility}" />
                  <NumberBox local:Localized.Uid="RazerMappingProfileIdHeader" Header="配置 ID" Minimum="1" Maximum="5" SmallChange="1" SpinButtonPlacementMode="Inline" Value="{Binding ProfileId, Mode=TwoWay}" Visibility="{Binding ProfileIdVisibility}" />
                  <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding DpiClutchVisibility}">
                    <NumberBox local:Localized.Uid="RazerMappingDpiXHeader" Header="DPI X" Minimum="100" Maximum="30000" SmallChange="50" SpinButtonPlacementMode="Inline" Value="{Binding DpiClutchX, Mode=TwoWay}" />
                    <NumberBox local:Localized.Uid="RazerMappingDpiYHeader" Header="DPI Y" Minimum="100" Maximum="30000" SmallChange="50" SpinButtonPlacementMode="Inline" Value="{Binding DpiClutchY, Mode=TwoWay}" />
                  </StackPanel>
                  <NumberBox local:Localized.Uid="RazerMappingMacroRepeatHeader" Header="宏次数" Minimum="1" Maximum="255" SmallChange="1" SpinButtonPlacementMode="Inline" Value="{Binding MacroRepeatCount, Mode=TwoWay}" Visibility="{Binding MacroRepeatVisibility}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>