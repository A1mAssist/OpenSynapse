<UserControl
    x:Class="OpenSynapse.App.Views.LightingStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:OpenSynapse.App"
    xmlns:views="using:OpenSynapse.App.Views"
    mc:Ignorable="d"
    x:Name="Root">

  <UserControl.KeyboardAccelerators>
    <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAcceleratorInvoked" />
    <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="RedoAcceleratorInvoked" />
    <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoAcceleratorInvoked" />
    <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="DuplicateAcceleratorInvoked" />
    <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="RenameAcceleratorInvoked" />
    <KeyboardAccelerator Key="Delete" Invoked="DeleteAcceleratorInvoked" />
    <KeyboardAccelerator Key="Back" Invoked="DeleteAcceleratorInvoked" />
    <KeyboardAccelerator Key="P" Invoked="PenAcceleratorInvoked" />
    <KeyboardAccelerator Key="B" Invoked="BucketAcceleratorInvoked" />
  </UserControl.KeyboardAccelerators>

  <UserControl.Resources>
    <views:StudioEffectLabelConverter x:Key="StudioEffectLabelConverter" />
    <views:StudioRgbBrushConverter x:Key="StudioRgbBrushConverter" />
    <views:StudioDepthConverter x:Key="StudioDepthConverter" />
  </UserControl.Resources>

  <Grid Padding="24" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock local:Localized.Uid="LightingStudioTitle" Text="灯光工作室"
                   FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" />
        <TextBlock local:Localized.Uid="LightingStudioSubtitle"
                   Text="图层、区域与效果实时预览，支持多设备矩阵输出和 Chroma 文件导入导出。"
                   FontSize="13" Foreground="{StaticResource MutedBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="PlayButton" Click="TogglePlayClick" MinWidth="104"
                Style="{StaticResource SecondaryButtonStyle}"
                AutomationProperties.AutomationId="StudioPlayButton">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon x:Name="PlayButtonIcon" Glyph="&#xE102;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
            <TextBlock x:Name="PlayButtonLabel" local:Localized.Uid="LightingStudioPlay" Text="播放" />
          </StackPanel>
        </Button>
        <Button x:Name="ApplyButton" Click="ApplyClick" MinWidth="140" IsEnabled="{Binding CanApply}"
                Style="{StaticResource PrimaryButtonStyle}"
                AutomationProperties.AutomationId="StudioApplyButton">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE10B;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
            <TextBlock local:Localized.Uid="LightingStudioApply" Text="应用到设备" />
          </StackPanel>
        </Button>
        <Button x:Name="StopButton" Click="StopClick" MinWidth="92"
                Style="{StaticResource SecondaryButtonStyle}"
                AutomationProperties.AutomationId="StudioStopButton">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE15B;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
            <TextBlock local:Localized.Uid="LightingStudioStop" Text="停止" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left rail: project settings stay tucked away; the editing surface gets the room. -->
      <Grid RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
          <Expander x:Name="ProjectExpander" IsExpanded="False" HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="StudioProjectExpander">
            <Expander.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE188;" FontFamily="{StaticResource IconFontFamily}"
                          FontSize="14" Foreground="{StaticResource MutedBrush}" />
                <TextBlock local:Localized.Uid="LightingStudioProject" Text="项目" />
              </StackPanel>
            </Expander.Header>
            <StackPanel Spacing="8">
              <TextBlock local:Localized.Uid="LightingStudioProfileLabel" Text="配置档"
                         FontSize="11" Foreground="{StaticResource MutedBrush}" />
              <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Title"
                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
                <DropDownButton Grid.Column="1" local:Localized.Uid="LightingStudioMore"
                                Content="更多" Padding="8,0"
                                AutomationProperties.AutomationId="StudioProfileMenu">
                  <DropDownButton.Flyout>
                    <MenuFlyout>
                      <MenuFlyoutItem local:Localized.Uid="LightingStudioAdd" Text="新增"
                                      Click="AddProfileClick" />
                      <MenuFlyoutItem local:Localized.Uid="LightingStudioDuplicate" Text="复制"
                                      Click="DuplicateProfileClick" />
                      <MenuFlyoutItem local:Localized.Uid="LightingStudioRemove" Text="删除"
                                      Click="RemoveProfileClick" />
                    </MenuFlyout>
                  </DropDownButton.Flyout>
                </DropDownButton>
              </Grid>
              <TextBlock local:Localized.Uid="LightingStudioProfileTitle" Text="配置档名称"
                         FontSize="11" Foreground="{StaticResource MutedBrush}" />
              <TextBox Text="{Binding SelectedProfile.Title, Mode=TwoWay}"
                       LostFocus="NameBoxLostFocus" FontSize="12" />
              <TextBlock local:Localized.Uid="LightingStudioNameLabel" Text="工作室名称"
                         FontSize="11" Foreground="{StaticResource MutedBrush}" />
              <TextBox Text="{Binding DocumentName, Mode=TwoWay}" FontSize="12" />
            </StackPanel>
          </Expander>

          <TextBlock local:Localized.Uid="LightingStudioDeviceLabel" Text="设备"
                     FontSize="11" Foreground="{StaticResource MutedBrush}" />
          <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name"
                    AutomationProperties.AutomationId="StudioDeviceSelector"
                    SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
          <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="10">
            <Grid ColumnSpacing="12" Height="68">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="84" Height="68">
                <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="8" />
                <Image Source="{Binding SelectedDevice.Image}" Stretch="Uniform" Margin="6"
                       Visibility="{Binding SelectedDevice.ImageVisibility}" />
                <views:StudioDeviceGlyph Visual="{Binding DeviceVisual}" Margin="6"
                                        Visibility="{Binding SelectedDevice.FallbackVisibility}" />
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding SelectedDevice.Name}" FontWeight="SemiBold"
                           Foreground="{StaticResource DataBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SelectedDevice.MatrixLabel}" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <Grid Grid.Row="1" RowSpacing="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock local:Localized.Uid="LightingStudioLayers" Text="图层"
                     FontSize="11" Foreground="{StaticResource MutedBrush}" />
          <ListView x:Name="LayerList" Grid.Row="1" ItemsSource="{Binding LayerRows}"
                    SelectedItem="{Binding SelectedLayerRow, Mode=TwoWay}"
                    SelectionMode="Single" BorderThickness="0" Background="Transparent"
                    CanDragItems="True" CanReorderItems="False" AllowDrop="True"
                    DragItemsStarting="LayerDragStarting"
                    DragItemsCompleted="LayerDragCompleted">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Border Tag="RowDropHint" BorderThickness="1" CornerRadius="4">
                  <Grid ColumnSpacing="8" Margin="{Binding Depth, Converter={StaticResource StudioDepthConverter}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                            Background="{Binding Layer.PrimaryColor, Converter={StaticResource StudioRgbBrushConverter}}" />
                    <StackPanel Grid.Column="1" Spacing="1" Padding="0,2">
                      <TextBlock Text="{Binding Layer.Title}" FontSize="13" Foreground="{StaticResource DataBrush}" />
                      <TextBlock Text="{Binding Layer.Effect, Converter={StaticResource StudioEffectLabelConverter}}"
                                 FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <Grid Grid.Row="2" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AddLayerButton" Click="AddLayerClick" HorizontalAlignment="Stretch"
                    Padding="4,0" MinHeight="34" AutomationProperties.AutomationId="StudioAddLayer">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE109;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                <TextBlock local:Localized.Uid="LightingStudioAdd" Text="新增" />
              </StackPanel>
            </Button>
            <Button x:Name="DuplicateLayerButton" Grid.Column="1" Click="DuplicateLayerClick"
                    HorizontalAlignment="Stretch" Padding="4,0" MinHeight="34"
                    AutomationProperties.AutomationId="StudioDuplicateLayer">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE16F;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                <TextBlock local:Localized.Uid="LightingStudioDuplicate" Text="复制" />
              </StackPanel>
            </Button>
            <Button x:Name="RemoveLayerButton" Grid.Column="2" Click="RemoveLayerClick"
                    HorizontalAlignment="Stretch" Padding="4,0" MinHeight="34"
                    IsEnabled="{Binding CanRemoveLayer}" AutomationProperties.AutomationId="StudioRemoveLayer">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE107;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                <TextBlock local:Localized.Uid="LightingStudioRemove" Text="删除" />
              </StackPanel>
            </Button>
            <Button x:Name="GroupLayerButton" Grid.Column="3" HorizontalAlignment="Stretch"
                    Padding="4,0" MinHeight="34" AutomationProperties.AutomationId="StudioGroupMenu">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE188;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                <TextBlock local:Localized.Uid="LightingStudioGroup" Text="分组" />
              </StackPanel>
              <Button.Flyout>
                <Flyout>
                  <StackPanel Width="220" Spacing="8">
                    <Button local:Localized.Uid="LightingStudioAddGroup" Content="组"
                            Click="AddGroupClick" HorizontalAlignment="Stretch" />
                    <ComboBox ItemsSource="{Binding GroupChoices}" DisplayMemberPath="Title"
                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />
                    <Grid ColumnSpacing="6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Button local:Localized.Uid="LightingStudioMoveIntoGroup" Content="入组"
                              Click="MoveIntoGroupClick" HorizontalAlignment="Stretch" />
                      <Button Grid.Column="1" local:Localized.Uid="LightingStudioMoveToRoot" Content="出组"
                              Click="MoveToRootClick" HorizontalAlignment="Stretch" />
                    </Grid>
                    <Grid ColumnSpacing="6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Button local:Localized.Uid="LightingStudioMoveUp" Content="上移"
                              Click="MoveUpClick" HorizontalAlignment="Stretch" />
                      <Button Grid.Column="1" local:Localized.Uid="LightingStudioMoveDown" Content="下移"
                              Click="MoveDownClick" HorizontalAlignment="Stretch" />
                    </Grid>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <DropDownButton x:Name="DocumentMenuButton" HorizontalAlignment="Stretch" Padding="8,0"
                          AutomationProperties.AutomationId="StudioDocumentMenu">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <FontIcon Glyph="&#xE130;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
              <TextBlock local:Localized.Uid="LightingStudioDocument" Text="文档" />
            </StackPanel>
            <DropDownButton.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem local:Localized.Uid="LightingStudioNew" Text="新建" Click="NewClick" />
                <MenuFlyoutItem local:Localized.Uid="LightingStudioLoad" Text="载入" Click="LoadClick" />
                <MenuFlyoutItem local:Localized.Uid="LightingStudioSave" Text="保存" Click="SaveClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem local:Localized.Uid="LightingStudioImport" Text="导入" Click="ImportChromaClick" />
                <MenuFlyoutItem local:Localized.Uid="LightingStudioExport" Text="导出" Click="ExportChromaClick" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button x:Name="UndoButton" Grid.Column="1" Click="UndoClick"
                  IsEnabled="{Binding CanUndo}" Width="34" Height="34" MinWidth="34" MinHeight="34"
                  Padding="0" Style="{StaticResource IconButtonStyle}"
                  AutomationProperties.AutomationId="StudioUndo">
            <FontIcon Glyph="&#xE10E;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" />
          </Button>
          <Button x:Name="RedoButton" Grid.Column="2" Click="RedoClick"
                  IsEnabled="{Binding CanRedo}" Width="34" Height="34" MinWidth="34" MinHeight="34"
                  Padding="0" Style="{StaticResource IconButtonStyle}"
                  AutomationProperties.AutomationId="StudioRedo">
            <FontIcon Glyph="&#xE10D;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" />
          </Button>
        </Grid>
      </Grid>

      <!-- Right: the canvas gets the width freed by the inspector dock below. -->
      <Grid Grid.Column="1" RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Padding="14,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ToolPicker" SelectedIndex="0" Width="124"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="StudioToolPicker"
                          SelectionChanged="ToolChanged">
                  <ComboBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE1E3;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                      <TextBlock local:Localized.Uid="LightingStudioToolSelect" Text="选择" />
                    </StackPanel>
                  </ComboBoxItem>
                  <ComboBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE104;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                      <TextBlock local:Localized.Uid="LightingStudioToolPen" Text="画笔" />
                    </StackPanel>
                  </ComboBoxItem>
                  <ComboBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE186;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                      <TextBlock local:Localized.Uid="LightingStudioToolBucket" Text="油漆桶" />
                    </StackPanel>
                  </ComboBoxItem>
                  <ComboBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE14F;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                      <TextBlock local:Localized.Uid="LightingStudioToolMove" Text="移动" />
                    </StackPanel>
                  </ComboBoxItem>
                </ComboBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="ZoomOutButton" Click="ZoomOutClick"
                          Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0"
                          Style="{StaticResource IconButtonStyle}"
                          AutomationProperties.AutomationId="StudioZoomOut">
                    <FontIcon Glyph="&#xE1A4;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                  </Button>
                  <ComboBox x:Name="ZoomPicker" SelectedIndex="3" MinWidth="100"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="StudioZoomPicker"
                            SelectionChanged="ZoomStepChanged">
                    <ComboBoxItem Content="10%" />
                    <ComboBoxItem Content="25%" />
                    <ComboBoxItem Content="50%" />
                    <ComboBoxItem Content="100%" />
                    <ComboBoxItem Content="200%" />
                    <ComboBoxItem Content="300%" />
                    <ComboBoxItem Content="400%" />
                  </ComboBox>
                  <Button x:Name="ZoomInButton" Click="ZoomInClick"
                          Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0"
                          Style="{StaticResource IconButtonStyle}"
                          AutomationProperties.AutomationId="StudioZoomIn">
                    <FontIcon Glyph="&#xE12E;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                  </Button>
                  <Border Width="1" Height="22" Margin="8,0" Background="{StaticResource LineBrush}" />
                  <Button x:Name="RotateDeviceButton" Click="RotateDeviceClick"
                          Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0"
                          Style="{StaticResource IconButtonStyle}"
                          AutomationProperties.AutomationId="RotateDeviceButton">
                    <FontIcon Glyph="&#xE14A;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                  </Button>
                  <Border Width="1" Height="22" Margin="8,0" Background="{StaticResource LineBrush}" />
                  <Button x:Name="InspectorToggleButton" Click="ToggleInspectorClick"
                          MinHeight="32" Padding="10,0"
                          Style="{StaticResource SecondaryButtonStyle}"
                          AutomationProperties.AutomationId="StudioInspectorToggle">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <FontIcon Glyph="&#xE138;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                      <TextBlock local:Localized.Uid="LightingStudioLayerProperties" Text="图层属性" />
                      <FontIcon x:Name="InspectorChevron" Glyph="&#xE70E;"
                                FontFamily="{StaticResource IconFontFamily}" FontSize="10" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="14,10,14,0">
              <views:StudioCanvas x:Name="DeviceCanvas" AutomationProperties.AutomationId="StudioCanvas"
                                  Visibility="Collapsed" />
              <Viewbox x:Name="FallbackPreview" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas x:Name="PreviewCanvas" Width="448" Height="196" />
              </Viewbox>
            </Grid>
            <Grid Grid.Row="2" Padding="14,8,14,14" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock local:Localized.Uid="LightingStudioDeviceNoPixelOutput"
                           Text="无逐像素输出。此设备无法接收工作室帧，画布仅供预览，应用时会跳过。"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource AccentBrush}"
                           Visibility="{Binding NoPixelOutputVisibility}" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                           FontSize="12" Foreground="{StaticResource MutedBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center">
                <Button x:Name="SelectAllButton" Click="SelectAllClick"
                        AutomationProperties.AutomationId="StudioSelectAll">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE14E;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" />
                    <TextBlock local:Localized.Uid="LightingStudioSelectAll" Text="全选" />
                  </StackPanel>
                </Button>
                <Button x:Name="ApplySelectionButton" Click="ApplySelectionClick"
                        AutomationProperties.AutomationId="StudioApplySelection">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE10B;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" />
                    <TextBlock local:Localized.Uid="LightingStudioApplySelection" Text="应用选区" />
                  </StackPanel>
                </Button>
                <Button x:Name="ClearSelectionButton" Click="ClearSelectionClick"
                        AutomationProperties.AutomationId="StudioClearSelection">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE1C5;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" />
                    <TextBlock local:Localized.Uid="LightingStudioClearSelection" Text="清除选区" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <Border x:Name="InspectorPanel" Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                CornerRadius="12" Padding="14,12" AutomationProperties.AutomationId="StudioInspectorPanel">
          <Grid RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE138;" FontFamily="{StaticResource IconFontFamily}"
                          FontSize="16" Foreground="{StaticResource AccentBrush}"
                          VerticalAlignment="Center" />
                <TextBlock local:Localized.Uid="LightingStudioLayerProperties" Text="图层属性"
                           FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <CheckBox Grid.Column="1" local:Localized.Uid="LightingStudioEnabled" Content="启用"
                        IsChecked="{Binding SelectedLayer.Visible, Mode=TwoWay}"
                        VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1" Height="172" ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
              </Grid.ColumnDefinitions>
              <Grid RowSpacing="6" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="3">
                  <TextBlock local:Localized.Uid="LightingStudioLayerNameLabel" Text="名称"
                             FontSize="11" Foreground="{StaticResource MutedBrush}" />
                  <TextBox x:Name="LayerNameBox" Text="{Binding SelectedLayer.Title, Mode=TwoWay}"
                           LostFocus="NameBoxLostFocus" MinHeight="30" Padding="8,3" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock local:Localized.Uid="LightingStudioRegionLabel" Text="区域"
                             FontSize="11" Foreground="{StaticResource MutedBrush}" />
                  <ComboBox ItemsSource="{Binding RegionChoices}" DisplayMemberPath="Label"
                            SelectedItem="{Binding SelectedRegionChoice, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" MinHeight="30" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="3">
                  <TextBlock local:Localized.Uid="LightingStudioEffect" Text="效果"
                             FontSize="11" Foreground="{StaticResource MutedBrush}" />
                  <ComboBox AutomationProperties.AutomationId="StudioEffectComboBox"
                            ItemsSource="{Binding EffectChoices}" DisplayMemberPath="Label"
                            SelectedItem="{Binding SelectedEffectChoice, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" MinHeight="30" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                  <TextBlock local:Localized.Uid="LightingStudioBlend" Text="混合"
                             FontSize="11" Foreground="{StaticResource MutedBrush}" />
                  <ComboBox ItemsSource="{Binding BlendChoices}" DisplayMemberPath="Label"
                            SelectedItem="{Binding SelectedBlendChoice, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" MinHeight="30" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2">
                  <TextBlock local:Localized.Uid="LightingStudioOpacity" Text="不透明度"
                             FontSize="11" Foreground="{StaticResource MutedBrush}" />
                  <Slider Minimum="0" Maximum="100" StepFrequency="1"
                          Value="{Binding SelectedLayer.Opacity, Mode=TwoWay}"
                          ValueChanged="InspectorValueChanged" Height="28" />
                </StackPanel>
              </Grid>
              <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
                <views:StudioEffectInspector x:Name="Inspector" />
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
