<UserControl
    x:Class="OpenSynapse.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    xmlns:controls="using:OpenSynapse.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <ScrollViewer x:Name="PageScrollViewer" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
              <StackPanel Padding="24,24,24,48" Spacing="16" MinWidth="640">
                <StackPanel Spacing="5">
                  <TextBlock local:Localized.Uid="SettingsPageTitle" Style="{StaticResource PageTitleStyle}" />
                  <TextBlock local:Localized.Uid="SettingsPageDescription" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="16">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4"><TextBlock local:Localized.Uid="Loc_C6BFF9FFC0" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><TextBlock local:Localized.Uid="Loc_6048E58A89" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                      <ToggleSwitch local:Localized.Uid="StartupToggle" Grid.Column="1" IsOn="{Binding Profiles.IsStartupEnabled, Mode=OneWay}" Toggled="StartupToggled" IsEnabled="{Binding Profiles.CanSetStartup}" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4"><TextBlock local:Localized.Uid="Loc_4ED618F72C" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><TextBlock local:Localized.Uid="Loc_E40B74CC08" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                      <ToggleSwitch local:Localized.Uid="SilentStartupToggle" Grid.Column="1" IsOn="{Binding Profiles.IsSilentStartupEnabled, Mode=OneWay}" Toggled="SilentStartupToggled" IsEnabled="{Binding Profiles.CanSetSilentStartup}" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border x:Name="LiteModeCard" Style="{StaticResource CardStyle}" Padding="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock local:Localized.Uid="LiteModeTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                      <TextBlock local:Localized.Uid="LiteModeDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch local:Localized.Uid="LiteModeToggle" x:Name="LiteModeToggle" Grid.Column="1" Toggled="LiteModeToggled" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border x:Name="AdvancedFeaturesCard" Style="{StaticResource CardStyle}" Padding="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock local:Localized.Uid="AdvancedFeaturesTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel>
                      <TextBlock local:Localized.Uid="AdvancedFeaturesSettingDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch local:Localized.Uid="A11yEnableAdvancedFeatures" x:Name="AdvancedFeaturesToggle" Grid.Column="1" Toggled="AdvancedFeaturesToggled" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border x:Name="ModeNotificationCard" Style="{StaticResource CardStyle}" Padding="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock local:Localized.Uid="ModeNotificationTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                      <TextBlock local:Localized.Uid="ModeNotificationDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch local:Localized.Uid="ModeNotificationToggle" x:Name="ModeNotificationToggle" Grid.Column="1" Toggled="ModeNotificationToggled" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock local:Localized.Uid="LowBatteryNotificationTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                      <TextBlock local:Localized.Uid="LowBatteryNotificationDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch local:Localized.Uid="LowBatteryNotificationToggle" x:Name="LowBatteryNotificationToggle" Grid.Column="1" Toggled="LowBatteryNotificationToggled" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock local:Localized.Uid="TrayBatteryTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                      <TextBlock local:Localized.Uid="TrayBatteryDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch local:Localized.Uid="TrayBatteryToggle" x:Name="TrayBatteryToggle" Grid.Column="1" Toggled="TrayBatteryToggled" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border x:Name="TaskbarStatusCard" Style="{StaticResource CardStyle}" Padding="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock local:Localized.Uid="TaskbarStatusTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                      <TextBlock local:Localized.Uid="TaskbarStatusDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch local:Localized.Uid="TaskbarStatusToggle" x:Name="TaskbarStatusToggle" Grid.Column="1" Toggled="TaskbarStatusToggled" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border x:Name="PerformanceOverlayCard" Style="{StaticResource CardStyle}" Padding="16">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4">
                        <TextBlock local:Localized.Uid="PerformanceOverlayTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                        <TextBlock local:Localized.Uid="PerformanceOverlayDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleSwitch local:Localized.Uid="PerformanceOverlayToggle" x:Name="PerformanceOverlayToggle" Grid.Column="1" Toggled="PerformanceOverlayToggled" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4">
                        <TextBlock local:Localized.Uid="PerformanceOverlayTopmostTitle" FontSize="16" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                        <TextBlock local:Localized.Uid="PerformanceOverlayTopmostDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleSwitch local:Localized.Uid="PerformanceOverlayTopmostToggle" x:Name="PerformanceOverlayTopmostToggle" Grid.Column="1" Toggled="PerformanceOverlayTopmostToggled" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4">
                        <TextBlock local:Localized.Uid="PerformanceOverlayDetailedTitle" FontSize="16" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                        <TextBlock local:Localized.Uid="PerformanceOverlayDetailedDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleSwitch local:Localized.Uid="PerformanceOverlayDetailedToggle" x:Name="PerformanceOverlayDetailedToggle" Grid.Column="1" Toggled="PerformanceOverlayDetailedToggled" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border x:Name="ChromaRestCard" Style="{StaticResource CardStyle}" Padding="16">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4">
                        <TextBlock local:Localized.Uid="ChromaRestTitle" Text="Chroma integration" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                        <TextBlock local:Localized.Uid="ChromaRestDescription" Text="Allow compatible REST and SDK clients to control connected lighting locally. The SDK shim does not require Razer Synapse." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleSwitch local:Localized.Uid="ChromaRestToggle" x:Name="ChromaRestToggle" Grid.Column="1" Toggled="ChromaRestToggled" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" AutomationProperties.Name="Chroma integration" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4">
                        <TextBlock local:Localized.Uid="ChromaRestoreTitle" Text="Restore lighting after external control" FontSize="16" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                        <TextBlock local:Localized.Uid="ChromaRestoreDescription" Text="Return to the OpenSynapse effect after the session ends or times out." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleSwitch local:Localized.Uid="ChromaRestoreToggle" x:Name="ChromaRestoreToggle" Grid.Column="1" Toggled="ChromaRestoreToggled" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" AutomationProperties.Name="Restore lighting after external control" />
                    </Grid>
                    <TextBlock local:Localized.Uid="ChromaRestStatus" x:Name="ChromaRestStatusText" Text="Disabled" FontFamily="Cascadia Mono,Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4">
                        <TextBlock local:Localized.Uid="ChromaOfficialDllTitle" FontSize="16" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                        <TextBlock local:Localized.Uid="ChromaOfficialDllDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ChromaOfficialDllStatusText" Text="" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                      </StackPanel>
                      <Button local:Localized.Uid="ChromaOfficialDllDownload" x:Name="ChromaOfficialDllButton" Grid.Column="1" Click="ChromaOfficialDllClick" Style="{StaticResource SecondaryButtonStyle}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="ChromaSourceSection" Spacing="10">
                      <Border Height="1" Background="{StaticResource LineBrush}" />
                      <TextBlock local:Localized.Uid="ChromaSourcesTitle" Text="Chroma sources" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" FontSize="16" />
                      <TextBlock local:Localized.Uid="ChromaSourcesDescription" Text="Allow or block lighting control by source name. Names are reported by clients, not verified identities." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      <TextBlock local:Localized.Uid="ChromaSourcesEmpty" x:Name="ChromaSourcesEmptyText" Text="Sources appear here when a game or integration connects." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      <StackPanel x:Name="ChromaSourcesPanel" Spacing="12" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock local:Localized.Uid="HueTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                      <TextBlock local:Localized.Uid="HueDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button local:Localized.Uid="HueConfigureButton" Grid.Column="1" Click="HueSettingsClick" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16">
                  <Grid ColumnDefinitions="*,220" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock local:Localized.Uid="Loc_69C8D0D8B7" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                      <TextBlock local:Localized.Uid="Loc_7F211E0B63" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox local:Localized.Uid="Loc_C3B65B0A4F" x:Name="AppLanguageComboBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="LanguageSelectionChanged">
                      <ComboBoxItem local:Localized.Uid="Loc_6E1BBAA0E8" Tag="system" />
                      <ComboBoxItem local:Localized.Uid="Loc_5C8A32D3B1" Tag="zh-CN" />
                      <ComboBoxItem local:Localized.Uid="Loc_F08B7A510E" Content="English" Tag="en-US" />
                    </ComboBox>
                  </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4">
                        <TextBlock local:Localized.Uid="UpdateTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                        <TextBlock local:Localized.Uid="UpdateDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleSwitch local:Localized.Uid="AutomaticUpdatesToggle" x:Name="AutomaticUpdatesToggle" Grid.Column="1" Toggled="AutomaticUpdatesToggled" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateStatusText" local:Localized.Uid="UpdateStatusLoading" TextWrapping="Wrap" />
                        <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Height="3" Visibility="Collapsed" />
                      </StackPanel>
                      <Button local:Localized.Uid="CheckUpdateButton" x:Name="CheckUpdateButton" Grid.Column="1" Click="CheckForUpdatesClick" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                      <Button x:Name="UpdateActionButton" local:Localized.Uid="UpdateDownloadButton" Grid.Column="2" Click="UpdateActionClick" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Button local:Localized.Uid="Loc_79D0601598" Click="ShowIntroductionClick" Style="{StaticResource QuickActionButtonStyle}" MinHeight="96" Padding="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid>
                    <StackPanel Spacing="4">
                      <TextBlock local:Localized.Uid="SettingsGuideTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                      <TextBlock local:Localized.Uid="SettingsGuideDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button local:Localized.Uid="SettingsAboutButton" Click="OpenAboutClick" Style="{StaticResource QuickActionButtonStyle}" MinHeight="96" Padding="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock local:Localized.Uid="SettingsAboutTitle" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                      <TextBlock local:Localized.Uid="SettingsAboutDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Button>
              </StackPanel>
  </ScrollViewer>
</UserControl>
