<UserControl
    x:Class="OpenSynapse.App.Views.HelpArticleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenSynapse.App.Controls.Help"
    xmlns:help="using:OpenSynapse.App.Help"
    AutomationProperties.AutomationId="HelpArticleView">
  <UserControl.Resources>
    <DataTemplate x:Key="DpiStagesTemplate">
      <controls:HelpSpecimenHost>
        <controls:HelpSpecimenHost.SpecimenContent>
          <controls:DpiStageSpecimen />
        </controls:HelpSpecimenHost.SpecimenContent>
      </controls:HelpSpecimenHost>
    </DataTemplate>
    <DataTemplate x:Key="SceneCardTemplate">
      <controls:HelpSpecimenHost>
        <controls:HelpSpecimenHost.SpecimenContent>
          <controls:SceneCardSpecimen />
        </controls:HelpSpecimenHost.SpecimenContent>
      </controls:HelpSpecimenHost>
    </DataTemplate>
    <DataTemplate x:Key="ApplyScopeTemplate">
      <controls:HelpSpecimenHost>
        <controls:HelpSpecimenHost.SpecimenContent>
          <controls:ScopeSelectorSpecimen />
        </controls:HelpSpecimenHost.SpecimenContent>
      </controls:HelpSpecimenHost>
    </DataTemplate>
    <DataTemplate x:Key="MacroStepTemplate">
      <controls:HelpSpecimenHost>
        <controls:HelpSpecimenHost.SpecimenContent>
          <controls:MacroStepSpecimen />
        </controls:HelpSpecimenHost.SpecimenContent>
      </controls:HelpSpecimenHost>
    </DataTemplate>
    <DataTemplate x:Key="KeyBindingTemplate">
      <controls:HelpSpecimenHost>
        <controls:HelpSpecimenHost.SpecimenContent>
          <controls:KeyBindingSpecimen />
        </controls:HelpSpecimenHost.SpecimenContent>
      </controls:HelpSpecimenHost>
    </DataTemplate>

    <DataTemplate x:Key="ParagraphTemplate">
      <TextBlock Text="{Binding Text}"
                 FontSize="14"
                 LineHeight="22"
                 Foreground="{StaticResource DataBrush}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10" />
    </DataTemplate>
    <DataTemplate x:Key="StepsTemplate">
      <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="28,*" ColumnSpacing="10" Margin="0,0,0,12">
              <Border Width="24"
                      Height="24"
                      Background="{StaticResource SurfaceRaisedBrush}"
                      CornerRadius="12"
                      VerticalAlignment="Top">
                <TextBlock Text="{Binding Number}"
                           FontFamily="Cascadia Mono,Consolas"
                           FontSize="11"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="7">
                <TextBlock Text="{Binding Text}"
                           FontSize="14"
                           LineHeight="22"
                           TextWrapping="Wrap" />
                <Button Tag="{Binding ActionTarget}"
                        Visibility="{Binding ActionVisibility}"
                        Click="StepActionClick"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Padding="10,0"
                        MinHeight="30"
                        FontSize="12">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A7;"
                              FontFamily="{StaticResource IconFontFamily}"
                              FontSize="12" />
                    <TextBlock Text="{Binding ActionLabel}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
    <DataTemplate x:Key="SpecimenTemplate">
      <ContentControl Content="{Binding Specimen}"
                      ContentTemplateSelector="{StaticResource SpecimenTemplateSelector}"
                      HorizontalContentAlignment="Stretch"
                      Margin="0,0,0,14" />
    </DataTemplate>
    <DataTemplate x:Key="CalloutTemplate">
      <Border Background="{Binding BackgroundBrush}"
              BorderBrush="{Binding BorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="12"
              Margin="0,0,0,10">
        <Grid ColumnDefinitions="3,*" ColumnSpacing="10">
          <Border Background="{Binding AccentBrush}" CornerRadius="2" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Text}"
                     FontSize="14"
                     LineHeight="22"
                     TextWrapping="Wrap" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="FaqTemplate">
      <StackPanel Spacing="8" Margin="0,4,0,12">
        <TextBlock Text="{Binding Title}"
                   AutomationProperties.HeadingLevel="Level2"
                   FontSize="16"
                   FontFamily="{StaticResource AppFontSemiBoldFamily}"
                   FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Faqs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Expander Header="{Binding Question}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Margin="0,0,0,6">
                <TextBlock Text="{Binding Answer}"
                           FontSize="13"
                           LineHeight="21"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,6" />
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="RelatedTemplate">
      <StackPanel Spacing="7" Margin="0,2,0,10">
        <TextBlock Text="{Binding Title}"
                   AutomationProperties.HeadingLevel="Level2"
                   FontSize="16"
                   FontFamily="{StaticResource AppFontSemiBoldFamily}"
                   FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Related}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <HyperlinkButton Content="{Binding Title}"
                               Tag="{Binding TopicId}"
                               AutomationProperties.AutomationId="{Binding AutomationId}"
                               Click="RelatedClick"
                               Padding="0"
                               HorizontalAlignment="Left" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <help:HelpSpecimenTemplateSelector x:Key="SpecimenTemplateSelector"
        DpiStagesTemplate="{StaticResource DpiStagesTemplate}"
        SceneCardTemplate="{StaticResource SceneCardTemplate}"
        ApplyScopeTemplate="{StaticResource ApplyScopeTemplate}"
        MacroStepTemplate="{StaticResource MacroStepTemplate}"
        KeyBindingTemplate="{StaticResource KeyBindingTemplate}" />
    <help:HelpBlockTemplateSelector x:Key="BlockTemplateSelector"
        ParagraphTemplate="{StaticResource ParagraphTemplate}"
        StepsTemplate="{StaticResource StepsTemplate}"
        SpecimenTemplate="{StaticResource SpecimenTemplate}"
        CalloutTemplate="{StaticResource CalloutTemplate}"
        FaqTemplate="{StaticResource FaqTemplate}"
        RelatedTemplate="{StaticResource RelatedTemplate}" />
  </UserControl.Resources>

  <StackPanel Spacing="22">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Orientation="Horizontal"
                  Spacing="4"
                  VerticalAlignment="Center">
        <HyperlinkButton Content="{Binding HelpText}"
                         Click="HomeClick"
                         Padding="0" />
        <TextBlock Text="/"
                   Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center" />
        <HyperlinkButton Content="{Binding Article.CategoryTitle}"
                         Click="CategoryClick"
                         Padding="0" />
      </StackPanel>
      <DropDownButton x:Name="DirectoryButton"
                      Grid.Column="1"
                      AutomationProperties.AutomationId="HelpDirectoryButton"
                      Content="{Binding DirectoryTitle}"
                      MinHeight="32"
                      Padding="12,0">
        <DropDownButton.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight" Opened="DirectoryOpened">
            <ScrollViewer MaxHeight="480" MinWidth="270">
              <ItemsControl ItemsSource="{Binding Directory}" Margin="2">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="3" Margin="0,0,0,10">
                      <TextBlock Text="{Binding Title}"
                                 FontFamily="{StaticResource AppFontSemiBoldFamily}"
                                 FontWeight="SemiBold"
                                 FontSize="12"
                                 Foreground="{StaticResource MutedBrush}"
                                 Margin="8,0,8,2" />
                      <ItemsControl ItemsSource="{Binding Topics}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Tag="{Binding TopicId}"
                                    Click="DirectoryTopicClick"
                                    AutomationProperties.AutomationId="{Binding AutomationId}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,5"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                              <Grid ColumnDefinitions="3,*" ColumnSpacing="8">
                                <Border Background="{StaticResource AccentBrush}"
                                        CornerRadius="2"
                                        Visibility="{Binding CurrentVisibility}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           TextWrapping="Wrap" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </Grid>

    <StackPanel Spacing="10">
      <TextBlock x:Name="ArticleTitleText"
                 AutomationProperties.AutomationId="HelpArticleTitle"
                 AutomationProperties.HeadingLevel="Level1"
                 Text="{Binding Article.Title}"
                 FontSize="28"
                 FontFamily="{StaticResource AppFontBoldFamily}"
                 FontWeight="Bold"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding Article.Summary}"
                 FontSize="15"
                 LineHeight="23"
                 Foreground="{StaticResource MutedBrush}"
                 TextWrapping="Wrap" />
      <Border Background="{StaticResource SurfaceRaisedBrush}"
              CornerRadius="10"
              Padding="9,3"
              HorizontalAlignment="Left">
        <TextBlock Text="{Binding Article.Audience}"
                   FontSize="11"
                   Foreground="{StaticResource AccentBrush}" />
      </Border>
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Article.Blocks}"
                  ItemTemplateSelector="{StaticResource BlockTemplateSelector}" />

    <Grid ColumnDefinitions="*,*"
          ColumnSpacing="12"
          Margin="0,10,0,0">
      <Button Tag="{Binding Article.PreviousTopicId}"
              Visibility="{Binding Article.PreviousVisibility}"
              Click="PreviousClick"
              Style="{StaticResource SecondaryButtonStyle}"
              HorizontalAlignment="Left"
              HorizontalContentAlignment="Left"
              Padding="12,8"
              MinHeight="48">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Article.PreviousLabel}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}" />
          <TextBlock Text="{Binding Article.PreviousTitle}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1"
              Tag="{Binding Article.NextTopicId}"
              Visibility="{Binding Article.NextVisibility}"
              Click="NextClick"
              Style="{StaticResource SecondaryButtonStyle}"
              HorizontalAlignment="Right"
              HorizontalContentAlignment="Right"
              Padding="12,8"
              MinHeight="48">
        <StackPanel Spacing="2" HorizontalAlignment="Right">
          <TextBlock Text="{Binding Article.NextLabel}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     HorizontalAlignment="Right" />
          <TextBlock Text="{Binding Article.NextTitle}"
                     TextWrapping="Wrap"
                     TextAlignment="Right" />
        </StackPanel>
      </Button>
    </Grid>
  </StackPanel>
</UserControl>
