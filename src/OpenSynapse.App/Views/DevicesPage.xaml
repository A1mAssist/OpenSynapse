<UserControl
    x:Class="OpenSynapse.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    xmlns:viewModels="using:OpenSynapse.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" /><local:VisibilityLayoutConverter x:Key="VisibilityLayoutConverter" />
    <DataTemplate x:Key="ConnectedDeviceCardTemplate">
      <Button Tag="{Binding Source}" Click="ConnectedDeviceCardClick" Style="{StaticResource QuickActionButtonStyle}" Padding="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
        <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="13">
          <Border Width="42" Height="42" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="4">
            <FontIcon Glyph="{Binding IconGlyph}" FontFamily="{StaticResource IconFontFamily}" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" />
            <TextBlock Text="{Binding Access}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding Identity}" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3" MaxWidth="260">
            <TextBlock Text="{Binding Capability}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding Error}" FontFamily="Cascadia Mono,Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer x:Name="PageScrollViewer" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
              <StackPanel Padding="24,24,24,48" Spacing="16" MinWidth="640">
                <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock local:Localized.Uid="Loc_E7F68C4BF6" Text="设备" Style="{StaticResource PageTitleStyle}" /><TextBlock local:Localized.Uid="Loc_0053B5D025" Text="已发现的设备及其已验证控制。" Foreground="{StaticResource MutedBrush}" /></StackPanel><Button local:Localized.Uid="Loc_AB55074471" Grid.Column="1" Content="重新探测" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" /></Grid>
                <InfoBar IsOpen="{Binding HasDeviceError}" IsClosable="False" Severity="Warning" Message="{Binding DeviceErrorText}" />
                <StackPanel Spacing="8">
                <ItemsRepeater x:Name="DeviceCardsRepeater" ItemsSource="{Binding PrimaryDevices}" ItemTemplate="{StaticResource ConnectedDeviceCardTemplate}"><ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout></ItemsRepeater>
                <StackPanel x:Name="AdditionalDevicesSection" Visibility="{Binding AdditionalDevicesVisibility}" Spacing="0">
                  <Button x:Name="AdditionalDevicesExpandButton" Click="AdditionalDevicesToggleClick" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="28" HorizontalAlignment="Left" AutomationProperties.Name="展开剩余设备"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70D;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="展开剩余设备" Foreground="{StaticResource AccentBrush}" /></StackPanel></Button>
                  <StackPanel x:Name="AdditionalDevicesPanel" Visibility="Collapsed" Spacing="8">
                  <ItemsRepeater ItemsSource="{Binding AdditionalDevices}" ItemTemplate="{StaticResource ConnectedDeviceCardTemplate}"><ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout></ItemsRepeater>
                  </StackPanel>
                  <Button x:Name="AdditionalDevicesCollapseButton" Visibility="Collapsed" Click="AdditionalDevicesToggleClick" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,0" MinHeight="28" HorizontalAlignment="Left" AutomationProperties.Name="收起设备"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70E;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="收起设备" Foreground="{StaticResource AccentBrush}" /></StackPanel></Button>
                </StackPanel>
                </StackPanel>
                <StackPanel x:Name="HuePanel" DataContext="{Binding Hue}" Visibility="Collapsed" Spacing="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                      <TextBlock local:Localized.Uid="HueTitle" Text="飞利浦 Hue" Style="{StaticResource PageTitleStyle}" />
                      <TextBlock local:Localized.Uid="HueDescription" Text="自动查找局域网中的 Hue 桥；找不到时可手动填写地址。按桥上的配对按钮后点“配对”。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="3">
                      <TextBlock Text="{Binding DeviceStatusText}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{Binding StatusBrush}" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding DeviceIdentity}" FontFamily="Cascadia Mono,Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Right" MaxWidth="300" />
                    </StackPanel>
                  </Grid>
                  <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Warning" Message="{Binding ErrorText}" />
                  <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox local:Localized.Uid="HueBridgeCombo" Header="Hue 桥" ItemsSource="{Binding Bridges}" SelectedItem="{Binding SelectedBridge, Mode=TwoWay}" DisplayMemberPath="DisplayName" PlaceholderText="扫描局域网或手动输入地址" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" local:Localized.Uid="HueScanButton" Content="扫描" Click="HueScanClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding BridgeHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" PlaceholderText="手动输入桥地址，例如 192.168.1.2" />
                        <Button Grid.Column="1" local:Localized.Uid="HuePairButton" Content="配对" Click="HuePairClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Column="2" local:Localized.Uid="HueRefreshButton" Content="刷新" Click="HueRefreshClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" />
                      </Grid>
                      <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding BridgeSummary}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono,Consolas" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                      <TextBlock local:Localized.Uid="HueLightsTitle" Text="灯光" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" />
                      <ListView ItemsSource="{Binding Lights}" SelectionMode="None" Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto,160,Auto" ColumnSpacing="12" MinHeight="36">
                              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                              <ToggleSwitch Grid.Column="1" IsOn="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" OnContent="" OffContent="" MinWidth="44" />
                              <Slider Grid.Column="2" Minimum="0" Maximum="100" StepFrequency="1" Value="{Binding Brightness, Mode=TwoWay}" IsEnabled="{Binding SupportsBrightness}" />
                              <Button Grid.Column="3" local:Localized.Uid="HueApplyButton" Content="应用" Click="HueApplyLightClick" Tag="{Binding}" Style="{StaticResource OpenRazerSaveButtonStyle}" />
                            </Grid>
                          </DataTemplate>
                        </ListView.ItemTemplate>
                      </ListView>
                      <StackPanel Spacing="6">
                        <TextBlock local:Localized.Uid="HueColorLabel" Text="颜色" Style="{StaticResource MetricLabelStyle}" />
                        <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="12">
                          <ComboBox ItemsSource="{Binding Lights}" SelectedItem="{Binding SelectedColorLight, Mode=TwoWay}" DisplayMemberPath="Name" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" />
                          <ColorPicker Grid.Column="1" Color="{Binding HueColor, Mode=TwoWay}" IsAlphaEnabled="False" IsColorChannelTextInputVisible="False" IsColorSpectrumVisible="True" IsHexInputVisible="True" IsMoreButtonVisible="False" Width="240" HorizontalAlignment="Left" />
                          <Button Grid.Column="2" local:Localized.Uid="HueApplyColorButton" Content="应用颜色" Click="HueApplyColorClick" IsEnabled="{Binding CanApplyColor}" Style="{StaticResource OpenRazerSaveButtonStyle}" VerticalAlignment="Bottom" />
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel x:Name="OpenRazerKrakenPanel" DataContext="{Binding OpenRazer.SelectedKraken}" Visibility="Collapsed" Spacing="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Style="{StaticResource PageTitleStyle}" /><StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" /><TextBlock Text="{Binding Identity}" FontFamily="Cascadia Mono,Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" /></StackPanel></Grid>
                  <StackPanel Visibility="{Binding SerialVisibility}" Orientation="Horizontal" Spacing="8"><TextBlock local:Localized.Uid="OpenRazerSerialLabel" Text="序列号" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Serial}" FontFamily="Cascadia Mono,Consolas" TextWrapping="Wrap" /></StackPanel>
                  <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Warning" Message="{Binding ErrorText}" />
                   <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding ControlsVisibility}"><StackPanel Spacing="14"><TextBlock local:Localized.Uid="OpenRazerKrakenLightingTitle" Text="灯光效果" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><ComboBox local:Localized.Uid="OpenRazerLightingEffect" Header="效果" ItemsSource="{Binding EffectOptions}" SelectedIndex="{Binding SelectedEffectIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" /><Grid RowDefinitions="Auto,Auto" RowSpacing="6" Visibility="{Binding LightingPresetVisibility}"><TextBlock local:Localized.Uid="LightingPresetApplyLabel" Text="应用预设" Style="{StaticResource MetricLabelStyle}" /><ItemsControl Grid.Row="1" x:Name="KrakenLightingPresets" ItemsSource="{x:Bind LightingPresetOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="KrakenLightingPresetButtonClick" Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" Margin="0,0,6,0"><StackPanel Orientation="Horizontal" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"><Border Width="12" Height="12" CornerRadius="2" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Background="{Binding PrimaryBrush}" /><Border Width="12" Height="12" CornerRadius="2" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Background="{Binding SecondaryBrush}" /><Border Width="12" Height="12" CornerRadius="2" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Background="{Binding TertiaryBrush}" /></StackPanel><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                      <DropDownButton Visibility="{Binding PrimaryVisibility}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Bottom"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="18" Height="18" CornerRadius="3" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"><Border.Background><SolidColorBrush Color="{Binding Primary}" /></Border.Background></Border><TextBlock local:Localized.Uid="OpenRazerPrimaryColorLabel" Text="颜色" /></StackPanel><DropDownButton.Flyout><Flyout x:Name="KrakenPrimaryColorFlyout" ShouldConstrainToRootBounds="False" Opened="LightingColorFlyoutOpened" Closed="LightingColorFlyoutClosed"><StackPanel Width="280" Spacing="10"><TextBlock local:Localized.Uid="LightingQuickColors" Text="常用颜色" Style="{StaticResource MetricLabelStyle}" /><ItemsControl ItemsSource="{x:Bind LightingPaletteColors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="LightingColorSwatchClick" Width="28" Height="28" Margin="3" Padding="0" Background="{Binding Brush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="4" ToolTipService.ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel x:Name="KrakenPrimaryRecentColors" Visibility="Collapsed" Spacing="6"><TextBlock local:Localized.Uid="LightingRecentColors" Text="最近使用" Style="{StaticResource MetricLabelStyle}" /><ItemsControl ItemsSource="{x:Bind RecentLightingColors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="LightingColorSwatchClick" Width="28" Height="28" Margin="3" Padding="0" Background="{Binding Brush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="4" ToolTipService.ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><Expander local:Localized.Uid="LightingCustomColor" Header="自定义颜色"><ColorPicker x:Name="KrakenPrimaryColorPicker" Color="{Binding Primary, Mode=TwoWay}" Width="260" IsAlphaEnabled="False" IsColorSpectrumVisible="True" IsColorChannelTextInputVisible="False" IsHexInputVisible="True" IsMoreButtonVisible="False" /></Expander></StackPanel></Flyout></DropDownButton.Flyout></DropDownButton>
                      <DropDownButton Grid.Column="1" Visibility="{Binding SecondaryVisibility}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Bottom"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="18" Height="18" CornerRadius="3" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"><Border.Background><SolidColorBrush Color="{Binding Secondary}" /></Border.Background></Border><TextBlock local:Localized.Uid="OpenRazerSecondaryColorLabel" Text="颜色 2" /></StackPanel><DropDownButton.Flyout><Flyout x:Name="KrakenSecondaryColorFlyout" ShouldConstrainToRootBounds="False" Opened="LightingColorFlyoutOpened" Closed="LightingColorFlyoutClosed"><StackPanel Width="280" Spacing="10"><TextBlock local:Localized.Uid="LightingQuickColors" Text="常用颜色" Style="{StaticResource MetricLabelStyle}" /><ItemsControl ItemsSource="{x:Bind LightingPaletteColors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="LightingColorSwatchClick" Width="28" Height="28" Margin="3" Padding="0" Background="{Binding Brush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="4" ToolTipService.ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel x:Name="KrakenSecondaryRecentColors" Visibility="Collapsed" Spacing="6"><TextBlock local:Localized.Uid="LightingRecentColors" Text="最近使用" Style="{StaticResource MetricLabelStyle}" /><ItemsControl ItemsSource="{x:Bind RecentLightingColors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="LightingColorSwatchClick" Width="28" Height="28" Margin="3" Padding="0" Background="{Binding Brush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="4" ToolTipService.ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><Expander local:Localized.Uid="LightingCustomColor" Header="自定义颜色"><ColorPicker x:Name="KrakenSecondaryColorPicker" Color="{Binding Secondary, Mode=TwoWay}" Width="260" IsAlphaEnabled="False" IsColorSpectrumVisible="True" IsColorChannelTextInputVisible="False" IsHexInputVisible="True" IsMoreButtonVisible="False" /></Expander></StackPanel></Flyout></DropDownButton.Flyout></DropDownButton>
                      <DropDownButton Grid.Column="2" Visibility="{Binding TertiaryVisibility}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Bottom"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="18" Height="18" CornerRadius="3" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"><Border.Background><SolidColorBrush Color="{Binding Tertiary}" /></Border.Background></Border><TextBlock local:Localized.Uid="OpenRazerTertiaryColorLabel" Text="颜色 3" /></StackPanel><DropDownButton.Flyout><Flyout x:Name="KrakenTertiaryColorFlyout" ShouldConstrainToRootBounds="False" Opened="LightingColorFlyoutOpened" Closed="LightingColorFlyoutClosed"><StackPanel Width="280" Spacing="10"><TextBlock local:Localized.Uid="LightingQuickColors" Text="常用颜色" Style="{StaticResource MetricLabelStyle}" /><ItemsControl ItemsSource="{x:Bind LightingPaletteColors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="LightingColorSwatchClick" Width="28" Height="28" Margin="3" Padding="0" Background="{Binding Brush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="4" ToolTipService.ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel x:Name="KrakenTertiaryRecentColors" Visibility="Collapsed" Spacing="6"><TextBlock local:Localized.Uid="LightingRecentColors" Text="最近使用" Style="{StaticResource MetricLabelStyle}" /><ItemsControl ItemsSource="{x:Bind RecentLightingColors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="LightingColorSwatchClick" Width="28" Height="28" Margin="3" Padding="0" Background="{Binding Brush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="4" ToolTipService.ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><Expander local:Localized.Uid="LightingCustomColor" Header="自定义颜色"><ColorPicker x:Name="KrakenTertiaryColorPicker" Color="{Binding Tertiary, Mode=TwoWay}" Width="260" IsAlphaEnabled="False" IsColorSpectrumVisible="True" IsColorChannelTextInputVisible="False" IsHexInputVisible="True" IsMoreButtonVisible="False" /></Expander></StackPanel></Flyout></DropDownButton.Flyout></DropDownButton>
                    </Grid>
                    <StackPanel Visibility="{Binding IntensityVisibility}" Spacing="5"><TextBlock local:Localized.Uid="OpenRazerBrightnessLabel" Text="亮度" Style="{StaticResource MetricLabelStyle}" /><Slider Value="{Binding Intensity, Mode=TwoWay}" Minimum="0" Maximum="255" StepFrequency="1" /><TextBlock Text="{Binding IntensityText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                    <Button local:Localized.Uid="OpenRazerKrakenApplyButton" Content="应用灯效" Click="OpenRazerKrakenApplyClick" IsEnabled="{Binding CanApply}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                  </StackPanel></Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding ThxVisibility}"><StackPanel Spacing="12"><TextBlock local:Localized.Uid="RazerHeadsetThxTitle" Text="THX Spatial Audio" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><TextBlock local:Localized.Uid="RazerHeadsetThxDescription" Text="THX Spatial Audio 由雷云的 THX 服务和音频组件提供。缺失时在这里安装；安装包需要管理员权限。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding ThxStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button local:Localized.Uid="ThxRefreshButton" Content="刷新" Click="OpenRazerKrakenRefreshThxClick" Style="{StaticResource SecondaryButtonStyle}" /><Button local:Localized.Uid="RazerHeadsetThxInstallButton" Content="下载 THX 安装包" Click="OpenRazerKrakenInstallThxClick" Visibility="{Binding ThxInstallerVisibility}" Style="{StaticResource PrimaryButtonStyle}" /><Button local:Localized.Uid="RazerHeadsetThxDownloadButton" Content="下载 THX 控制组件" Click="OpenRazerKrakenDownloadThxClick" Visibility="{Binding ThxDownloadVisibility}" IsEnabled="{Binding CanDownloadThxComponent}" Style="{StaticResource PrimaryButtonStyle}" /><Button local:Localized.Uid="RazerHeadsetThxGameProfilesButton" Content="更新 THX 游戏配置" Click="OpenRazerKrakenOpenThxGameProfilesClick" Visibility="{Binding ThxGameProfilesVisibility}" Style="{StaticResource SecondaryButtonStyle}" /><Button local:Localized.Uid="RazerHeadsetThxPatcherButton" Content="更新 THX Patcher" Click="OpenRazerKrakenOpenThxPatcherClick" Visibility="{Binding ThxPatcherVisibility}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></StackPanel></Border>
                </StackPanel>
                <StackPanel x:Name="BlackSharkPanel" DataContext="{Binding SelectedBlackShark}" Visibility="Collapsed" Spacing="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="{Binding CategoryText}" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding StatusText}" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" /><TextBlock Text="{Binding Identity}" FontFamily="Cascadia Mono,Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" /></StackPanel>
                  </Grid>
                  <StackPanel Visibility="{Binding SerialVisibility}" Orientation="Horizontal" Spacing="8"><TextBlock local:Localized.Uid="OpenRazerSerialLabel" Text="序列号" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Serial}" FontFamily="Cascadia Mono,Consolas" TextWrapping="Wrap" /></StackPanel>
                  <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Warning" Message="{Binding ErrorText}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding OperationStatusText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" /><Button Grid.Column="1" local:Localized.Uid="BlackSharkRefreshButton" Content="刷新" Click="BlackSharkRefreshClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" /></Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="16">
                    <Border Style="{StaticResource CardStyle}" Padding="16"><StackPanel Spacing="10"><TextBlock local:Localized.Uid="BlackSharkBatteryTitle" Text="电量" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding BatteryText}" Style="{StaticResource MetricValueStyle}" /><TextBlock Text="{Binding ChargingText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" /></StackPanel></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16"><StackPanel Spacing="10"><TextBlock local:Localized.Uid="BlackSharkThxTitle" Text="THX Spatial Audio" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><ToggleSwitch local:Localized.Uid="BlackSharkThxToggle" Header="THX Spatial Audio" IsOn="{Binding ThxEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" /><Button local:Localized.Uid="OpenRazerSaveButton" Content="保存" Click="BlackSharkApplyThxClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource OpenRazerSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16"><StackPanel Spacing="10"><TextBlock local:Localized.Uid="BlackSharkSidetoneTitle" Text="侧音" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><TextBlock local:Localized.Uid="BlackSharkSidetoneLabel" Text="侧音强度" Style="{StaticResource MetricLabelStyle}" /><NumberBox Value="{Binding SidetoneLevel, Mode=TwoWay}" Minimum="0" Maximum="15" SmallChange="1" SpinButtonPlacementMode="Compact" IsEnabled="{Binding CanEdit}" /><TextBlock Text="{Binding SidetoneText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /><Button local:Localized.Uid="OpenRazerSaveButton" Content="保存" Click="BlackSharkApplySidetoneClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource OpenRazerSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16"><StackPanel Spacing="10"><TextBlock local:Localized.Uid="BlackSharkGameChatTitle" Text="游戏 / 语音平衡" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><Slider Value="{Binding GameChatBalance, Mode=TwoWay}" Minimum="0" Maximum="20" StepFrequency="1" IsEnabled="{Binding CanEdit}" /><Grid ColumnDefinitions="Auto,*,Auto"><TextBlock local:Localized.Uid="BlackSharkGameChatGameSide" Text="游戏" FontSize="12" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="2" local:Localized.Uid="BlackSharkGameChatChatSide" Text="语音" FontSize="12" Foreground="{StaticResource MutedBrush}" /></Grid><TextBlock Text="{Binding GameChatBalanceText}" FontFamily="Cascadia Mono,Consolas" Foreground="{StaticResource MutedBrush}" /><Button local:Localized.Uid="OpenRazerSaveButton" Content="保存" Click="BlackSharkApplyGameChatClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource OpenRazerSaveButtonStyle}" HorizontalAlignment="Right" /></StackPanel></Border>
                  </Grid>
