<Window
    x:Class="OpenSynapse.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    xmlns:views="using:OpenSynapse.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenSynapse">
  <Grid x:Name="RootLayout" Background="{StaticResource CanvasBrush}" RowDefinitions="48,*" SizeChanged="RootLayoutSizeChanged">
    <Grid x:Name="AppTitleBar" Grid.Row="0" ColumnDefinitions="224,*" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid Padding="16,0" VerticalAlignment="Stretch">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image local:Localized.Uid="AppLogo" Width="28" Height="28" Stretch="Uniform" AutomationProperties.Name="OpenSynapse 标志">
            <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/OpenSynapseLogo.svg" /></Image.Source>
          </Image>
          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="OpenSynapse" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" />
            <TextBlock Text="LOCAL DEVICE CONTROL" FontFamily="Cascadia Mono,Consolas" FontSize="8" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" />
    </Grid>
    <NavigationView
        x:Name="RootNavigationView"
        Grid.Row="1"
        IsSettingsVisible="False"
        IsBackButtonVisible="Collapsed"
        IsTitleBarAutoPaddingEnabled="False"
        PaneDisplayMode="Auto"
        CompactPaneLength="48"
        OpenPaneLength="224"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}"
        SelectionChanged="NavigationChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem local:Localized.Uid="Loc_70C0B22D6C" x:Name="OverviewNavigationItem" Content="概览" Tag="overview" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem local:Localized.Uid="Loc_D1F5A968DF" x:Name="DevicesNavigationItem" Content="设备" Tag="devices"><NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem local:Localized.Uid="MacroNavigationItem" Content="宏" Tag="macros"><NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem local:Localized.Uid="Loc_8C8F3B71B8" Content="配置" Tag="profiles"><NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem local:Localized.Uid="Loc_D1F42581D7" Content="诊断" Tag="diagnostics"><NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem local:Localized.Uid="SettingsNavigationItem" Content="设置" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <NavigationView.Content>
        <Grid>
            <views:OverviewPage x:Name="OverviewPage" />
            <views:DevicesPage x:Name="DevicesPage" Visibility="Collapsed" />
            <views:ProfilesPage x:Name="ProfilesPage" Visibility="Collapsed" />
            <views:MacrosPage x:Name="MacrosPage" Visibility="Collapsed" />
            <views:SettingsPage x:Name="SettingsPage" Visibility="Collapsed" />
            <views:DiagnosticsPage x:Name="DiagnosticsPage" Visibility="Collapsed" />
        </Grid>
      </NavigationView.Content>
    </NavigationView>
    <Grid x:Name="LaunchOverlay" Grid.RowSpan="2" Canvas.ZIndex="100" Background="{StaticResource CanvasBrush}">
      <Grid.Resources>
        <Storyboard x:Name="LaunchOverlayFadeStoryboard" Completed="LaunchOverlayFadeCompleted">
          <DoubleAnimation Storyboard.TargetName="LaunchOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
        </Storyboard>
      </Grid.Resources>
      <StackPanel x:Name="LaunchPanel" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Grid Width="112" Height="112" HorizontalAlignment="Center">
          <ProgressRing local:Localized.Uid="Loc_A7FABDAFBA" x:Name="LaunchProgressRing" Width="108" Height="108" IsActive="True" Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="正在启动 OpenSynapse" />
          <Image local:Localized.Uid="Loc_BA196502D0" Width="70" Height="70" Stretch="Uniform" AutomationProperties.Name="OpenSynapse 标志"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/OpenSynapseLogo.svg" /></Image.Source></Image>
        </Grid>
        <TextBlock Text="OpenSynapse" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="LOCAL DEVICE CONTROL" FontFamily="Cascadia Mono,Consolas" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
        <TextBlock local:Localized.Uid="Loc_D21D65F64A" x:Name="LaunchStatusText" Text="正在准备本机控制" FontSize="14" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Grid>
    <Canvas x:Name="IntroductionOverlay" Grid.Row="1" Canvas.ZIndex="150" Visibility="Collapsed">
      <Path x:Name="IntroductionOverlayPath" Fill="#99000000" />
    </Canvas>
    <TeachingTip local:Localized.Uid="Loc_A953098FFE"
        x:Name="IntroductionTip"
        Grid.RowSpan="2"
        Canvas.ZIndex="200"
        Width="340"
        MaxWidth="340"
        HorizontalContentAlignment="Stretch"
        IsLightDismissEnabled="False"
        ShouldConstrainToRootBounds="True"
        TailVisibility="Visible"
        CloseButtonClick="IntroductionTipCloseClick"
        AutomationProperties.Name="OpenSynapse 使用导览">
      <StackPanel Spacing="14">
        <TextBlock x:Name="IntroductionBodyText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <TextBlock x:Name="IntroductionProgressText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono,Consolas" FontSize="11" />
          <Button local:Localized.Uid="Loc_870B386A8A" x:Name="IntroductionPreviousButton" Grid.Column="2" MinWidth="80" Content="上一步" FontFamily="Microsoft YaHei UI,Segoe UI" FontSize="14" FontWeight="Normal" Click="IntroductionPreviousClick" Style="{StaticResource SecondaryButtonStyle}" />
          <Button local:Localized.Uid="Loc_0D81928209" x:Name="IntroductionNextButton" Grid.Column="3" MinWidth="80" Content="下一步" FontFamily="Microsoft YaHei UI,Segoe UI" FontSize="14" FontWeight="Normal" Click="IntroductionNextClick" Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
      </StackPanel>
    </TeachingTip>
  </Grid>
</Window>





