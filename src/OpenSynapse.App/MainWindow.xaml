<Window
    x:Class="OpenSynapse.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenSynapse">
  <Grid x:Name="RootLayout" Background="{StaticResource CanvasBrush}" RowDefinitions="48,*" SizeChanged="RootLayoutSizeChanged">
    <Grid x:Name="AppTitleBar" Grid.Row="0" ColumnDefinitions="224,*" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid Padding="16,0" VerticalAlignment="Stretch">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image local:Localized.Uid="AppLogo" Width="28" Height="28" Stretch="Uniform" AutomationProperties.Name="OpenSynapse 标志">
            <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/OpenSynapseLogo.svg" /></Image.Source>
          </Image>
          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="OpenSynapse" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" />
            <TextBlock Text="LOCAL DEVICE CONTROL" FontFamily="Cascadia Mono" FontSize="8" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" />
    </Grid>
    <NavigationView
        x:Name="RootNavigationView"
        Grid.Row="1"
        IsSettingsVisible="False"
        IsBackButtonVisible="Collapsed"
        IsTitleBarAutoPaddingEnabled="False"
        PaneDisplayMode="Auto"
        CompactPaneLength="48"
        OpenPaneLength="224"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}"
        SelectionChanged="NavigationChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem local:Localized.Uid="Loc_70C0B22D6C" x:Name="OverviewNavigationItem" Content="概览" Tag="overview" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="16" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem local:Localized.Uid="Loc_D1F5A968DF" x:Name="DevicesNavigationItem" Content="设备" Tag="devices"><NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem local:Localized.Uid="Loc_8C8F3B71B8" Content="配置" Tag="profiles"><NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem local:Localized.Uid="Loc_D1F42581D7" Content="诊断" Tag="diagnostics"><NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem local:Localized.Uid="SettingsNavigationItem" Content="设置" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <NavigationView.Content>
        <Grid>
            <ScrollViewer x:Name="OverviewPage" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
              <StackPanel Padding="24,24,24,48" Spacing="16" MinWidth="640">
                <StackPanel Spacing="5"><TextBlock local:Localized.Uid="Loc_16E65B7F4A" Text="概览" Style="{StaticResource PageTitleStyle}" /><TextBlock local:Localized.Uid="Loc_6F843C9A12" Text="系统状态、资源使用与已连接设备概览。" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Warning" Message="{Binding ErrorText}" />
                <StackPanel x:Name="SystemTelemetrySection" Spacing="12">
                  <TextBlock local:Localized.Uid="Loc_643DCA0BC0" Text="系统遥测" FontSize="19" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" />
                  <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                      <StackPanel Spacing="3"><TextBlock Text="CPU" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding CpuName}" FontSize="14" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" TextWrapping="WrapWholeWords" /></StackPanel>
                      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16"><StackPanel Spacing="4"><TextBlock local:Localized.Uid="Loc_7A745D34B1" Text="温度" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding CpuTemperatureText}" FontFamily="Cascadia Mono" FontSize="16" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock local:Localized.Uid="Loc_B391411492" Text="功耗" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding CpuPowerText}" FontFamily="Cascadia Mono" FontSize="16" /></StackPanel><StackPanel Grid.Column="2" Spacing="4"><TextBlock local:Localized.Uid="Loc_F58BD88A2E" Text="负载" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding CpuValue}" FontFamily="Cascadia Mono" FontSize="16" Foreground="{StaticResource AccentBrush}" /></StackPanel><StackPanel Grid.Column="3" Spacing="4"><TextBlock local:Localized.Uid="Loc_38C653FB6C" Text="频率" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding CpuClockText}" FontFamily="Cascadia Mono" FontSize="16" /></StackPanel></Grid>
                      <ProgressBar Value="{Binding CpuPercent}" Maximum="100" Height="4" Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceRaisedBrush}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                      <StackPanel Spacing="3"><TextBlock Text="GPU" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding GpuName}" FontSize="14" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" TextWrapping="WrapWholeWords" /></StackPanel>
                      <Grid ColumnDefinitions="*,*,*,1.35*,2.15*" ColumnSpacing="12"><StackPanel Spacing="4"><TextBlock local:Localized.Uid="Loc_7A745D34B1" Text="温度" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding GpuTemperatureText}" FontFamily="Cascadia Mono" FontSize="14" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock local:Localized.Uid="Loc_B391411492" Text="功耗" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding GpuPowerText}" FontFamily="Cascadia Mono" FontSize="14" /></StackPanel><StackPanel Grid.Column="2" Spacing="4"><TextBlock local:Localized.Uid="Loc_F58BD88A2E" Text="负载" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding GpuValue}" FontFamily="Cascadia Mono" FontSize="14" Foreground="{StaticResource GpuBrush}" /></StackPanel><StackPanel Grid.Column="3" Spacing="4"><TextBlock local:Localized.Uid="Loc_38C653FB6C" Text="频率" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding GpuClockText}" FontFamily="Cascadia Mono" FontSize="14" /></StackPanel><StackPanel Grid.Column="4" Spacing="4"><TextBlock Text="{Binding GpuMemoryLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding GpuMemoryText}" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="WrapWholeWords" /></StackPanel></Grid>
                      <ProgressBar Value="{Binding GpuPercent}" Maximum="100" Height="4" Foreground="{StaticResource GpuBrush}" Background="{StaticResource SurfaceRaisedBrush}" />
                    </StackPanel>
                  </Border>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource CardStyle}" Padding="16"><StackPanel Spacing="8"><TextBlock Text="MEMORY" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding MemoryValue}" Style="{StaticResource MetricValueStyle}" /><ProgressBar Value="{Binding MemoryPercent}" Maximum="100" Height="4" Foreground="{StaticResource ThermalBrush}" Background="{StaticResource SurfaceRaisedBrush}" /><TextBlock Text="{Binding MemoryDetail}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono" FontSize="11" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16"><StackPanel Spacing="8"><TextBlock Text="STORAGE" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding StorageValue}" Style="{StaticResource MetricValueStyle}" /><ProgressBar Value="{Binding StoragePercent}" Maximum="100" Height="4" Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceRaisedBrush}" /><TextBlock Text="{Binding StorageDetail}" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono" FontSize="11" /></StackPanel></Border>
                  </Grid>
                </StackPanel>
                <TextBlock Text="{Binding TelemetryTimeText}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                <StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock local:Localized.Uid="Loc_B7D0B7C1CD" Text="已连接设备" FontSize="19" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" /><TextBlock Grid.Column="1" Text="{Binding Devices.Count}" Style="{StaticResource MetricLabelStyle}" /></Grid>
                  <ListView ItemsSource="{Binding Devices}" SelectionMode="None" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="16"><Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="13"><Border Width="42" Height="42" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="4"><FontIcon Glyph="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding IconAutomationName}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" /><TextBlock Text="{Binding Access}" FontSize="12" Foreground="{StaticResource MutedBrush}" /></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding Capability}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{Binding StatusBrush}" HorizontalAlignment="Right" /><TextBlock Text="{Binding Identity}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" /></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                  <TextBlock Text="{Binding EmptyStateText}" Foreground="{StaticResource MutedBrush}" /></StackPanel>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
              <StackPanel Padding="24,24,24,48" Spacing="16" MinWidth="640">
                <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock local:Localized.Uid="Loc_E7F68C4BF6" Text="设备" Style="{StaticResource PageTitleStyle}" /><TextBlock local:Localized.Uid="Loc_0053B5D025" Text="已发现的设备及其已验证控制。" Foreground="{StaticResource MutedBrush}" /></StackPanel><Button local:Localized.Uid="Loc_AB55074471" Grid.Column="1" Content="重新探测" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" /></Grid>
                <InfoBar IsOpen="{Binding HasDeviceError}" IsClosable="False" Severity="Warning" Message="{Binding DeviceErrorText}" />
                <ItemsRepeater ItemsSource="{Binding Devices}"><ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Padding="16"><Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="13"><Border Width="42" Height="42" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="4"><FontIcon Glyph="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding IconAutomationName}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" Foreground="{StaticResource DataBrush}" /><TextBlock Text="{Binding Identity}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource MutedBrush}" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Capability}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></Border></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
                <StackPanel x:Name="DeviceSelectorBar" Orientation="Horizontal" Spacing="8"><Button x:Name="BladeDeviceButton" Tag="blade" Click="DeviceSelectorClick" Style="{StaticResource SecondaryButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon local:Localized.Uid="Loc_A89D57B72A" Glyph="&#xE7F8;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="笔记本设备" /><TextBlock Text="{Binding BladeDeviceName}" /></StackPanel></Button><Button x:Name="ViperDeviceButton" Tag="viper" Click="DeviceSelectorClick" Visibility="{Binding ViperDeviceVisibility}" Style="{StaticResource SecondaryButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon local:Localized.Uid="Loc_D90B2AACF6" Glyph="&#xE962;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="鼠标设备" /><TextBlock Text="{Binding ViperDeviceName}" /></StackPanel></Button></StackPanel>
                <StackPanel x:Name="BladeDevicePanel" Spacing="16">
                  <TextBlock Text="{Binding BladeDeviceName}" Style="{StaticResource PageTitleStyle}" /><TextBlock local:Localized.Uid="Loc_5AADFF0A18" Text="状态、灯光、性能、显示和电池。" Foreground="{StaticResource MutedBrush}" />
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="1" Text="{Binding DeviceTelemetryTimeText}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                      <Border Style="{StaticResource CardStyle}" Padding="16" MinHeight="92">
                        <StackPanel Spacing="10">
                          <TextBlock local:Localized.Uid="Loc_D8667879C0" Text="风扇转速" Style="{StaticResource MetricLabelStyle}" />
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Spacing="3"><TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding BladeCurrentFanCpuRpmText}" FontFamily="Cascadia Mono" FontSize="17" FontWeight="SemiBold" TextWrapping="NoWrap" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="GPU" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding BladeCurrentFanGpuRpmText}" FontFamily="Cascadia Mono" FontSize="17" FontWeight="SemiBold" TextWrapping="NoWrap" /></StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" MinHeight="92">
                        <StackPanel Spacing="10">
                          <TextBlock local:Localized.Uid="Loc_C08649AE15" Text="风扇控制" Style="{StaticResource MetricLabelStyle}" />
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Spacing="3"><TextBlock local:Localized.Uid="Loc_3A5FA550D4" Text="模式" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding BladeFanModeText}" FontSize="16" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3"><TextBlock local:Localized.Uid="Loc_F6E2342F87" Text="目标" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding BladeFanTargetRpmText}" FontFamily="Cascadia Mono" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" /></StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                      <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="16" MinHeight="78">
                        <StackPanel Spacing="10">
                          <TextBlock local:Localized.Uid="Loc_FCEF52F340" Text="高级风扇诊断" Style="{StaticResource MetricLabelStyle}" />
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Spacing="3"><TextBlock local:Localized.Uid="Loc_FDC6488430" Text="CPU 原始模式" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding BladeAdvancedFanCpuModeRawText}" FontFamily="Cascadia Mono" FontSize="14" TextWrapping="NoWrap" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3"><TextBlock local:Localized.Uid="Loc_68E5F3A8F7" Text="GPU 原始模式" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding BladeAdvancedFanGpuModeRawText}" FontFamily="Cascadia Mono" FontSize="14" TextWrapping="NoWrap" /></StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><Border Style="{StaticResource CardStyle}" Padding="16"><StackPanel Spacing="8"><TextBlock local:Localized.Uid="Loc_E45684D3DA" Text="性能模式" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding BladePerformanceModeText}" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><ComboBox Tag="performance" ItemsSource="{Binding BladePerformanceModeOptions}" SelectedIndex="{Binding BladePerformanceModeIndex, Mode=TwoWay}" SelectionChanged="AutoApplyComboSelectionChanged" IsEnabled="{Binding CanSetBladePerformanceMode}" HorizontalAlignment="Stretch" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16"><StackPanel Spacing="5"><TextBlock local:Localized.Uid="Loc_C229515A4A" Text="风扇" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding BladeFanText}" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16"><StackPanel Spacing="8"><TextBlock local:Localized.Uid="Loc_E61D9AFAFA" Text="充电上限" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding BladeChargeLimitText}" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><ComboBox Tag="charge" ItemsSource="{Binding BladeChargeLimitOptions}" SelectedIndex="{Binding BladeChargeLimitIndex, Mode=TwoWay}" SelectionChanged="AutoApplyComboSelectionChanged" IsEnabled="{Binding CanSetBladeChargeLimit}" HorizontalAlignment="Stretch" /></StackPanel></Border></Grid>
                  <Border Visibility="{Binding BladeCustomPerformanceVisibility}" Style="{StaticResource CardStyle}" Padding="16"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,*,*" ColumnSpacing="16"><StackPanel Spacing="8"><TextBlock Text="CPU Boost" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding BladeCpuBoostText}" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><ComboBox Tag="cpuBoost" ItemsSource="{Binding BladeCpuBoostOptions}" SelectedIndex="{Binding BladeCpuBoostIndex, Mode=TwoWay}" SelectionChanged="AutoApplyComboSelectionChanged" IsEnabled="{Binding CanSetBladeCpuBoost}" HorizontalAlignment="Stretch" /></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="GPU Boost" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding BladeGpuBoostText}" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><ComboBox Tag="gpuBoost" ItemsSource="{Binding BladeGpuBoostOptions}" SelectedIndex="{Binding BladeGpuBoostIndex, Mode=TwoWay}" SelectionChanged="AutoApplyComboSelectionChanged" IsEnabled="{Binding CanSetBladeGpuBoost}" HorizontalAlignment="Stretch" /></StackPanel><StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="Max Fan" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding BladeMaxFanText}" FontSize="18" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><ToggleSwitch local:Localized.Uid="Loc_C78C6041E0" IsOn="{Binding BladeMaxFanEnabled, Mode=TwoWay}" IsEnabled="{Binding CanSetBladeMaxFan}" Toggled="AutoApplyMaxFanToggled" OnContent="开启" OffContent="关闭" /></StackPanel></Grid><TextBlock local:Localized.Uid="Loc_AE391759C5" Text="CPU/GPU Boost 仅当前会话，Max Fan 随配置保存。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" /></StackPanel></Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="14">
                      <Grid ColumnDefinitions="2*,*" ColumnSpacing="24">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="3"><TextBlock local:Localized.Uid="Loc_FBA62F56DE" Text="键盘灯光" FontSize="19" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><TextBlock Text="{Binding BladeStatusText}" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14"><Slider Minimum="0" Maximum="100" StepFrequency="6.25" Value="{Binding BladeBrightnessPercent, Mode=TwoWay}" ValueChanged="AutoApplyBrightnessValueChanged" IsEnabled="{Binding CanSetBladeBrightness}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding BladeBrightnessSelectionText}" FontFamily="Cascadia Mono" MinWidth="42" VerticalAlignment="Center" /></Grid>
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ComboBox local:Localized.Uid="Loc_69EFED8C33" Grid.ColumnSpan="2" Tag="lighting" ItemsSource="{Binding BladeLightingModeOptions}" SelectedIndex="{Binding BladeLightingModeIndex, Mode=TwoWay}" SelectionChanged="AutoApplyComboSelectionChanged" IsEnabled="{Binding CanSetBladeLighting}" HorizontalAlignment="Stretch" AutomationProperties.Name="键盘灯效" />
                          </Grid>
                          <Grid Height="34" ColumnDefinitions="*,*" ColumnSpacing="8">
                            <DropDownButton local:Localized.Uid="Loc_CDBC79C8C5" Visibility="{Binding BladeLightingColorVisibility}" IsEnabled="{Binding CanSetBladeLighting}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTipService.ToolTip="选择灯效颜色" AutomationProperties.Name="灯效颜色">
                              <StackPanel Orientation="Horizontal" Spacing="7"><Border Width="18" Height="18" CornerRadius="3" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"><Border.Background><SolidColorBrush Color="{Binding BladeLightingColor}" /></Border.Background></Border><TextBlock local:Localized.Uid="Loc_38C8E58C97" Text="颜色" /></StackPanel>
                              <DropDownButton.Flyout><Flyout Opened="LightingColorFlyoutOpened" Closed="LightingColorFlyoutClosed"><ColorPicker Color="{Binding BladeLightingColor, Mode=TwoWay}" IsAlphaEnabled="False" IsColorSpectrumVisible="True" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsMoreButtonVisible="False" /></Flyout></DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton local:Localized.Uid="Loc_5B268F9BA5" Grid.Column="1" Visibility="{Binding BladeLightingSecondColorVisibility}" IsEnabled="{Binding CanSetBladeLighting}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTipService.ToolTip="选择灯效颜色 2" AutomationProperties.Name="灯效颜色 2">
                              <StackPanel Orientation="Horizontal" Spacing="7"><Border Width="18" Height="18" CornerRadius="3" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"><Border.Background><SolidColorBrush Color="{Binding BladeLightingSecondColor}" /></Border.Background></Border><TextBlock local:Localized.Uid="Loc_16D5B1620F" Text="颜色 2" /></StackPanel>
                              <DropDownButton.Flyout><Flyout Opened="LightingColorFlyoutOpened" Closed="LightingColorFlyoutClosed"><ColorPicker Color="{Binding BladeLightingSecondColor, Mode=TwoWay}" IsAlphaEnabled="False" IsColorSpectrumVisible="True" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsMoreButtonVisible="False" /></Flyout></DropDownButton.Flyout>
                            </DropDownButton>
                            <ComboBox local:Localized.Uid="Loc_EB57417109" Grid.ColumnSpan="2" Tag="lighting" Visibility="{Binding BladeWaveDirectionVisibility}" ItemsSource="{Binding BladeWaveDirectionOptions}" SelectedIndex="{Binding BladeWaveDirectionIndex, Mode=TwoWay}" SelectionChanged="AutoApplyComboSelectionChanged" IsEnabled="{Binding CanSetBladeLighting}" HorizontalAlignment="Stretch" AutomationProperties.Name="波浪方向" />
                          </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8"><TextBlock local:Localized.Uid="Loc_B4D7460469" Text="机身 Logo" FontSize="19" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><TextBlock Text="{Binding BladeLogoText}" Foreground="{StaticResource AccentBrush}" /><ComboBox Tag="logo" ItemsSource="{Binding BladeLogoOptions}" SelectedIndex="{Binding BladeLogoIndex, Mode=TwoWay}" SelectionChanged="AutoApplyComboSelectionChanged" IsEnabled="{Binding CanSetBladeLogo}" HorizontalAlignment="Stretch" /></StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Padding="16"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="4"><TextBlock local:Localized.Uid="Loc_6FF5FBA77A" Text="触控板" FontSize="19" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" /><TextBlock Text="{Binding BladeTouchpadText}" Foreground="{StaticResource AccentBrush}" /><TextBlock local:Localized.Uid="Loc_C3B786E4F7" Text="使用 Windows 精确式触控板系统开关。" Foreground="{StaticResource MutedBrush}" FontSize="12" /></StackPanel><ToggleSwitch local:Localized.Uid="Loc_DA6DE4EFA4" Grid.Column="1" IsOn="{Binding BladeTouchpadEnabled}" IsEnabled="{Binding CanSetBladeTouchpad}" Toggled="ToggleTouchpadToggled" OnContent="开启" OffContent="关闭" AutomationProperties.Name="触控板" VerticalAlignment="Center" /></Grid></Border>
