<UserControl
    x:Class="OpenSynapse.App.Controls.Help.KeyBindingSpecimen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    Loaded="ControlLoaded">
  <StackPanel Spacing="10">
    <TextBlock local:Localized.Uid="Help_Specimen_KeyTitle"
               FontSize="13"
               FontFamily="{StaticResource AppFontSemiBoldFamily}"
               FontWeight="SemiBold" />
    <TextBlock local:Localized.Uid="Help_Specimen_KeyHint"
               FontSize="12"
               Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="3" VerticalAlignment="Center">
        <TextBlock local:Localized.Uid="Help_Specimen_KeyMacro"
                   FontFamily="{StaticResource AppFontSemiBoldFamily}"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="SelectedKeyText"
                   AutomationProperties.AutomationId="HelpKeySelection"
                   FontFamily="Cascadia Mono,Consolas"
                   FontSize="11"
                   Foreground="{StaticResource AccentBrush}" />
      </StackPanel>
      <ComboBox x:Name="KeyPicker"
                Grid.Column="1"
                AutomationProperties.AutomationId="HelpKeyBindingCombo"
                MinWidth="132"
                SelectedIndex="0"
                SelectionChanged="KeyChanged">
        <ComboBoxItem local:Localized.Uid="Help_Specimen_KeyMouse4" />
        <ComboBoxItem local:Localized.Uid="Help_Specimen_KeyMouse5" />
        <ComboBoxItem local:Localized.Uid="Help_Specimen_KeyF13" />
      </ComboBox>
    </Grid>
  </StackPanel>
</UserControl>
