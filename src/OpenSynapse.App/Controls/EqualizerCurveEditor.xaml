<UserControl
    x:Class="OpenSynapse.App.Controls.EqualizerCurveEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <x:Double x:Key="SliderVerticalThumbWidth">12</x:Double>
    <x:Double x:Key="SliderVerticalThumbHeight">12</x:Double>
    <x:Double x:Key="SliderInnerThumbWidth">8</x:Double>
    <x:Double x:Key="SliderInnerThumbHeight">8</x:Double>
    <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
    <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
    <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent" />
    <StaticResource x:Key="SliderThumbBackground" ResourceKey="DataBrush" />
    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentHoverBrush" />
    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentPressedBrush" />
    <StaticResource x:Key="SliderOuterThumbBackground" ResourceKey="DataBrush" />
  </UserControl.Resources>
  <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
    <Grid x:Name="EditorGrid" ColumnDefinitions="56,*" Margin="0,20,0,8">
      <Canvas x:Name="AxisCanvas" IsHitTestVisible="False" />
      <Grid Grid.Column="1" RowDefinitions="240,Auto,Auto">
        <Canvas x:Name="PlotCanvas" IsHitTestVisible="False" />
        <Grid x:Name="SlidersGrid" />
        <Grid x:Name="LabelsGrid" Grid.Row="1" Margin="0,18,0,0" />
        <Grid x:Name="ValuesGrid" Grid.Row="2" Margin="0,6,0,6" />
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
