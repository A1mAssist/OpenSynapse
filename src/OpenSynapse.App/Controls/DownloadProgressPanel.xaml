<UserControl
    x:Class="OpenSynapse.App.Controls.DownloadProgressPanel"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch">
  <StackPanel Spacing="6" Visibility="{Binding State.Visibility, ElementName=Root, FallbackValue=Collapsed}">
    <ProgressBar
        Value="{Binding State.Value, ElementName=Root}"
        Maximum="100"
        IsIndeterminate="{Binding State.IsIndeterminate, ElementName=Root}" />
    <TextBlock
        Text="{Binding State.DetailText, ElementName=Root}"
        Visibility="{Binding State.DetailVisibility, ElementName=Root, FallbackValue=Collapsed}"
        FontFamily="Cascadia Mono,Consolas"
        FontSize="11"
        Foreground="{StaticResource MutedBrush}"
        TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
