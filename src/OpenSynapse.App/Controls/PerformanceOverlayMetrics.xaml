<UserControl
    x:Class="OpenSynapse.App.Controls.PerformanceOverlayMetrics"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    IsTabStop="False"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <Style x:Key="OverlayMetricLabelStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppFontSemiBoldFamily}" />
      <Setter Property="FontSize" Value="8" />
      <Setter Property="CharacterSpacing" Value="60" />
      <Setter Property="Foreground" Value="#70FFFFFF" />
    </Style>
    <Style x:Key="OverlayMetricValueStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppFontSemiBoldFamily}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource DataBrush}" />
    </Style>
    <Style x:Key="OverlayMetricBarStyle"
           TargetType="ProgressBar"
           BasedOn="{StaticResource TelemetryBarStyle}">
      <Setter Property="Height" Value="3" />
      <Setter Property="MinHeight" Value="3" />
    </Style>
  </UserControl.Resources>

  <Grid ColumnDefinitions="Auto,*,*,*,*"
        RowDefinitions="Auto,Auto"
        ColumnSpacing="6"
        RowSpacing="8"
        VerticalAlignment="Center">
    <TextBlock Grid.Row="0"
               Grid.Column="0"
               Text="GPU"
               FontFamily="{StaticResource AppFontSemiBoldFamily}"
               FontSize="8"
               CharacterSpacing="40"
               Foreground="{StaticResource GpuBrush}"
               VerticalAlignment="Center" />
    <TextBlock Grid.Row="1"
               Grid.Column="0"
               Text="CPU"
               FontFamily="{StaticResource AppFontSemiBoldFamily}"
               FontSize="8"
               CharacterSpacing="40"
               Foreground="{StaticResource AccentBrush}"
               VerticalAlignment="Center" />

    <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2">
      <TextBlock Text="PWR" Style="{StaticResource OverlayMetricLabelStyle}" />
      <TextBlock Grid.Row="1"
                 Text="{Binding Telemetry.GpuPowerText}"
                 Style="{StaticResource OverlayMetricValueStyle}" />
    </Grid>
    <Grid Grid.Row="0" Grid.Column="2" RowDefinitions="Auto,Auto,3" RowSpacing="2">
      <TextBlock Text="UTIL" Style="{StaticResource OverlayMetricLabelStyle}" />
      <TextBlock Grid.Row="1"
                 Text="{Binding Telemetry.GpuValue}"
                 Style="{StaticResource OverlayMetricValueStyle}" />
      <ProgressBar Grid.Row="2"
                   Value="{Binding Telemetry.GpuPercent}"
                   Maximum="100"
                   Foreground="{StaticResource GpuBrush}"
                   Style="{StaticResource OverlayMetricBarStyle}"
                   Visibility="{Binding Telemetry.HasGpuUsage, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
    <Grid Grid.Row="0" Grid.Column="3" RowDefinitions="Auto,Auto" RowSpacing="2">
      <TextBlock Text="CLK" Style="{StaticResource OverlayMetricLabelStyle}" />
      <TextBlock Grid.Row="1"
                 Text="{Binding Telemetry.GpuClockText}"
                 Style="{StaticResource OverlayMetricValueStyle}" />
    </Grid>
    <Grid Grid.Row="0" Grid.Column="4" RowDefinitions="Auto,Auto,3" RowSpacing="2">
      <TextBlock Text="VRAM" Style="{StaticResource OverlayMetricLabelStyle}" />
      <TextBlock Grid.Row="1"
                 Text="{Binding Telemetry.GpuMemoryUsedText}"
                 Style="{StaticResource OverlayMetricValueStyle}" />
      <ProgressBar Grid.Row="2"
                   Value="{Binding Telemetry.GpuMemoryPercent}"
                   Maximum="100"
                   Foreground="{StaticResource GpuBrush}"
                   Style="{StaticResource OverlayMetricBarStyle}"
                   Visibility="{Binding Telemetry.HasGpuMemory, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="2">
      <TextBlock Text="PWR" Style="{StaticResource OverlayMetricLabelStyle}" />
      <TextBlock Grid.Row="1"
                 Text="{Binding Telemetry.CpuPowerText}"
                 Style="{StaticResource OverlayMetricValueStyle}" />
    </Grid>
    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,3" RowSpacing="2">
      <TextBlock Text="UTIL" Style="{StaticResource OverlayMetricLabelStyle}" />
      <TextBlock Grid.Row="1"
                 Text="{Binding Telemetry.CpuValue}"
                 Style="{StaticResource OverlayMetricValueStyle}" />
      <ProgressBar Grid.Row="2"
                   Value="{Binding Telemetry.CpuPercent}"
                   Maximum="100"
                   Foreground="{StaticResource AccentBrush}"
                   Style="{StaticResource OverlayMetricBarStyle}"
                   Visibility="{Binding Telemetry.HasCpuUsage, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
    <Grid Grid.Row="1" Grid.Column="3" RowDefinitions="Auto,Auto" RowSpacing="2">
      <TextBlock Text="CLK" Style="{StaticResource OverlayMetricLabelStyle}" />
      <TextBlock Grid.Row="1"
                 Text="{Binding Telemetry.CpuClockText}"
                 Style="{StaticResource OverlayMetricValueStyle}" />
    </Grid>
    <Grid Grid.Row="1" Grid.Column="4" RowDefinitions="Auto,Auto,3" RowSpacing="2">
      <TextBlock Text="RAM" Style="{StaticResource OverlayMetricLabelStyle}" />
      <TextBlock Grid.Row="1"
                 Text="{Binding Telemetry.MemoryUsedText}"
                 Style="{StaticResource OverlayMetricValueStyle}" />
      <ProgressBar Grid.Row="2"
                   Value="{Binding Telemetry.MemoryPercent}"
                   Maximum="100"
                   Foreground="#E2B663"
                   Style="{StaticResource OverlayMetricBarStyle}"
                   Visibility="{Binding Telemetry.HasMemory, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
  </Grid>
</UserControl>
