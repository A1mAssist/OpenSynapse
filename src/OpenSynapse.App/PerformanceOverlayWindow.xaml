<Window
    x:Class="OpenSynapse.App.PerformanceOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="DragRegion"
        Background="Transparent"
        PointerPressed="DragRegionPointerPressed">
    <Border x:Name="CompactCard"
            Background="#D91A1A1A"
            CornerRadius="10"
            Padding="10,8">
      <Grid ColumnDefinitions="*,*"
            RowDefinitions="Auto,Auto,Auto,Auto"
            ColumnSpacing="10"
            RowSpacing="2">
        <StackPanel Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
          <FontIcon x:Name="CompactModeIcon"
                    Glyph="&#xE945;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="15"
                    Foreground="{StaticResource AccentBrush}"
                    VerticalAlignment="Center" />
          <TextBlock Text="{Binding Blade.PerformanceModeText}"
                     FontFamily="{StaticResource AppFontSemiBoldFamily}"
                     FontSize="14"
                     Foreground="{StaticResource DataBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
          <FontIcon Glyph="&#xE950;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="12"
                    Foreground="{StaticResource AccentBrush}"
                    VerticalAlignment="Center" />
          <TextBlock Text="CPU"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Telemetry.CpuTemperatureText}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="11"
                     Foreground="{StaticResource DataBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="·"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Telemetry.CpuClockText}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource DataBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
          <FontIcon Glyph="&#xE7F4;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="12"
                    Foreground="{StaticResource AccentBrush}"
                    VerticalAlignment="Center" />
          <TextBlock Text="GPU"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Telemetry.GpuTemperatureText}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="11"
                     Foreground="{StaticResource DataBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="·"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Telemetry.GpuClockText}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource DataBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
          <Viewbox Width="13"
                   Height="13"
                   VerticalAlignment="Center">
            <Grid Width="16" Height="16">
              <Border Width="12"
                      Height="8"
                      CornerRadius="1"
                      Background="{StaticResource AccentBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Spacing="2">
                <Rectangle Width="1" Height="2" Fill="{StaticResource AccentBrush}" />
                <Rectangle Width="1" Height="2" Fill="{StaticResource AccentBrush}" />
                <Rectangle Width="1" Height="2" Fill="{StaticResource AccentBrush}" />
                <Rectangle Width="1" Height="2" Fill="{StaticResource AccentBrush}" />
                <Rectangle Width="1" Height="2" Fill="{StaticResource AccentBrush}" />
                <Rectangle Width="1" Height="2" Fill="{StaticResource AccentBrush}" />
              </StackPanel>
            </Grid>
          </Viewbox>
          <TextBlock Text="RAM"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Telemetry.MemoryValue}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="11"
                     Foreground="{StaticResource DataBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="·"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Telemetry.MemoryClockText}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource DataBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
          <Viewbox Width="13"
                   Height="13"
                   VerticalAlignment="Center">
            <Grid Width="16" Height="16">
              <Path Data="M8,1 C9.4,1 10.6,2.2 10.6,3.6 L10.6,6.4 C10.6,7.2 9.8,8 8,8 C6.2,8 5.4,7.2 5.4,6.4 L5.4,3.6 C5.4,2.2 6.6,1 8,1 Z"
                    Fill="{StaticResource AccentBrush}" />
              <Path Data="M8,1 C9.4,1 10.6,2.2 10.6,3.6 L10.6,6.4 C10.6,7.2 9.8,8 8,8 C6.2,8 5.4,7.2 5.4,6.4 L5.4,3.6 C5.4,2.2 6.6,1 8,1 Z"
                    Fill="{StaticResource AccentBrush}">
                <Path.RenderTransform>
                  <RotateTransform Angle="90" CenterX="8" CenterY="8" />
                </Path.RenderTransform>
              </Path>
              <Path Data="M8,1 C9.4,1 10.6,2.2 10.6,3.6 L10.6,6.4 C10.6,7.2 9.8,8 8,8 C6.2,8 5.4,7.2 5.4,6.4 L5.4,3.6 C5.4,2.2 6.6,1 8,1 Z"
                    Fill="{StaticResource AccentBrush}">
                <Path.RenderTransform>
                  <RotateTransform Angle="180" CenterX="8" CenterY="8" />
                </Path.RenderTransform>
              </Path>
              <Path Data="M8,1 C9.4,1 10.6,2.2 10.6,3.6 L10.6,6.4 C10.6,7.2 9.8,8 8,8 C6.2,8 5.4,7.2 5.4,6.4 L5.4,3.6 C5.4,2.2 6.6,1 8,1 Z"
                    Fill="{StaticResource AccentBrush}">
                <Path.RenderTransform>
                  <RotateTransform Angle="270" CenterX="8" CenterY="8" />
                </Path.RenderTransform>
              </Path>
              <Ellipse Width="3"
                       Height="3"
                       Fill="#D91A1A1A"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Grid>
          </Viewbox>
          <TextBlock x:Name="CompactFanLabel"
                     Text="风扇"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Blade.FanText}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="DetailedCard"
            Background="#D91A1A1A"
            CornerRadius="10"
            Padding="12,10"
            Visibility="Collapsed">
      <Grid ColumnDefinitions="*,116"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="14"
            RowSpacing="3">
        <StackPanel Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="7"
                    VerticalAlignment="Center">
          <FontIcon x:Name="DetailedModeIcon"
                    Glyph="&#xE945;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="16"
                    Foreground="{StaticResource AccentBrush}"
                    VerticalAlignment="Center" />
          <TextBlock Text="{Binding Blade.PerformanceModeText}"
                     FontFamily="{StaticResource AppFontSemiBoldFamily}"
                     FontSize="15"
                     Foreground="{StaticResource DataBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center">
          <FontIcon Glyph="&#xE950;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="13"
                    Foreground="{StaticResource AccentBrush}"
                    VerticalAlignment="Center" />
          <TextBlock Text="CPU"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Telemetry.CpuTemperatureText}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="12"
                     Foreground="{StaticResource DataBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="·"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Telemetry.CpuClockText}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="11"
                     Foreground="{StaticResource DataBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center">
          <FontIcon Glyph="&#xE7F4;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="13"
                    Foreground="{StaticResource AccentBrush}"
                    VerticalAlignment="Center" />
          <TextBlock Text="GPU"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Telemetry.GpuTemperatureText}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="12"
                     Foreground="{StaticResource DataBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="·"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Telemetry.GpuClockText}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="11"
                     Foreground="{StaticResource DataBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center">
          <Viewbox Width="13"
                   Height="13"
                   VerticalAlignment="Center">
            <Grid Width="16" Height="16">
              <Border Width="12"
                      Height="8"
                      CornerRadius="1"
                      Background="{StaticResource AccentBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Spacing="2">
                <Rectangle Width="1" Height="2" Fill="{StaticResource AccentBrush}" />
                <Rectangle Width="1" Height="2" Fill="{StaticResource AccentBrush}" />
                <Rectangle Width="1" Height="2" Fill="{StaticResource AccentBrush}" />
                <Rectangle Width="1" Height="2" Fill="{StaticResource AccentBrush}" />
                <Rectangle Width="1" Height="2" Fill="{StaticResource AccentBrush}" />
                <Rectangle Width="1" Height="2" Fill="{StaticResource AccentBrush}" />
              </StackPanel>
            </Grid>
          </Viewbox>
          <TextBlock Text="RAM"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Telemetry.MemoryValue}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="12"
                     Foreground="{StaticResource DataBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="·"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Telemetry.MemoryClockText}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="11"
                     Foreground="{StaticResource DataBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
          <Viewbox Width="13"
                   Height="13"
                   VerticalAlignment="Center">
            <Grid Width="16" Height="16">
              <Path Data="M8,1 C9.4,1 10.6,2.2 10.6,3.6 L10.6,6.4 C10.6,7.2 9.8,8 8,8 C6.2,8 5.4,7.2 5.4,6.4 L5.4,3.6 C5.4,2.2 6.6,1 8,1 Z"
                    Fill="{StaticResource AccentBrush}" />
              <Path Data="M8,1 C9.4,1 10.6,2.2 10.6,3.6 L10.6,6.4 C10.6,7.2 9.8,8 8,8 C6.2,8 5.4,7.2 5.4,6.4 L5.4,3.6 C5.4,2.2 6.6,1 8,1 Z"
                    Fill="{StaticResource AccentBrush}">
                <Path.RenderTransform>
                  <RotateTransform Angle="90" CenterX="8" CenterY="8" />
                </Path.RenderTransform>
              </Path>
              <Path Data="M8,1 C9.4,1 10.6,2.2 10.6,3.6 L10.6,6.4 C10.6,7.2 9.8,8 8,8 C6.2,8 5.4,7.2 5.4,6.4 L5.4,3.6 C5.4,2.2 6.6,1 8,1 Z"
                    Fill="{StaticResource AccentBrush}">
                <Path.RenderTransform>
                  <RotateTransform Angle="180" CenterX="8" CenterY="8" />
                </Path.RenderTransform>
              </Path>
              <Path Data="M8,1 C9.4,1 10.6,2.2 10.6,3.6 L10.6,6.4 C10.6,7.2 9.8,8 8,8 C6.2,8 5.4,7.2 5.4,6.4 L5.4,3.6 C5.4,2.2 6.6,1 8,1 Z"
                    Fill="{StaticResource AccentBrush}">
                <Path.RenderTransform>
                  <RotateTransform Angle="270" CenterX="8" CenterY="8" />
                </Path.RenderTransform>
              </Path>
              <Ellipse Width="3"
                       Height="3"
                       Fill="#D91A1A1A"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Grid>
          </Viewbox>
          <TextBlock x:Name="DetailedFanLabel"
                     Text="风扇"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Blade.FanText}"
                     FontFamily="{StaticResource AppFontFamily}"
                     FontSize="10"
                     Foreground="{StaticResource MutedBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Row="1"
                Grid.RowSpan="3"
                Grid.Column="1"
                Background="#22FFFFFF"
                CornerRadius="6"
                Padding="4">
          <Grid>
            <Canvas Width="108"
                    Height="38">
              <Polyline x:Name="GpuSparkline"
                        Stroke="{StaticResource GpuBrush}"
                        StrokeThickness="1.5"
                        StrokeLineJoin="Round" />
              <Polyline x:Name="CpuSparkline"
                        Stroke="{StaticResource AccentBrush}"
                        StrokeThickness="1.5"
                        StrokeLineJoin="Round" />
            </Canvas>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>