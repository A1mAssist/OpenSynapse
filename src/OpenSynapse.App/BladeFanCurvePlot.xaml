<UserControl
    x:Class="OpenSynapse.App.BladeFanCurvePlot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" Margin="0,0,0,4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Border Width="10" Height="10" CornerRadius="5" Background="#2D9CDB" VerticalAlignment="Center" />
        <TextBlock local:Localized.Uid="BladeFanCurveColumnCpu" Text="CPU 风扇" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Border Width="10" Height="10" CornerRadius="5" Background="#99DD72" VerticalAlignment="Center" />
        <TextBlock local:Localized.Uid="BladeFanCurveColumnGpu" Text="GPU 风扇" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
    <Canvas x:Name="PlotCanvas" Grid.Row="1" Background="Transparent" />
    <TextBlock
        x:Name="EmptyHint"
        Grid.Row="1"
        local:Localized.Uid="BladeFanCurveHint"
        Text="拖动圆点调整转速，也可以在下方输入精确数值。"
        Foreground="{StaticResource MutedBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center" />
  </Grid>
</UserControl>