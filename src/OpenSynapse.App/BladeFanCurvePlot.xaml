<UserControl
    x:Class="OpenSynapse.App.BladeFanCurvePlot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" Margin="0,0,0,4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Border Width="10" Height="10" CornerRadius="5" Background="#2D9CDB" VerticalAlignment="Center" />
        <TextBlock local:Localized.Uid="BladeFanCurveColumnCpu" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
        <TextBlock x:Name="CpuLiveReading" Foreground="{StaticResource DataBrush}" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Border Width="10" Height="10" CornerRadius="5" Background="#44D62C" VerticalAlignment="Center" />
        <TextBlock local:Localized.Uid="BladeFanCurveColumnGpu" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
        <TextBlock x:Name="GpuLiveReading" Foreground="{StaticResource DataBrush}" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" />
      </StackPanel>
    </StackPanel>
    <Canvas x:Name="PlotCanvas" Grid.Row="1" Background="Transparent" />
    <TextBlock
        x:Name="EmptyHint"
        Grid.Row="1"
        local:Localized.Uid="BladeFanCurveHint"

        Foreground="{StaticResource MutedBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center" />
  </Grid>
</UserControl>
