<Window
    x:Class="OpenSynapse.App.BladeFanCurveWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App">
  <Grid x:Name="RootLayout" Background="{StaticResource CanvasBrush}" RequestedTheme="Dark" Padding="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock local:Localized.Uid="BladeFanCurveHint" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Fan.BladeFanCurveModeOptions}" SelectedIndex="{Binding Fan.BladeFanCurveModeIndex, Mode=TwoWay}" MinWidth="160" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <RadioButton local:Localized.Uid="BladeFanCurveCpuTab" GroupName="BladeFanCurveSide" IsChecked="{Binding Fan.BladeFanCurveEditor.IsCpuCurveSelected, Mode=TwoWay}" />
          <RadioButton local:Localized.Uid="BladeFanCurveGpuTab" GroupName="BladeFanCurveSide" IsChecked="{Binding Fan.BladeFanCurveEditor.IsGpuCurveSelected, Mode=TwoWay}" />
        </StackPanel>
        <local:BladeFanCurvePlot DataContext="{Binding Fan.BladeFanCurveEditor}" Height="280" />
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="110,*,44" ColumnSpacing="10">
            <TextBlock local:Localized.Uid="BladeFanCurveColumnTemperature" Style="{StaticResource MetricLabelStyle}" />
            <TextBlock Grid.Column="1" Text="RPM" Style="{StaticResource MetricLabelStyle}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Fan.BladeFanCurveEditor.Points}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="110,*,44" ColumnSpacing="10" Padding="0,3">
                  <NumberBox Value="{Binding TemperatureInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Minimum="{Binding MinimumEditableTemperatureCelsius}" Maximum="120" SpinButtonPlacementMode="Compact" />
                  <NumberBox Grid.Column="1" Value="{Binding RpmInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Minimum="1900" Maximum="5400" SmallChange="100" SpinButtonPlacementMode="Compact" />
                  <Button Grid.Column="2" Content="×" Tag="{Binding}" Click="RemoveBladeFanCurveTierClick" HorizontalAlignment="Right" Padding="0" MinWidth="30" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
          <Button local:Localized.Uid="BladeFanCurveAddTier" Click="AddBladeFanCurveTierClick" Style="{StaticResource SecondaryButtonStyle}" />
          <Button Grid.Column="1" local:Localized.Uid="BladeFanCurveReset" Click="ResetBladeFanCurveClick" Style="{StaticResource SecondaryButtonStyle}" />
          <Button Grid.Column="2" local:Localized.Uid="BladeFanCurveApply" Click="ApplyBladeFanCurveClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
