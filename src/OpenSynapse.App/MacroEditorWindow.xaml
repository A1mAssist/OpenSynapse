<Window
    x:Class="OpenSynapse.App.MacroEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSynapse.App"
    Title="Macro editor">
  <Grid x:Name="RootLayout" Background="Transparent" RequestedTheme="Dark" Padding="16" RowDefinitions="*,Auto,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="*,16,300">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="MacroRecordButton" local:Localized.Uid="MacroRecordButton" MinWidth="104" Style="{StaticResource SecondaryButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock local:Localized.Uid="MacroRecordMenu" Text="录制" VerticalAlignment="Center" />
              <FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem local:Localized.Uid="MacroRecordStart" Text="开始录制" Click="MacroRecordStartClick" Style="{StaticResource MacroMenuItemStyle}" />
                <MenuFlyoutItem local:Localized.Uid="MacroRecordStop" Text="停止录制" Click="MacroRecordStopClick" Style="{StaticResource MacroMenuItemStyle}" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem local:Localized.Uid="MacroRecordDelays" Text="记录间隔" Click="MacroRecordDelaysClick" Style="{StaticResource MacroToggleMenuItemStyle}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="MacroInsertButton" local:Localized.Uid="MacroInsertButton" MinWidth="104" Style="{StaticResource SecondaryButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock local:Localized.Uid="MacroInsertMenu" Text="插入" VerticalAlignment="Center" />
              <FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem local:Localized.Uid="MacroInsertCapture" Text="捕获按键" Click="MacroInsertCaptureClick" Style="{StaticResource MacroMenuItemStyle}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem local:Localized.Uid="MacroAddDelayButton" Text="添加延迟" Click="AddMacroDelayClick" Style="{StaticResource MacroMenuItemStyle}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <Border Style="{StaticResource CardStyle}" Padding="0" MinHeight="120" VerticalAlignment="Top">
          <Grid RowDefinitions="*,Auto">
            <Grid Grid.Row="0" MinHeight="120">
              <ListView x:Name="MacroStepList" ItemsSource="{Binding MacroSteps}" SelectedItem="{Binding SelectedMacroStep, Mode=TwoWay}" SelectionMode="Single" Background="Transparent" BorderThickness="0" MinHeight="120" MaxHeight="220" Padding="0,4,0,8">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="56,20,*" ColumnSpacing="10" Padding="2,7">
                      <TextBlock Text="{Binding DelayText}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                      <FontIcon Grid.Column="1" Glyph="{Binding StepGlyph}" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding NameText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <TextBlock local:Localized.Uid="MacroNoMacroSelected" Text="未选择宏" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding MacroNoSelectionVisibility}" />
              <TextBlock local:Localized.Uid="MacroEmptyEditorHint" Text="点击“录制”开始录制动作序列，或直接点击下方键盘添加单个动作。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280" Visibility="{Binding MacroEmptyStepsVisibility}" />

              <Border Height="24" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00202020" Offset="0" />
                    <GradientStop Color="#FF202020" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
            <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,8">
              <StackPanel x:Name="MacroPlaybackBar" Orientation="Horizontal" Spacing="10" Visibility="{Binding MacroEditorVisibility}">
                <Button x:Name="MacroPlayButton" Content="{Binding MacroPlayButtonText}" Click="PlayMacroClick" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" />
                <StackPanel x:Name="MacroDurationChip" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <FontIcon Glyph="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                  <TextBlock Text="{Binding MacroTotalDurationText}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button local:Localized.Uid="MacroSaveButton" Content="保存" Click="SaveMacroClick" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}" Padding="0">
          <StackPanel>
            <Grid Padding="12,10" ColumnDefinitions="*,Auto" ColumnSpacing="4">
              <TextBlock local:Localized.Uid="MacroKeyBindsTitle" Text="键位绑定" FontSize="13" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0" Style="{StaticResource IconButtonStyle}" Click="CaptureMacroTriggerClick" IsEnabled="{Binding CanEditMacro}" ToolTipService.ToolTip="绑定触发键" AutomationProperties.Name="绑定触发键"><FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" /></Button>
            </Grid>
            <StackPanel Padding="12,0,12,10" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{Binding MacroTriggerBoundVisibility}">
                <FontIcon Glyph="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding SelectedMacro.TriggerText}" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock local:Localized.Uid="MacroKeyBindsNoMacro" Text="选择一个宏以查看它的键位绑定。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding MacroNoSelectionVisibility}" />
              <TextBlock local:Localized.Uid="MacroTriggerUnsetHint" Text="还没有绑定触发键，点击 + 绑定。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding MacroTriggerUnsetVisibility}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel Spacing="10">
          <Border Style="{StaticResource CardStyle}" Padding="0">
            <StackPanel>
              <Button x:Name="MacroPropertiesHeader" Click="MacroPropertiesHeaderClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="0" MinHeight="34" Padding="12,0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock local:Localized.Uid="MacroProperties" Text="属性" FontSize="13" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                  <FontIcon Grid.Column="1" x:Name="MacroPropertiesChevron" Glyph="&#xE70E;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,10,12,12">
                <StackPanel Spacing="12" x:Name="MacroPropertiesPanel">
                  <StackPanel Spacing="4">
                    <TextBlock local:Localized.Uid="MacroNameLabel" Text="名称" Style="{StaticResource MetricLabelStyle}" />
                    <TextBox local:Localized.Uid="MacroNamePlaceholder" Text="{Binding SelectedMacro.Name, Mode=TwoWay}" PlaceholderText="宏名称" MaxLength="64" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock x:Name="MacroEnabledLabel" local:Localized.Uid="MacroEnabledLabel" Text="启用" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" local:Localized.Uid="MacroEnabledToggle" IsOn="{Binding SelectedMacro.Enabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="44" AutomationProperties.LabeledBy="{Binding ElementName=MacroEnabledLabel}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock x:Name="MacroPlaybackLabel" local:Localized.Uid="MacroPlaybackLabel" Text="播放方式" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" local:Localized.Uid="MacroPlaybackRepeat" IsOn="{Binding SelectedMacro.IsRepeating, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="44" AutomationProperties.LabeledBy="{Binding ElementName=MacroPlaybackLabel}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Visibility="{Binding SelectedMacro.RepeatCountVisibility, FallbackValue=Collapsed}">
                    <TextBlock x:Name="MacroPlaybackRepeatCountLabel" local:Localized.Uid="MacroPlaybackRepeatCount" Text="重复次数" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                    <NumberBox Grid.Column="1" Value="{Binding SelectedMacro.RepeatCount, Mode=TwoWay}" Minimum="1" Maximum="999" SmallChange="1" SpinButtonPlacementMode="Compact" Width="88" />
                  </Grid>
                  </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}" Padding="0" Visibility="{Binding MacroStepEditorVisibility}">
            <StackPanel Padding="12,10,12,12" Spacing="10">
              <TextBlock local:Localized.Uid="MacroStepProperties" Text="动作属性" FontSize="13" FontFamily="{StaticResource AppFontSemiBoldFamily}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="{Binding SelectedMacroStep.NameText}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" />
              <StackPanel Spacing="4">
                <TextBlock local:Localized.Uid="MacroStepDelayLabel" Text="延迟（毫秒）" Style="{StaticResource MetricLabelStyle}" />
                <NumberBox Value="{Binding SelectedMacroStep.DelayMilliseconds, Mode=TwoWay}" Minimum="0" Maximum="60000" SmallChange="50" SpinButtonPlacementMode="Compact" />
              </StackPanel>
              <StackPanel Spacing="4" Visibility="{Binding SelectedMacroStep.HoldVisibility, FallbackValue=Collapsed}">
                <TextBlock local:Localized.Uid="MacroStepHoldLabel" Text="按住（毫秒）" Style="{StaticResource MetricLabelStyle}" />
                <NumberBox Value="{Binding SelectedMacroStep.HoldMilliseconds, Mode=TwoWay}" Minimum="0" Maximum="5000" SmallChange="10" SpinButtonPlacementMode="Compact" />
              </StackPanel>
              <StackPanel x:Name="MacroStepActionBar" Orientation="Horizontal" Spacing="6">
                <Button local:Localized.Uid="MacroStepRecaptureButton" Width="34" Height="34" MinWidth="34" MinHeight="34" Padding="0" Style="{StaticResource IconButtonStyle}" Click="RecaptureMacroStepClick" IsEnabled="{Binding SelectedMacroStep.CanRecapture, FallbackValue=False}" ToolTipService.ToolTip="重新捕获" AutomationProperties.Name="重新捕获"><FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13" /></Button>
                <Button local:Localized.Uid="MacroStepMoveUpButton" Width="34" Height="34" MinWidth="34" MinHeight="34" Padding="0" Style="{StaticResource IconButtonStyle}" Click="MoveMacroStepUpClick" ToolTipService.ToolTip="上移" AutomationProperties.Name="上移"><FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="13" /></Button>
                <Button local:Localized.Uid="MacroStepMoveDownButton" Width="34" Height="34" MinWidth="34" MinHeight="34" Padding="0" Style="{StaticResource IconButtonStyle}" Click="MoveMacroStepDownClick" ToolTipService.ToolTip="下移" AutomationProperties.Name="下移"><FontIcon Glyph="&#xE74B;" FontFamily="Segoe Fluent Icons" FontSize="13" /></Button>
                <Button local:Localized.Uid="MacroStepDeleteButton" Width="34" Height="34" MinWidth="34" MinHeight="34" Padding="0" Style="{StaticResource IconButtonStyle}" Click="DeleteMacroStepClick" ToolTipService.ToolTip="删除动作" AutomationProperties.Name="删除动作"><FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13" /></Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,248" ColumnSpacing="20">
        <StackPanel Grid.Column="0" Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock local:Localized.Uid="MacroKeyPickerKeyboard" Text="键盘" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" local:Localized.Uid="MacroKeyPickerHint" Text="点击按键即可添加一个动作。" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
          </Grid>
          <ScrollViewer x:Name="MacroKeyboardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
            <Grid x:Name="MacroKeyboardHost" HorizontalAlignment="Left" />
          </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock local:Localized.Uid="MacroKeyPickerMouse" Text="鼠标" Style="{StaticResource MetricLabelStyle}" />
          <Grid ColumnDefinitions="168,10,*">
            <Canvas x:Name="MacroMouseHost" Width="168" Height="200" HorizontalAlignment="Left">
              <Grid Width="168" Height="200">
                <FontIcon x:Name="MacroMouseGlyph" Glyph="&#xE962;" FontFamily="Segoe Fluent Icons" FontSize="150"
                          Foreground="#5C5C5C" HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False" />
              </Grid>

              <!-- Invisible click regions sit over the library mouse icon. -->
              <Button Tag="0" Style="{StaticResource MacroMouseRegionStyle}" Click="MacroKeyOptionClick"
                      Canvas.Left="48" Canvas.Top="8" Width="44" Height="64" CornerRadius="12" />
              <Button Tag="1" Style="{StaticResource MacroMouseRegionStyle}" Click="MacroKeyOptionClick"
                      Canvas.Left="88" Canvas.Top="8" Width="44" Height="64" CornerRadius="12" />

              <!-- The library glyph has no wheel, so the wheel uses the same line weight and colour. -->
              <Path x:Name="MacroMouseWheelShape" Fill="#242424" Stroke="#5C5C5C" StrokeThickness="1.5"
                    Data="M78,32 A6,6 0 0 1 90,32 L90,58 A6,6 0 0 1 78,58 Z" />
              <Button Tag="5" Style="{StaticResource MacroMouseRegionStyle}" Click="MacroKeyOptionClick"
                      Canvas.Left="76" Canvas.Top="24" Width="16" Height="17" />
              <Button Tag="2" Style="{StaticResource MacroMouseRegionStyle}" Click="MacroKeyOptionClick"
                      Canvas.Left="76" Canvas.Top="41" Width="16" Height="17" />
              <Button Tag="6" Style="{StaticResource MacroMouseRegionStyle}" Click="MacroKeyOptionClick"
                      Canvas.Left="76" Canvas.Top="58" Width="16" Height="16" />
            </Canvas>

            <StackPanel x:Name="MacroMouseExtraHost" Grid.Column="2" VerticalAlignment="Center" Spacing="8">
              <TextBlock local:Localized.Uid="MacroMouseSideButtons" Text="可选侧键" Style="{StaticResource MetricLabelStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              <Button Tag="3" local:Localized.Uid="MacroMouseSide1" Content="侧键 1" Click="MacroKeyOptionClick"
                      Style="{StaticResource SecondaryButtonStyle}" MinWidth="0" Height="30" Padding="6,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" />
              <Button Tag="4" local:Localized.Uid="MacroMouseSide2" Content="侧键 2" Click="MacroKeyOptionClick"
                      Style="{StaticResource SecondaryButtonStyle}" MinWidth="0" Height="30" Padding="6,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="2">
            <TextBlock x:Name="MacroMouseCaption" Text="" MinHeight="18" Style="{StaticResource MetricLabelStyle}" Foreground="{StaticResource DataBrush}" HorizontalAlignment="Center" />
            <TextBlock local:Localized.Uid="MacroKeyPickerMouseHint" Text="点击即可添加动作。" Style="{StaticResource MetricLabelStyle}" HorizontalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding MacroStatusText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
  </Grid>
</Window>
