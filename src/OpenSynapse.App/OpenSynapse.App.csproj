<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>OpenSynapse.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Win10 22H2 without the 2024 CET update cannot launch a CET-marked apphost. -->
    <CetCompat>false</CetCompat>
    <ApplicationIcon>Assets\OpenSynapse.ico</ApplicationIcon>
    <Version>1.6.1-beta.51</Version>
    <AssemblyVersion>1.6.1.0</AssemblyVersion>
    <FileVersion>1.6.1.0</FileVersion>
    <InformationalVersion>1.6.1-beta.51</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260709004" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\LICENSE"
             Link="LICENSE"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\OpenSynapseLogo.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\OpenSynapse.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\LightingLayouts\*.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\LightingLayouts\studio-manifests.zip"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\TitilliumWeb-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\TitilliumWeb-SemiBold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\TitilliumWeb-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Native\Razer\Mappings\*.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\IntelMSR.bin"
             Link="IntelMSR.bin"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\IntelMSR-LICENSE.txt"
             Link="IntelMSR-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\RyzenSMU.bin"
             Link="RyzenSMU.bin"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\RyzenSMU-LICENSE.txt"
             Link="RyzenSMU-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\Avif\avif.dll"
             Link="avif.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\Avif\dav1d.dll"
             Link="dav1d.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\Avif\vcruntime140.dll"
             Link="vcruntime140.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\Avif\libavif-LICENSE.txt"
             Link="libavif-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Native\Avif\dav1d-LICENSE.txt"
             Link="dav1d-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSynapse.Core\OpenSynapse.Core.csproj" />
    <ProjectReference Include="..\OpenSynapse.ChromaSdk.Protocol\OpenSynapse.ChromaSdk.Protocol.csproj" />
    <ProjectReference Include="..\OpenSynapse.RecoveryHost\OpenSynapse.RecoveryHost.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\OpenSynapse.ThxHelper\OpenSynapse.ThxHelper.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\OpenSynapse.Windows\OpenSynapse.Windows.csproj" />
  </ItemGroup>

  <Target Name="BuildChromaBroker" BeforeTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\OpenSynapse.ChromaBroker\OpenSynapse.ChromaBroker.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-x64" />
  </Target>

  <Target Name="CopyRecoveryHost" AfterTargets="Build">
    <PropertyGroup>
      <!-- The helper projects build without a Platform, so their output is bin\$(Configuration)\.
           Only insert \$(Platform) when this project was actually built for one. -->
      <_HelperPlatformDir Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU'">$(Platform)\</_HelperPlatformDir>
      <_RecoveryHostOutputDir>$(MSBuildProjectDirectory)\..\OpenSynapse.RecoveryHost\bin\$(_HelperPlatformDir)$(Configuration)\net10.0-windows10.0.26100.0\</_RecoveryHostOutputDir>
      <_RecoveryHostOutputDir Condition="'$(RuntimeIdentifier)' != ''">$(_RecoveryHostOutputDir)$(RuntimeIdentifier)\</_RecoveryHostOutputDir>
      <_ThxHelperOutputDir>$(MSBuildProjectDirectory)\..\OpenSynapse.ThxHelper\bin\$(_HelperPlatformDir)$(Configuration)\net10.0-windows10.0.26100.0\</_ThxHelperOutputDir>
      <_ThxHelperOutputDir Condition="'$(RuntimeIdentifier)' != ''">$(_ThxHelperOutputDir)$(RuntimeIdentifier)\</_ThxHelperOutputDir>
      <_ChromaBrokerOutputDir>$(MSBuildProjectDirectory)\..\OpenSynapse.ChromaBroker\bin\$(_HelperPlatformDir)$(Configuration)\net10.0\win-x64\</_ChromaBrokerOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_RecoveryHostFile Include="$(_RecoveryHostOutputDir)OpenSynapse.RecoveryHost.exe" />
      <_RecoveryHostFile Include="$(_RecoveryHostOutputDir)OpenSynapse.RecoveryHost.dll" />
      <_RecoveryHostFile Include="$(_RecoveryHostOutputDir)OpenSynapse.RecoveryHost.deps.json" />
      <_RecoveryHostFile Include="$(_RecoveryHostOutputDir)OpenSynapse.RecoveryHost.runtimeconfig.json" />
      <_ThxHelperFile Include="$(_ThxHelperOutputDir)OpenSynapse.ThxHelper.exe" />
      <_ThxHelperFile Include="$(_ThxHelperOutputDir)OpenSynapse.ThxHelper.dll" />
      <_ThxHelperFile Include="$(_ThxHelperOutputDir)OpenSynapse.ThxHelper.deps.json" />
      <_ThxHelperFile Include="$(_ThxHelperOutputDir)OpenSynapse.ThxHelper.runtimeconfig.json" />
      <_ChromaBrokerFile Include="$(_ChromaBrokerOutputDir)OpenSynapse.ChromaBroker.exe" />
      <_ChromaBrokerFile Include="$(_ChromaBrokerOutputDir)OpenSynapse.ChromaBroker.dll" />
      <_ChromaBrokerFile Include="$(_ChromaBrokerOutputDir)OpenSynapse.ChromaBroker.deps.json" />
      <_ChromaBrokerFile Include="$(_ChromaBrokerOutputDir)OpenSynapse.ChromaBroker.runtimeconfig.json" />
      <_ChromaBrokerFile Include="$(_ChromaBrokerOutputDir)OpenSynapse.ChromaSdk.Protocol.dll" />
      <!-- App notifications load this native satellite at runtime, but the MSIX content step that
           normally emits it is skipped here, so ship the checked-in copy instead. -->
      <_WinAppSdkRuntimeResource Include="$(MSBuildProjectDirectory)\Native\Microsoft.WindowsAppRuntime.Insights.Resource.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_RecoveryHostFile)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ThxHelperFile)"
          DestinationFolder="$(TargetDir)"
          Condition="Exists('$(_ThxHelperOutputDir)OpenSynapse.ThxHelper.exe')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ChromaBrokerFile)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinAppSdkRuntimeResource)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeWinUiRuntimeResourcesInPublish" AfterTargets="Publish">
    <!-- App notifications require this Windows App SDK resource satellite in unpackaged publish output. -->
    <ItemGroup>
      <_WinUiRuntimeResources Include="$(TargetDir)$(AssemblyName).pri" />
      <_WinUiRuntimeResources Include="$(TargetDir)*.xbf" />
      <_WinUiViewResources Include="$(TargetDir)Views\*.xbf" />
      <_WinUiRuntimeResources Include="$(MSBuildProjectDirectory)\Native\Microsoft.WindowsAppRuntime.Insights.Resource.dll" />
      <_ThxHelperPublishFile Include="$(_ThxHelperOutputDir)OpenSynapse.ThxHelper.exe" />
      <_ThxHelperPublishFile Include="$(_ThxHelperOutputDir)OpenSynapse.ThxHelper.dll" />
      <_ThxHelperPublishFile Include="$(_ThxHelperOutputDir)OpenSynapse.ThxHelper.deps.json" />
      <_ThxHelperPublishFile Include="$(_ThxHelperOutputDir)OpenSynapse.ThxHelper.runtimeconfig.json" />
      <_ChromaBrokerPublishFile Include="$(_ChromaBrokerOutputDir)OpenSynapse.ChromaBroker.exe" />
      <_ChromaBrokerPublishFile Include="$(_ChromaBrokerOutputDir)OpenSynapse.ChromaBroker.dll" />
      <_ChromaBrokerPublishFile Include="$(_ChromaBrokerOutputDir)OpenSynapse.ChromaBroker.deps.json" />
      <_ChromaBrokerPublishFile Include="$(_ChromaBrokerOutputDir)OpenSynapse.ChromaBroker.runtimeconfig.json" />
      <_ChromaBrokerPublishFile Include="$(_ChromaBrokerOutputDir)OpenSynapse.ChromaSdk.Protocol.dll" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WinUiRuntimeResources)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_WinUiViewResources)"
      DestinationFolder="$(PublishDir)Views"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_RecoveryHostFile)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_ThxHelperPublishFile)"
      DestinationFolder="$(PublishDir)"
      Condition="Exists('$(_ThxHelperOutputDir)OpenSynapse.ThxHelper.exe')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_ChromaBrokerPublishFile)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PruneReleasePublishOutput"
          AfterTargets="IncludeWinUiRuntimeResourcesInPublish"
          Condition="'$(Configuration)' == 'Release' and '$(PublishDir)' != ''">
    <ItemGroup>
      <_UnusedMui Include="$(PublishDir)*\*.mui"
                  Exclude="$(PublishDir)en-US\*.mui;$(PublishDir)en-us\*.mui;$(PublishDir)zh-CN\*.mui" />
      <_UnusedReleaseFile Include="$(PublishDir)createdump.exe;
                                  $(PublishDir)clrgcexp.dll;
                                  $(PublishDir)Microsoft.DiaSymReader.Native.amd64.dll;
                                  $(PublishDir)Microsoft.Web.WebView2.Core.dll;
                                  $(PublishDir)Microsoft.Web.WebView2.Core.Projection.dll;
                                  $(PublishDir)mscordaccore*.dll;
                                  $(PublishDir)mscordbi.dll;
                                  $(PublishDir)OpenSynapse.Core.pdb;
                                  $(PublishDir)OpenSynapse.Windows.pdb;
                                  $(PublishDir)PawnIO_setup.exe;
                                  $(PublishDir)PawnIO-LICENSE.txt;
                                  $(PublishDir)WebView2Loader.dll" />
    </ItemGroup>
    <Delete Files="@(_UnusedMui);@(_UnusedReleaseFile)" />
    <RemoveDir Directories="@(_UnusedMui->'%(RootDir)%(Directory)')" />
  </Target>
</Project>

