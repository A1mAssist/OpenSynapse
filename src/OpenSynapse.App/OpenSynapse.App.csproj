<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>OpenSynapse.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\OpenSynapse.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <InformationalVersion>1.1.1</InformationalVersion>
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260709004" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\OpenSynapseLogo.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\OpenSynapse.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\TitilliumWeb-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\TitilliumWeb-SemiBold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\TitilliumWeb-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Native\Razer\Product710Mapping.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSynapse.Core\OpenSynapse.Core.csproj" />
    <ProjectReference Include="..\OpenSynapse.RecoveryHost\OpenSynapse.RecoveryHost.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\OpenSynapse.Windows\OpenSynapse.Windows.csproj" />
  </ItemGroup>

  <Target Name="CopyRecoveryHost" AfterTargets="Build">
    <PropertyGroup>
      <_RecoveryHostOutputDir>$(MSBuildProjectDirectory)\..\OpenSynapse.RecoveryHost\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\</_RecoveryHostOutputDir>
      <_RecoveryHostOutputDir Condition="'$(RuntimeIdentifier)' != ''">$(_RecoveryHostOutputDir)$(RuntimeIdentifier)\</_RecoveryHostOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_RecoveryHostFile Include="$(_RecoveryHostOutputDir)OpenSynapse.RecoveryHost.exe" />
      <_RecoveryHostFile Include="$(_RecoveryHostOutputDir)OpenSynapse.RecoveryHost.dll" />
      <_RecoveryHostFile Include="$(_RecoveryHostOutputDir)OpenSynapse.RecoveryHost.deps.json" />
      <_RecoveryHostFile Include="$(_RecoveryHostOutputDir)OpenSynapse.RecoveryHost.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_RecoveryHostFile)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeWinUiRuntimeResourcesInPublish" AfterTargets="Publish">
    <!-- App notifications require this Windows App SDK resource satellite in unpackaged publish output. -->
    <ItemGroup>
      <_WinUiRuntimeResources Include="$(TargetDir)$(AssemblyName).pri" />
      <_WinUiRuntimeResources Include="$(TargetDir)*.xbf" />
      <_WinUiRuntimeResources Include="$(IntermediateOutputPath)MsixContent\Microsoft.WindowsAppRuntime.Insights.Resource.dll" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WinUiRuntimeResources)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_RecoveryHostFile)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PruneReleasePublishOutput"
          AfterTargets="IncludeWinUiRuntimeResourcesInPublish"
          Condition="'$(Configuration)' == 'Release' and '$(PublishDir)' != ''">
    <ItemGroup>
      <_UnusedMui Include="$(PublishDir)*\*.mui"
                  Exclude="$(PublishDir)en-US\*.mui;$(PublishDir)en-us\*.mui;$(PublishDir)zh-CN\*.mui" />
      <_UnusedReleaseFile Include="$(PublishDir)createdump.exe;
                                  $(PublishDir)clrgcexp.dll;
                                  $(PublishDir)Microsoft.DiaSymReader.Native.amd64.dll;
                                  $(PublishDir)Microsoft.Web.WebView2.Core.dll;
                                  $(PublishDir)Microsoft.Web.WebView2.Core.Projection.dll;
                                  $(PublishDir)mscordaccore*.dll;
                                  $(PublishDir)mscordbi.dll;
                                  $(PublishDir)OpenSynapse.Core.pdb;
                                  $(PublishDir)OpenSynapse.Windows.pdb;
                                  $(PublishDir)WebView2Loader.dll" />
    </ItemGroup>
    <Delete Files="@(_UnusedMui);@(_UnusedReleaseFile)" />
    <RemoveDir Directories="@(_UnusedMui->'%(RootDir)%(Directory)')" />
  </Target>
</Project>
