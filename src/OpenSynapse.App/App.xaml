<Application
    x:Class="OpenSynapse.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <controls:XamlControlsResources />
      </ResourceDictionary.MergedDictionaries>

      <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/TitilliumWeb-Regular.ttf#Titillium Web</FontFamily>
      <SolidColorBrush x:Key="CanvasBrush" Color="#171717" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#202020" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#292929" />
      <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#383838" />
      <SolidColorBrush x:Key="LineBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#4C4C4C" />
      <SolidColorBrush x:Key="DataBrush" Color="#F4F4F4" />
      <SolidColorBrush x:Key="MutedBrush" Color="#B6B6B6" />
      <SolidColorBrush x:Key="AccentBrush" Color="#99DD72" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#A9E889" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#82C95D" />
      <SolidColorBrush x:Key="OnlineBrush" Color="#99DD72" />
      <SolidColorBrush x:Key="GpuBrush" Color="#59C7D9" />
      <SolidColorBrush x:Key="ThermalBrush" Color="#F0B95A" />
      <SolidColorBrush x:Key="DangerBrush" Color="#F07D79" />
      <SolidColorBrush x:Key="InfoBrush" Color="#59C7D9" />

      <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DataBrush}" />
        <Setter Property="CharacterSpacing" Value="0" />
      </Style>
      <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="CharacterSpacing" Value="0" />
      </Style>
      <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DataBrush}" />
      </Style>
      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>
      <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#10200D" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource DataBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource DataBrush}" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>
      <Style x:Key="QuickActionButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="74" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource DataBrush}" />
        <Setter Property="CornerRadius" Value="5" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
