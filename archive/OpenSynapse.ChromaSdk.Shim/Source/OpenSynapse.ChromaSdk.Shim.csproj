<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AssemblyName>RzChromaSDK64</AssemblyName>
    <RootNamespace>OpenSynapse.ChromaSdk.Shim</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PlatformTarget>x64</PlatformTarget>
    <!-- SDK 10.0.302 pins ILCompiler 10.0.10; upgrading it independently breaks NativeAOT. The advisory is build-time only. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\..\LICENSE"
             Link="LICENSE"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\..\src\OpenSynapse.ChromaSdk.Protocol\OpenSynapse.ChromaSdk.Protocol.csproj" />
  </ItemGroup>
</Project>
